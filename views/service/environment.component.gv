// Environment
component {
  resources {
    component(name = SemVariaveisDoServico) {
      text("{t('common.no_variables')}", class = u-muted)
    }

    component(name = SemSecretsDoServico) {
      text("{t('environment.no_service_secret')}", class = u-muted)
    }
  }

  column(class = env) {
    row(class = env__head) {
      text("{t('environment.variable_s', service_env_count=service_env_count)}", class = "u-muted u-fill")
      button("{t('common.export')}", class = "btn btn--ghost btn--wide", on_click = env_export, disabled = @busy_env_export)
      text(" ")

      if @env_text_open == "true" {
        button(
          "{t('common.close')}",
          class = "btn btn--blue btn--wide",
          on_click = env_text_toggle,
          disabled = @busy_env_text_toggle
        )
      } else {
        button("{t('common.env')}", class = tabs__tab, on_click = env_text_toggle, disabled = @busy_env_text_toggle)
      }
    }

    form(
      name = env_add,
      on_submit = env_add,
      on_validation_error = env_show_validation_errors,
      class = "form form--gap-8",
    ) {
      row(class = env__add) {
        input(
          class = env__input,
          form_control = env_new_key,
          rules = required,
          msg = "{t('common.enter_the_key')}",
          placeholder = "{t('common.key')}",
        )
      }

      row(class = env__add) {
        input(
          class = env__input,
          form_control = env_new_value,
          placeholder = "{t('common.value')}",
        )
      }

      row(class = env__add) {
        button("{t('common.add')}", type = submit, disabled = @busy_env_add, class = "btn btn--primary")
      }
    }

    text(
      "{t('environment.for_a_sensitive_value_use_a')}",
      class = "u-muted u-fill",
    )

    text(
      "@error_env_new_key",
      if = @error_env_new_key,
      not_equals = "",
      class = u-error,
    )

    scrollable(direction = vertical, class = u-fill-all) {
      column(class = kv-list) {
        template(
          :for_each = service_env,
          var = e,
          on_reorder = env_reorder,
          reorder_key = key,
          foreach_fallback = SemVariaveisDoServico,
        ) {
          if @e.__dragging == "true" {
            row(class = "kv-list__row kv-list__row--dragging", if = @e.kind, equals = comment) {
              text(
                "⋮ ",
                class = "env__drag-handle env__drag-handle--dragging",
                drag_handle = true,
              )

              text("@e.value", class = u-muted)
            }

            row(class = "kv-list__row kv-list__row--dragging", else) {
              text(
                "⋮ ",
                class = "env__drag-handle env__drag-handle--dragging",
                drag_handle = true,
              )

              button(
                "✕",
                class = env__del,
                on_click = env_delete:@e.key,
                disabled = @busy_env_delete
              )

              text(class = env__sep)
              text("@e.key_display", class = env__key)
              text("@e.value", class = "kv-list__val kv-list__val--compact")
            }
          } else {
            row(class = kv-list__row, if = @e.kind, equals = comment) {
              text(
                "⋮ ",
                class = env__drag-handle,
                drag_handle = true,
              )

              text("@e.value", class = u-muted)
            }

            row(class = kv-list__row, else) {
              text(
                "⋮ ",
                class = env__drag-handle,
                drag_handle = true,
              )

              button(
                "✕",
                class = env__del,
                on_click = env_delete:@e.key,
                disabled = @busy_env_delete
              )

              button(
                "✏️",
                class = "btn btn--ghost btn--sm",
                on_click = service_env_edit_key:@e.key,
                tooltip = "{t('environment.rename')}"
              )

              button(
                "✎",
                class = "btn btn--ghost btn--sm",
                on_click = service_env_edit_value:@e.key,
                tooltip = "{t('environment.edit_value')}"
              )

              button(
                "🔒",
                class = "btn btn--ghost btn--sm",
                on_click = env_to_secret:@e.key,
                disabled = @busy_env_to_secret,
                if = @e.kind,
                equals = plain,
                tooltip = "{t('environment.to_secret')}"
              )

              button(
                "↑",
                class = "btn btn--ghost btn--sm",
                on_click = env_to_project:@e.key,
                disabled = @busy_env_to_project,
                if = @e.kind,
                equals = plain,
                tooltip = "{t('environment.env_to_project')}"
              )

              button(
                "🔓",
                class = "btn btn--ghost btn--sm",
                on_click = service_secret_to_env:@e.secret_name,
                disabled = @busy_service_secret_to_env,
                if = @e.kind,
                equals = secret,
                tooltip = "{t('environment.secret_to_env')}"
              )

              text(class = env__sep)
              if @env_edit_id == @e.edit_key_id {
                form(name = service_env_edit, on_submit = env_edit_apply, class = "form env__edit env__edit--key") {
                  row(class = env__add) {
                    input(class = env__inline, form_control = env_edit_draft, autofocus = true)
                    button("✓", type = submit, disabled = @busy_env_edit_apply, class = "btn btn--ghost btn--sm")
                    button("✕", on_click = env_edit_cancel, class = "btn btn--ghost btn--sm")
                  }
                }
              } else {
                text("@e.key_display", class = env__key)
              }

              if @env_edit_id == @e.edit_value_id {
                form(name = service_env_edit_value, on_submit = env_edit_apply, class = "form env__edit env__edit--value") {
                  row(class = env__add) {
                    input(class = env__inline, form_control = env_edit_draft, autofocus = true)
                    button("✓", type = submit, disabled = @busy_env_edit_apply, class = "btn btn--ghost btn--sm")
                    button("✕", on_click = env_edit_cancel, class = "btn btn--ghost btn--sm")
                  }
                }
              } else {
                text("@e.value", class = "kv-list__val kv-list__val--compact")
              }
            }
          }
        }

        // ── Secrets deste serviço (só nomes; o valor nunca volta do daemon) ──────────────────
        hr

        text(
          "{t('environment.service_secrets', service_secrets_count=service_secrets_count)}",
          class = u-label-cap,
        )

        text(
          "{t('environment.service_secrets_hint')}",
          class = "u-muted u-fill",
        )

        form(
          name = service_secret_add,
          on_submit = service_secret_add,
          on_validation_error = service_secret_add_show_validation_errors,
          class = "form form--gap-8",
        ) {
          row(class = env__add) {
            input(
              class = env__input,
              form_control = service_secret_new_name,
              rules = required,
              msg = "{t('common.enter_a_name')}",
              placeholder = "{t('common.name')}",
            )
          }

          row(class = env__add) {
            input(
              class = env__input,
              form_control = service_secret_new_value,
              rules = required,
              msg = "{t('project_secrets.enter_a_value')}",
              placeholder = "{t('project_secrets.value_encrypted_on_save')}",
            )
          }

          row {
            button(
              "{t('project_secrets.save_secret')}",
              type = submit,
              disabled = @busy_service_secret_add,
              class = "btn btn--primary"
            )
          }
        }

        if @rename_open == "service_secret" {
          row(class = env__add) {
            text("{t('rename.label', rename_from=rename_from)}", class = u-muted)

            input(
              class = env__input,
              form_control = rename_to,
              :value = rename_to,
              on_change = field:rename_to,
              placeholder = "{t('rename.new_name')}",
            )

            button(
              "{t('rename.apply')}",
              class = "btn btn--primary",
              on_click = service_rename_apply,
              disabled = @busy_service_rename_apply
            )

            button(
              "{t('common.cancel')}",
              class = "btn btn--ghost",
              on_click = rename_cancel
            )
          }
        }

        each @service_secrets as s (fallback = SemSecretsDoServico) {
          column(class = kv-list__block) {
          row(class = kv-list__row) {
            button(
              "✕",
              class = env__del,
              on_click = service_secret_delete:@s.name,
              disabled = @busy_service_secret_delete
            )

            button(
              "✏️",
              class = "btn btn--ghost btn--sm",
              on_click = service_secret_rename_pick:@s.name,
              tooltip = "{t('environment.rename')}"
            )

            button(
              "🔓",
              class = "btn btn--ghost btn--sm",
              on_click = service_secret_to_env:@s.name,
              disabled = @busy_service_secret_to_env,
              tooltip = "{t('environment.secret_to_env')}"
            )

            button(
              "↑",
              class = "btn btn--ghost btn--sm",
              on_click = service_secret_to_project:@s.name,
              disabled = @busy_service_secret_to_project,
              tooltip = "{t('environment.secret_to_project')}"
            )

            button(
              "👁",
              class = "btn btn--ghost btn--sm",
              on_click = service_secret_reveal:@s.name,
              disabled = @busy_service_secret_reveal,
              if = @s.revealed,
              equals = false,
              tooltip = "{t('environment.secret_reveal')}"
            )

            button(
              "🙈",
              class = "btn btn--ghost btn--sm",
              on_click = service_secret_hide:@s.name,
              if = @s.revealed,
              equals = true,
              tooltip = "{t('environment.secret_hide')}"
            )

            button(
              "📋",
              class = "btn btn--ghost btn--sm",
              on_click = secret_copy:@s.ref,
              if = @s.revealed,
              equals = true,
              tooltip = "{t('environment.secret_copy')}"
            )

            text(class = env__sep)
            text("@s.name_display", class = env__key)
          }

          row(class = kv-list__row, if = @s.revealed, equals = true) {
            text("@s.value", class = "kv-list__val")
          }
          }
        }

        if @env_text_open == "true" {
          text(
            "{t('common.paste_edit_in_the_key')}",
            class = u-muted,
          )

          textarea(
            class = env__editor,
            font = mono,
            :value = service_env_text,
            placeholder = "{t('common.key_value_comment')}",
          )

          row(class = env__add) {
            button(
              "{t('common.save')}",
              class = "btn btn--primary",
              on_click = env_import,
              disabled = @busy_env_import
            )

            button(
              "{t('common.cancel')}",
              class = "btn btn--ghost",
              on_click = env_text_cancel,
              disabled = @busy_env_text_cancel
            )
          }
        }
      }
    }
  }
}
