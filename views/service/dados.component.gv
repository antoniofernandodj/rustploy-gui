// Dados do serviço: exportar/importar os volumes (ou o dump do banco)
component {
  scrollable(
    direction = vertical,
    class = u-fill-all,
  ) {
    // Um filho só no scrollable: os dois painéis numa coluna.
    column(width = fill, spacing = 12) {
    // Volumes montados (Application): adotar um órfão ou montar um nome
    // novo; desmontar não apaga os dados. Vale no próximo deploy.
    column(width = fill, spacing = 8, class = form-panel) {
      text("{t('dados.volumes')}", class = u-label-cap)
      text(
        "{t('dados.compose_declares_volumes')}",
        if = @service_volumes_supported,
        not_equals = "1",
        class = u-muted,
      )
      column(
        if = @service_volumes_supported,
        equals = "1",
        width = fill,
        spacing = 8,
      ) {
        text(
          "{t('dados.no_volume_mounted')}",
          if = @service_volume_count,
          equals = "0",
          class = u-muted,
        )
        each @service_volume_rows as m {
          row(class = kv-list__row) {
            text("@m.source", class = env__key)
            text("→ @m.target", class = "custom-routes__target u-fill")
            text("@m.mode", class = u-muted)
            button(
              "✕",
              class = "btn btn--danger btn--xs",
              on_click = service_volume_detach:@m.index,
              disabled = @busy_service_volume_detach,
              tooltip = "{t('dados.unmount')}"
            )
          }
        }
        row(class = route-editor__row) {
          select(
            class = form-select,
            :options = service_volume_options,
            :value = service_volume_form_existing,
            on_change = field:service_volume_form_existing,
            placeholder = "{t('dados.existing_volume')}",
            label_field = label,
            value_field = name,
          )
          input(
            :value = service_volume_form_name,
            on_change = field:service_volume_form_name,
            placeholder = "{t('dados.or_a_new_name')}",
            class = form-input,
          )
        }
        row(class = route-editor__row) {
          input(
            :value = service_volume_form_target,
            on_change = field:service_volume_form_target,
            placeholder = "{t('dados.path_in_the_container')}",
            class = form-input,
          )
          checkbox(
            :checked = service_volume_form_read_only,
            on_toggle = field:service_volume_form_read_only,
            label = "{t('dados.read_only')}",
          )
          button(
            "{t('dados.mount')}",
            class = "btn btn--primary btn--sm",
            on_click = service_volume_attach,
            disabled = @busy_service_volume_attach
          )
        }
        text("{t('dados.applies_on_next_deploy')}", class = u-muted)
      }
    }

    column(width = fill, spacing = 8, class = form-panel) {
      text("{t('dados.title')}", class = u-label-cap)
      text("{t('dados.intro')}", class = u-muted)

      text(
        "@data_blocked",
        if = @data_blocked,
        not_equals = "",
        class = u-muted
      )
      text(
        "@data_parts_text",
        if = @data_parts_text,
        not_equals = "",
        class = kv-list__val
      )
      text(
        "@data_notes_text",
        if = @data_notes_text,
        not_equals = "",
        class = u-muted
      )

      checkbox(
        if = @data_can_export,
        equals = true,
        :checked = data_encrypt,
        on_toggle = field:data_encrypt,
        label = "{t('dados.encrypt')}",
      )

      row(class = env__add) {
        button(
          "{t('dados.export')}",
          class = "btn btn--primary",
          if = @data_can_export,
          equals = true,
          on_click = data_export,
          disabled = @busy_data_export
        )
      }

      // ── Backup no S3 (Fase 2 de docs/plano-backup-de-dados-para-s3.md;
      // handlers/service_backup.luau) ──
      text("{t('dados.s3_backup_title')}", class = u-label-cap)
      text("{t('dados.s3_backup_intro')}", class = u-muted)

      text(
        "@data_backup_blocked",
        if = @data_backup_blocked,
        not_equals = "",
        class = u-muted
      )
      text(
        "@data_backup_list_error",
        if = @data_backup_list_error,
        not_equals = "",
        class = u-error
      )

      row(class = env__add, if = @data_backup_ready, equals = true) {
        button(
          "{t('dados.s3_backup_now')}",
          class = "btn btn--primary",
          if = @data_backup_blocked,
          equals = "",
          on_click = service_backup_now,
          disabled = @data_backup_running
        )
        button(
          "{t('dados.s3_backup_refresh')}",
          class = btn-secondary,
          on_click = service_backup_refresh,
          disabled = @busy_service_backup_refresh
        )
      }

      // `width = fill` nos `column` deste bloco: sem ele o column encolhe até
      // os filhos, que são todos `fill` (field, .env__add, .kv-list__row) —
      // fill dentro de shrink dá largura zero e o bloco some, com a altura
      // reservada (o buraco preto da aba Dados).
      column(
        spacing = 6,
        width = fill,
        if = @data_backup_ready,
        equals = true
      ) {
        field(
          label = "{t('dados.s3_policy_title')}",
          label_class = u-label-cap
        ) {
          toggle(
            :checked = data_backup_enabled,
            on_toggle = field:data_backup_enabled,
            label = "{t('dados.s3_policy_enable')}",
          )
        }

        column(
          spacing = 6,
          width = fill,
          if = @data_backup_enabled,
          equals = true
        ) {
          scroll(class = tabs__scroll, direction = horizontal) {
            tabbar(
              :value = data_backup_kind,
              active = @data_backup_kind,
              :items = docker_cleanup_kinds,
              tab_class = tabs__tab,
              tab_active_class = "tabs__tab tabs__tab--active",
              padding = "9 16",
              size = 14,
              active_bold = false,
            )
          }

          row(class = env__add, if = @data_backup_kind, equals = interval) {
            text("{t('dados.s3_policy_every')}", class = u-muted)
            spinbox(
              field_class = field__spin,
              form_control = data_backup_hours,
              :value = data_backup_hours,
              min = 1,
              max = 168,
              width = 90,
              placeholder = 6,
            )
            text("{t('dados.s3_policy_hours')}", class = u-muted)
          }

          scroll(
            class = tabs__scroll,
            direction = horizontal,
            if = @data_backup_kind,
            equals = weekly
          ) {
            row(class = tabs__main) {
              radiogroup(
                :value = data_backup_weekday,
                :items = weekdays,
                layout = row
              )
            }
          }

          row(
            class = env__add,
            if = @data_backup_kind,
            not_equals = interval
          ) {
            text("{t('dados.s3_policy_at_utc')}", class = u-muted)
            timeedit(:value = data_backup_time)
          }

          row(class = env__add) {
            text("{t('dados.s3_policy_keep')}", class = u-muted)
            spinbox(
              field_class = field__spin,
              form_control = data_backup_keep,
              :value = data_backup_keep,
              min = 1,
              max = 365,
              width = 90,
              placeholder = 7,
            )
          }

          checkbox(
            :checked = data_backup_stop,
            on_toggle = field:data_backup_stop,
            label = "{t('dados.s3_policy_stop')}",
          )

          text(
            "{t('dados.s3_policy_next', data_backup_next=data_backup_next)}",
            if = @data_backup_next,
            not_equals = "",
            class = u-muted,
          )
        }

        row(class = env__add) {
          button(
            "{t('dados.s3_policy_save')}",
            class = "btn btn--primary",
            on_click = service_backup_policy_save,
            disabled = @busy_service_backup_policy_save
          )
        }
      }

      text(
        "@data_backup_run_label",
        if = @data_backup_run_label,
        not_equals = "",
        class = u-muted
      )
      text(
        "@data_backup_checks",
        if = @data_backup_checks,
        not_equals = "",
        class = u-muted
      )

      column(
        spacing = 4,
        width = fill,
        if = @data_backups_count,
        not_equals = 0
      ) {
        each @data_backups as b {
          row(class = kv-list__row) {
            button(
              "✕",
              class = "btn btn--danger btn--xs",
              on_click = service_backup_delete:@b.key,
              disabled = @busy_service_backup_delete
            )
            text("@b.when", class = kv-list__val)
            text("@b.size", class = u-muted)
            button(
              "{t('dados.s3_backup_restore')}",
              class = "btn btn--ghost btn--xs",
              on_click = service_backup_restore:@b.key,
              disabled = @data_backup_running
            )
          }
        }
      }

      text(
        "{t('dados.s3_backup_none')}",
        if = @data_backups_count,
        equals = 0,
        class = u-muted,
      )

      text("{t('dados.import_title')}", class = u-label-cap)

      row(class = env__add) {
        button(
          "{t('dados.pick_file')}",
          class = btn-secondary,
          on_click = data_pick_file,
          disabled = @busy_data_pick_file
        )
        text("@data_file_name", class = u-muted)
      }

      row(class = env__add) {
        button(
          "{t('dados.check')}",
          class = btn-secondary,
          if = @data_file_name,
          not_equals = "",
          on_click = data_preview,
          disabled = @busy_data_preview
        )
      }

      column(spacing = 6, if = @data_preview_text, not_equals = "") {
        text("{t('dados.will_replace')}", class = u-label-cap)
        text("@data_preview_text", class = kv-list__val)
        row(class = env__add) {
          button(
            "{t('dados.replace')}",
            class = "btn btn--primary",
            on_click = data_confirm,
            disabled = @busy_data_confirm
          )
        }
      }

      text(
        "@data_result_text",
        if = @data_result_text,
        not_equals = "",
        class = u-muted
      )
      text(
        "@data_message",
        if = @data_message,
        not_equals = "",
        class = u-muted
      )
    }
    }
  }
}
