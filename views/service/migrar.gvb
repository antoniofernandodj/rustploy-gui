// Migrar este banco para um servidor compartilhado
component {
  scrollable(
    direction = vertical,
    class = u-fill-all,
  ) {
    column(width = fill, spacing = 8, class = form-panel) {
      text(class = u-label-cap, content = "MIGRAR PARA BANCO COMPARTILHADO")

      text(
        class = u-muted,
        content = """
          Crie antes o database de destino no servidor compartilhado (aba
          Databases de lá, marcando "Não mexer em env var"). Mesmo motor e
          mesmo projeto. A migração é com parada: os serviços que usam
          este banco ficam fora do ar durante a cópia.
        """,
      )

      text(
        class = u-label-cap,
        content = "DATABASE DE ORIGEM (dentro deste banco)",
      )

      input(
        class = field__input,
        form_control = service_form_migration_database,
        :value = service_form_migration_database,
        on_change = field:service_form_migration_database,
        placeholder = "nome do database",
      )

      text(class = u-label-cap, content = "DESTINO")

      select(
        class = form-select,
        :options = migration_destinations,
        :value = service_form_migration_destination,
        on_change = field:service_form_migration_destination,
        placeholder = "database de destino...",
        labelField = name,
        valueField = id,
      )

      text(class = u-label-cap, content = "ENV VAR A TROCAR")

      input(
        class = field__input,
        form_control = service_form_migration_env,
        :value = service_form_migration_env,
        on_change = field:service_form_migration_env,
        placeholder = "padrão DATABASE_URL / MONGODB_URI",
      )

      row(class = env__add) {
        button(class = "btn btn--primary", on_click = migration_start, disabled = @busy_migration_start, text = Migrar)

        button(
          class = "btn btn--ghost",
          on_click = migration_refresh,
          disabled = @busy_migration_refresh,
          text = Atualizar,
        )
      }

      if @migration_has == "true" {
        text(class = u-label-cap, content = "ANDAMENTO — @migration_status")

        column(class = kv-list) {
          row(class = kv-list__row, :for-each = migration_steps, var = s) {
            text(class = env__key, content = "@s.icon")
            text(class = "kv-list__val kv-list__val--compact", content = "@s.name")
            text(class = u-muted, content = "@s.detail")
          }
        }

        if @migration_can_finish == "true" {
          text(
            class = u-muted,
            content = """
              Migração concluída — o banco antigo foi mantido (parado)
              para rollback.
            """,
          )

          row(class = env__add) {
            button(
              class = "btn btn--ghost",
              on_click = migration_rollback,
              disabled = @busy_migration_rollback,
              text = Reverter,
            )

            button(
              class = "btn btn--ghost",
              on_click = migration_discard,
              disabled = @busy_migration_discard,
              text = "Descartar banco antigo",
            )
          }
        }
      }
    }
  }
}
