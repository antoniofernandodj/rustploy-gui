// Deployments
component {
  resources {
    component(name = SemDeploysDoServico) {
      text("{t('deployments.no_deploy_yet')}", class = u-muted)
    }
  }

  column(class = deployments__wrap) {
    // Webhook de deploy: servido pelo MESMO listener da API (base
    // derivada de [api] domain/port). Compose não tem webhook.
    column(
      if = @service_webhook_supported,
      equals = true,
      class = form-panel,
    ) {
      text("{t('common.deploy_webhook')}", class = u-label-cap)

      column(if = @service_webhook_url, not_equals = "", class = webhook) {
        // a URL inteira num campo só de leitura (rola dentro dele), com o
        // Copiar colado — o `_short` + tooltip só existiam para caber na linha
        inputgroup(
          action = "{t('common.copy')}",
          on_action = "copy_ctx:service_webhook_url"
        ) {
          input(:value = service_webhook_url, readonly = true)
        }

        row(class = webhook__actions) {
          button(
            "{t('deployments.regenerate')}",
            class = "btn btn--danger btn--xs",
            on_click = regenerate_webhook,
            disabled = @busy_regenerate_webhook
          )
        }
      }

      text(
        "{t('deployments.the_token_is_born_on_this')}",
        if = @service_webhook_url,
        equals = "",
        class = u-muted,
      )

      text(
        "{t('deployments.a_post_to_this_url_triggers')}",
        class = u-muted,
      )
    }

    // Janela "Comparar" de uma release, na própria aba: o que um "voltar
    // para esta" mudaria (do declarado agora para a release).
    column(
      if = @release_diff_open,
      equals = "1",
      class = "form-panel release-diff",
    ) {
      row(class = release-diff__head) {
        text("@release_diff_title", class = "u-label-cap u-fill")
        button(
          "{t('common.close')}",
          class = "btn btn--ghost btn--xs",
          on_click = release_diff_close,
          disabled = @busy_release_diff_close
        )
      }

      text(
        "{t('deployments.nothing_changes')}",
        if = @release_diff_is_empty,
        equals = "1",
        class = u-muted,
      )

      scrollable(direction = vertical, class = release-diff__scroll) {
        column(class = release-diff__groups) {
          each @release_diff_groups as g {
            column(class = release-diff__group) {
              text("@g.title", class = u-label-cap)
              each @g.changes as c {
                column(class = release-diff__change) {
                  text("@c.field", class = release-diff__field)
                  text("@c.before", class = release-diff__before)
                  text("@c.after", class = release-diff__after)
                }
              }
            }
          }
        }
      }

      row(
        if = @release_diff_can_rollback,
        equals = "1",
        class = release-diff__actions,
      ) {
        button(
          "{t('deployments.roll_back_to_this')}",
          class = "btn btn--primary btn--xs",
          on_click = release_rollback:@release_diff_release_id,
          disabled = @busy_release_rollback
        )
      }
    }

    column(
      if = @release_diff_open,
      not_equals = "1",
      class = deployments__history,
    ) {
    text(
      "{t('deployments.deployments',
        service_deployments_count=service_deployments_count)}",
      class = u-muted
    )

    scrollable(direction = vertical, class = deployments__list-scroll) {
      column(class = u-fill) {
        each @service_deployments as d (fallback = SemDeploysDoServico) {
          column(class = u-fill) {
            row(class = table__row) {
              text(
                "@d.id",
                class = "table__cell table__cell--key table__col-dep-id"
              )
              StateCell(kind = @d.state_kind, label = @d.state_label)
              text("@d.duration", class = "table__cell table__col-dur")
              text("@d.start", class = "u-muted table__col-dep-start")

              row(class = deployments__actions) {
                button(
                  "≡",
                  class = "btn btn--ghost btn--xs",
                  on_click = deployment_logs:@d.id_full,
                  disabled = @busy_deployment_logs,
                  tooltip = "{t('deployments.view_build_log')}"
                )

                button(
                  "✕",
                  if = @d.can_delete,
                  equals = 1,
                  class = "btn btn--danger btn--xs",
                  on_click = delete_deployment:@d.id_full,
                  disabled = @busy_delete_deployment,
                  tooltip = "{t('deployments.remove_deployment')}"
                )
              }
            }

            text("@d.image", class = deployments__image)
            text(
              "@d.release_restored_label",
              if = @d.release_restored_label,
              not_equals = "",
              class = deployments__image,
            )
            row(
              if = @d.release_id,
              not_equals = "",
              class = deployments__release-actions,
            ) {
              row(class = release-badge) {
                text("@d.release_label", class = release-badge__number)
                text(
                  "{t('deployments.current')}",
                  if = @d.release_is_current,
                  equals = "1",
                  class = release-badge__current,
                )
              }
              button(
                "{t('deployments.compare')}",
                class = "btn btn--ghost btn--xs",
                on_click = release_compare:@d.release_id,
                disabled = @busy_release_compare,
                tooltip = "{t('deployments.compare_this_release')}"
              )
              button(
                "{t('deployments.roll_back_to_this')}",
                if = @d.release_can_rollback,
                equals = "1",
                class = "btn btn--ghost btn--xs",
                on_click = release_rollback:@d.release_id,
                disabled = @busy_release_rollback,
                tooltip = "{t('deployments.roll_back_tooltip')}"
              )
            }
            text(
              "{t('deployments.release_image_deleted')}",
              if = @d.release_image_missing,
              equals = "1",
              class = deployments__image,
            )
            hr
          }
        }
      }
    }
    }
  }
}
