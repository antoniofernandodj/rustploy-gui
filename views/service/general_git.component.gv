// Sub-aba Git do provider: URL/imagem crua; corpo do `if @provider_tab == "git"` de general.component.gv.
component {
  text(
    "{t('general_git.source_repository_url_image')}",
    class = u-label-cap,
  )

  input(
    class = field__input,
    form_control = service_form_repo_url,
    :value = service_form_repo_url,
    on_change = field:service_form_repo_url,
    placeholder = "{t('general_git.github_com_user_repo_or')}",
  )

  text(
    "{t('general_git.a_repository_url_becomes_git_otherwise')}",
    class = u-muted,
  )

  row(class = healthcheck__grid) {
    column(class = healthcheck__field) {
      text("{t('common.branch')}", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_branch,
        :value = service_form_branch,
        on_change = field:service_form_branch,
        placeholder = "{t('general_git.main')}",
      )
    }

    column(class = healthcheck__field) {
      text("{t('common.port')}", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_general_port,
        :value = service_form_general_port,
        on_change = field:service_form_general_port,
        placeholder = 80,
      )

      text(
        "@error_service_form_general_port",
        if = @error_service_form_general_port,
        not_equals = "",
        class = u-error,
      )
    }
  }

  row(class = healthcheck__grid) {
    column(class = healthcheck__field) {
      text("{t('general_git.username')}", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_username,
        :value = service_form_username,
        on_change = field:service_form_username,
        placeholder = "{t('common.optional')}",
      )
    }

    column(class = healthcheck__field) {
      text("{t('general_git.credentials_secret')}", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_credentials,
        :value = service_form_credentials,
        on_change = field:service_form_credentials,
        placeholder = "{t('common.optional')}",
      )

      text(
        "{t('general_git.name_of_a_project_secret_secrets')}",
        class = u-muted,
      )
    }
  }

  text("{t('common.build_path_root')}", class = u-label-cap)

  input(
    class = field__input,
    form_control = service_form_build_path,
    :value = service_form_build_path,
    on_change = field:service_form_build_path,
    placeholder = .,
  )

  text(
    "{t('common.watch_paths_comma_separated')}",
    class = u-label-cap,
  )

  input(
    class = field__input,
    form_control = service_form_watch_paths,
    :value = service_form_watch_paths,
    on_change = field:service_form_watch_paths,
    placeholder = "{t('common.src_cargo_toml')}",
  )

  toggle(
    :checked = service_form_submodules,
    on_toggle = field:service_form_submodules,
    label = "{t('general_git.enable_submodules')}",
  )

  text("{t('general_git.build_engine_dockerfile')}", class = u-label-cap)

  row(class = healthcheck__grid) {
    column(class = healthcheck__field) {
      text("{t('common.dockerfile')}", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_dockerfile,
        :value = service_form_dockerfile,
        on_change = field:service_form_dockerfile,
        placeholder = "{t('common.dockerfile_2')}",
      )
    }

    column(class = healthcheck__field) {
      text("{t('common.context_path')}", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_context_path,
        :value = service_form_context_path,
        on_change = field:service_form_context_path,
        placeholder = .,
      )
    }
  }

  text("{t('general_git.build_stage_optional')}", class = u-label-cap)

  input(
    class = field__input,
    form_control = service_form_build_stage,
    :value = service_form_build_stage,
    on_change = field:service_form_build_stage,
    placeholder = "{t('general_git.multi_stage_target')}",
  )

  row(class = env__add) {
    button(
      "{t('common.save_2')}",
      class = "btn btn--primary",
      on_click = general_save,
      disabled = @busy_general_save
    )

    text("@service_action_message", class = u-muted)
  }
}
