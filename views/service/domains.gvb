// Domains (editável): lista de rotas HTTP (domínio → porta de container,
// TLS por rota), mais o form de adição e a porta TCP crua do host.
component {
  resources {
    component(name = SemDominios) {
      text("Nenhum domínio configurado.", class = u-muted)
    }
  }

  column(class = form-panel) {
    text("DOMÍNIOS (@service_domains_count)", class = u-label-cap)

    text(
      """
        Cada domínio pode apontar para uma porta de container diferente.
      """,
      class = u-muted,
    )

    scrollable(direction = vertical, class = u-fill-all) {
      column(class = kv-list) {
        each @service_domains as d (fallback = SemDominios) {
          row(class = kv-list__row) {
            button(
              class = env__del,
              on_click = domain_delete:@d.domain,
              disabled = @busy_domain_delete,
              text = "✕",
            )

            text(class = env__sep)
            text("@d.domain", class = env__key)
            text("→ @d.port", class = "kv-list__val kv-list__val--compact")
            text("@d.tls_label", class = u-muted)
          }
        }
      }
    }

    text("ADICIONAR DOMÍNIO", class = u-label-cap)

    input(
      class = field__input,
      form_control = service_form_domain,
      :value = service_form_domain,
      on_change = field:service_form_domain,
      placeholder = app.exemplo.com,
    )

    text(
      "@error_service_form_domain",
      if = @error_service_form_domain,
      not_equals = "",
      class = u-error,
    )

    text("PORTA DO CONTAINER (opcional)", class = u-label-cap)

    input(
      class = field__input,
      form_control = service_form_port,
      :value = service_form_port,
      on_change = field:service_form_port,
      placeholder = "(padrão do serviço)",
    )

    text(
      "@error_service_form_port",
      if = @error_service_form_port,
      not_equals = "",
      class = u-error,
    )

    toggle(
      :checked = service_form_tls,
      on_toggle = field:service_form_tls,
      label = "  HTTPS / TLS",
    )

    row(class = env__add) {
      button(
        class = "btn btn--primary",
        on_click = domain_add,
        disabled = @busy_domain_add,
        text = "Adicionar domínio",
      )

      text("@service_action_message", class = u-muted)
    }

    text(
      "PORTA TCP DO HOST (passthrough, opcional)",
      class = u-label-cap,
    )

    input(
      class = field__input,
      form_control = service_form_host_port,
      :value = service_form_host_port,
      on_change = field:service_form_host_port,
      placeholder = "(padrão do serviço)",
    )

    text(
      "@error_service_form_host_port",
      if = @error_service_form_host_port,
      not_equals = "",
      class = u-error,
    )

    row(class = env__add) {
      button(
        class = "btn btn--ghost",
        on_click = domain_hostport_save,
        disabled = @busy_domain_hostport_save,
        text = "Salvar porta",
      )

      button(
        class = "btn btn--ghost",
        on_click = domain_hostport_auto,
        disabled = @busy_domain_hostport_auto,
        text = Automática,
      )
    }

    text(
      """
        "Automática" aloca uma porta livre e a libera no firewall do host.
      """,
      class = u-muted,
    )
  }
}
