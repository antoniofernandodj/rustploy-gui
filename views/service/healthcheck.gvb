// Healthcheck (editável)
component {
  resources {
    component(name = SemChecks) {
      text(
        class = muted,
        content = "Nenhum check configurado — deploy segue direto.",
      )
    }
  }

  form(
    class = form_panel,
    name = healthcheck,
    on_submit = hc_save,
  ) {
    text(class = label_cap, content = "KIND")

    tabbar(
      :value = f_hc_kind, active = @f_hc_kind, :items = hc_kinds,
      tab_class = tab, tab_active_class = tab_on, padding = "9 16", size = 14,
    )

    if @f_hc_kind == "http" {
      text(class = label_cap, content = "HTTP PATH")

      input(
        class = field_input,
        form_control = f_hc_path,
        :value = f_hc_path,
        on_change = field:f_hc_path,
        placeholder = "/health",
      )

      text(class = label_cap, content = "EXPECTED STATUS")

      spinbox(
        field_class = spin_field,
        form_control = f_hc_status,
        :value = f_hc_status,
        min = 100,
        max = 599,
        width = 90,
        placeholder = 200,
      )
    }

    row(class = hc_grid) {
      column(class = hc_field) {
        text(class = label_cap, content = "INTERVAL (s)")

        spinbox(
          field_class = spin_field,
          form_control = f_hc_interval,
          :value = f_hc_interval,
          min = 1,
          max = 3600,
          width = 90,
        )
      }

      column(class = hc_field) {
        text(class = label_cap, content = "TIMEOUT (s)")

        spinbox(
          field_class = spin_field,
          form_control = f_hc_timeout,
          :value = f_hc_timeout,
          min = 1,
          max = 3600,
          width = 90,
        )
      }
    }

    row(class = hc_grid) {
      column(class = hc_field) {
        text(class = label_cap, content = "RETRIES")

        spinbox(
          field_class = spin_field,
          form_control = f_hc_retries,
          :value = f_hc_retries,
          min = 1,
          max = 10,
          width = 90,
        )
      }

      column(class = hc_field) {
        text(class = label_cap, content = "START PERIOD (s)")

        spinbox(
          field_class = spin_field,
          form_control = f_hc_start,
          :value = f_hc_start,
          min = 0,
          max = 3600,
          width = 90,
        )
      }
    }

    row(class = env_add) {
      button(class = btn_primary, on_click = hc_save, disabled = @busy_hc_save, text = Save)
      text(class = muted, content = "@svc_action_msg")
    }
  }
}
