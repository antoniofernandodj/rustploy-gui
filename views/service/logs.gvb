// Aba Logs do detalhe do serviço (importada por service.gvb). A condição de
// visibilidade vai na CHAMADA — `ServiceLogsTab(if = @tab, equals = logs)` —
// e não na raiz deste componente: lá o `if` não é aplicado e o painel
// apareceria em todas as abas.
// Logs de runtime: vivem numa JANELA isolada (motor leve), não inline —
// renderizar o stream aqui reavaliaria a árvore inteira da janela principal
// por linha e a travava. A aba é só o launcher.
component {
  column(class = log_panel) {
    text(
      class = muted,
      content = """
        Os logs de runtime abrem numa janela própria, isolada do restante
        do app (para não travar a interface sob alto volume de logs).
      """,
    )

    row(class = env_add) {
      button(
        class = btn_primary,
        on_click = open_logs_window,
        text = "Abrir logs em janela",
      )
    }
  }
}
