// Aba Logs do detalhe do serviço (importada por service.gvb).
component {
  column(class = log_panel) {
    text(
      class = muted,
      content = """
        Os logs de runtime abrem numa janela própria, isolada do restante
        do app (para não travar a interface sob alto volume de logs).
      """,
    )

    row(class = env_add) {
      button(
        class = btn_primary,
        on_click = open_logs_window,
        disabled = @busy_open_logs_window,
        text = "Abrir logs em janela",
      )
    }
  }
}
