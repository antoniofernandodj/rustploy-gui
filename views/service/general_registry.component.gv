// Sub-aba Registry do provider: escolhe repositório e tag do registry embutido; corpo do `if @provider_tab == "registry"` de general.component.gv.
component {
  text(
    "{t('general_registry.pick_hint')}",
    class = u-muted,
  )

  row(class = busy-row, if = @registry_picker_message, not_equals = "") {
    spinner(class = busy-row__spin, if = @registry_picker_busy)
    text("@registry_picker_message", class = u-muted)
  }

  text("{t('common.repository')}", class = u-label-cap)

  select(
    class = form-select,
    :options = registry_picker_repos,
    :value = registry_picker_repo,
    on_change = registry_picker_repo_pick,
    placeholder = "{t('general_registry.select_the_repository')}",
    label_field = name,
    value_field = name,
  )

  text("{t('general_registry.tag')}", class = u-label-cap)

  select(
    class = form-select,
    :options = registry_picker_tags,
    :value = registry_picker_tag,
    on_change = registry_picker_tag_pick,
    placeholder = "{t('general_registry.select_the_tag')}",
    label_field = tag,
    value_field = tag,
  )

  text("{t('general_gitea.current_selection')}", class = u-label-cap)

  row(class = kv-list__row) {
    text("{t('general_registry.image')}", class = kv-list__key)
    text("@registry_picker_image", class = "kv-list__val kv-list__val--compact")
  }

  text("{t('common.port')}", class = u-label-cap)

  input(
    class = field__input,
    form_control = service_form_general_port,
    :value = service_form_general_port,
    on_change = field:service_form_general_port,
    placeholder = 80,
  )

  row(class = env__add) {
    button(
      class = "btn btn--primary",
      on_click = general_save,
      disabled = @busy_general_save,
      text = "{t('common.save_2')}",
    )

    text("@service_action_message", class = u-muted)
  }
}
