// Editor do YAML de um serviço Compose (bancos/brokers); o corpo do `if @service_source_kind == "Compose"` de general.gvb.
component {
  text("DOCKER COMPOSE (YAML)", class = u-label-cap)

  text(
    """
      Edite o compose do serviço. Salvar aplica no próximo deploy.
    """,
    class = u-muted,
  )

  textarea(
    class = env__editor,
    font = mono,
    :value = service_compose,
    placeholder = l"""
      services:
        app:
          image: …
    """,
  )

  row(class = env__add) {
    button(
      class = "btn btn--primary",
      on_click = compose_save,
      disabled = @busy_compose_save,
      text = "Salvar compose",
    )

    button(
      class = "btn btn--ghost",
      on_click = compose_cancel,
      disabled = @busy_compose_cancel,
      text = Cancelar,
    )

    text("@service_action_message", class = u-muted)
  }
}
