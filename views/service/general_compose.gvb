// Editor do YAML de um serviço Compose (bancos/brokers); o corpo do `if @service_source_kind == "Compose"` de general.gvb.
component {
  text("{t('general_compose.docker_compose_yaml')}", class = u-label-cap)

  text(
    "{t('general_compose.edit_the_service_s_compose_saving')}",
    class = u-muted,
  )

  textarea(
    class = env__editor,
    font = mono,
    :value = service_compose,
    placeholder = l"""
      services:
        app:
          image: …
    """,
  )

  row(class = env__add) {
    button(
      class = "btn btn--primary",
      on_click = compose_save,
      disabled = @busy_compose_save,
      text = "{t('general_compose.save_compose')}",
    )

    button(
      class = "btn btn--ghost",
      on_click = compose_cancel,
      disabled = @busy_compose_cancel,
      text = "{t('common.cancel')}",
    )

    text("@service_action_message", class = u-muted)
  }
}
