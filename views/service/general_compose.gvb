// Editor do YAML de um serviço Compose (bancos/brokers); o corpo do `if @svc_source_kind == "Compose"` de general.gvb.
component {
  text(class = label_cap, content = "DOCKER COMPOSE (YAML)")

  text(
    class = muted,
    content = """
      Edite o compose do serviço. Salvar aplica no próximo deploy.
    """,
  )

  textarea(
    class = env_editor,
    font = mono,
    :value = svc_compose,
    placeholder = l"""
      services:
        app:
          image: …
    """,
  )

  row(class = env_add) {
    button(
      class = btn_primary,
      on_click = compose_save,
      text = "Salvar compose",
    )

    button(
      class = btn_ghost,
      on_click = compose_cancel,
      text = Cancelar,
    )

    text(class = muted, content = "@svc_action_msg")
  }
}
