// Sub-aba Git do provider: URL/imagem crua; corpo do `if @provider_tab == "git"` de general.gvb.
component {
  text(
    "SOURCE — REPOSITORY URL / IMAGE",
    class = u-label-cap,
  )

  input(
    class = field__input,
    form_control = service_form_repo_url,
    :value = service_form_repo_url,
    on_change = field:service_form_repo_url,
    placeholder = "github.com/user/repo  ou  nginx:latest",
  )

  text(
    """
      URL de repositório vira Git; caso contrário é imagem de
      registry.
    """,
    class = u-muted,
  )

  row(class = healthcheck__grid) {
    column(class = healthcheck__field) {
      text("BRANCH", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_branch,
        :value = service_form_branch,
        on_change = field:service_form_branch,
        placeholder = main,
      )
    }

    column(class = healthcheck__field) {
      text("PORT", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_general_port,
        :value = service_form_general_port,
        on_change = field:service_form_general_port,
        placeholder = 80,
      )

      text(
        "@error_service_form_general_port",
        if = @error_service_form_general_port,
        not_equals = "",
        class = u-error,
      )
    }
  }

  row(class = healthcheck__grid) {
    column(class = healthcheck__field) {
      text("USERNAME", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_username,
        :value = service_form_username,
        on_change = field:service_form_username,
        placeholder = "(opcional)",
      )
    }

    column(class = healthcheck__field) {
      text("CREDENTIALS (secret)", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_credentials,
        :value = service_form_credentials,
        on_change = field:service_form_credentials,
        placeholder = "(opcional)",
      )

      text(
        """
          Nome de um secret do projeto (aba Secrets), puro — sem
          <secret:>. Usado para clonar repositório Git privado
          via HTTPS; não tem efeito com URL SSH.
        """,
        class = u-muted,
      )
    }
  }

  text("BUILD PATH (root)", class = u-label-cap)

  input(
    class = field__input,
    form_control = service_form_build_path,
    :value = service_form_build_path,
    on_change = field:service_form_build_path,
    placeholder = .,
  )

  text(
    "WATCH PATHS (separados por vírgula)",
    class = u-label-cap,
  )

  input(
    class = field__input,
    form_control = service_form_watch_paths,
    :value = service_form_watch_paths,
    on_change = field:service_form_watch_paths,
    placeholder = "src, Cargo.toml",
  )

  toggle(
    :checked = service_form_submodules,
    on_toggle = field:service_form_submodules,
    label = " Enable submodules",
  )

  text("BUILD ENGINE: DOCKERFILE", class = u-label-cap)

  row(class = healthcheck__grid) {
    column(class = healthcheck__field) {
      text("DOCKERFILE", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_dockerfile,
        :value = service_form_dockerfile,
        on_change = field:service_form_dockerfile,
        placeholder = Dockerfile,
      )
    }

    column(class = healthcheck__field) {
      text("CONTEXT PATH", class = u-label-cap)

      input(
        class = field__input,
        form_control = service_form_context_path,
        :value = service_form_context_path,
        on_change = field:service_form_context_path,
        placeholder = .,
      )
    }
  }

  text("BUILD STAGE (opcional)", class = u-label-cap)

  input(
    class = field__input,
    form_control = service_form_build_stage,
    :value = service_form_build_stage,
    on_change = field:service_form_build_stage,
    placeholder = "(multi-stage target)",
  )

  row(class = env__add) {
    button(
      class = "btn btn--primary",
      on_click = general_save,
      disabled = @busy_general_save,
      text = Save,
    )

    text("@service_action_message", class = u-muted)
  }
}
