// Item de navegação da sidebar: ícone (sempre visível) + rótulo (some abaixo de
// 900px de largura — ver @media abaixo, espelhando o breakpoint em que a
// sidebar encolhe no shell.gv).
component {
  props {
    prop(name = label)
    prop(name = icon)
    prop(name = target)
    prop(name = action)
  }

  resources {
    style """
    /* Bloco `nav-item`: o modificador `--active` na raiz recolore os filhos pelo
       combinador `>`, em vez de cada filho levar um par de classes _on/_off. */
    .nav-item         { width: fill; padding: 11 14; spacing: 10; align-y: center; color: var(--surface); cursor: pointer; }
    .nav-item--active { color: var(--blue); }
    .nav-item__icon   { size: 14; color: var(--faint); }
    .nav-item__label  { color: var(--muted); }
    .nav-item--active > .nav-item__icon  { color: var(--text); }
    .nav-item--active > .nav-item__label { color: var(--text); }
    """
  }

  button(
    class = "nav-item nav-item--active",
    if = @view,
    one_of = @target,
    on_click = @action,
    tooltip = @label,
  ) {
    text(class = nav-item__icon, content = "@icon")
    text(class = nav-item__label, content = "@label")
  }

  button(class = nav-item, else, on_click = @action, tooltip = @label) {
    text(class = nav-item__icon, content = "@icon")
    text(class = nav-item__label, content = "@label")
  }
}
