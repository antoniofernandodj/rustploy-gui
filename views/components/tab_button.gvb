// Botão de aba genérico.
component {
  props {
    prop(name = label)
    prop(name = current)
    prop(name = target)
    prop(name = action)
  }

  if @current == "@target" {
    button(class = "tabs__tab tabs__tab--active", on_click = @action, text = @label)
  } else {
    button(class = tabs__tab, on_click = @action, text = @label)
  }
}
