// Botão de aba genérico.
component {
  props {
    prop(name = label)
    prop(name = current)
    prop(name = target)
    prop(name = action)
  }

  resources {
    style """
    .tab_on {
      color: var(--blue);
      padding: 9 16;
      border-radius: 5
    }
    """
  }

  if @current == "@target" {
    button(class = tab_on, on_click = @action, text = @label)
  } else {
    button(class = tab, on_click = @action, text = @label)
  }
}
