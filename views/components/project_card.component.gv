// Template "fragment": dois nós de topo (o slot vazio e o card) — o glacier-ui
// (0.4.12+) embrulha múltiplas raízes num Fragment e aplica os filhos no pai,
// then o par if/else vira dois irmãos do grid, sem nó wrapper.
component {
  props {
    prop(name = id)
    prop(name = name)
    prop(name = service_count)
    prop(name = running_count)
    prop(name = description)
    prop(name = description_short, default = "")
    prop(name = description_truncated, default = "0")
    prop(name = description_popover_key, default = "")
    prop(name = can_delete)
    prop(name = filler)
    prop(name = environment_label, default = "")
  }

  if @filler == "1" {
    column(class = u-fill)
  } else {
    column(class = card) {
      row(class = card__head) {
        text("@name", class = card__name)
        text(
          "@environment_label",
          if = @environment_label != "",
          class = environment-badge,
        )
      }

      text(
        t("project_card.service_s_running", service_count = service_count, running_count = running_count),
        class = u-muted,
        size = 11,
      )

      // A descrição longa vem cortada (format/dashboard.luau); clicar nela
      // abre um popover com o texto inteiro. Curta, é só o texto.
      if @description_truncated == "1" {
        popover(
          :value = @description_popover_key,
          placement = bottom,
          align = start,
          panel_width = anchor,
        ) {
          text(
            "@description_short",
            slot = anchor,
            class = "u-muted project-card__description--truncated",
            cursor = pointer,
          )

          column(class = description-popover) {
            text("@description", class = description-popover__text)
          }
        }
      } else {
        text("@description", class = u-muted)
      }
      hr

      // Ações empilhadas: um botão fill disputando a linha com
      // texto/botão fica torto quando o card está estreito.
      button(
        t("common.open"),
        class = "card__action card__action--open",
        on_click = open_project(@id),
        disabled = @busy_open_project
      )

      button(
        t("common.remove"),
        class = "card__action card__action--danger",
        if = @can_delete == "1",
        on_click = delete_project(@id),
        disabled = @busy_delete_project
      )

      text(
        t("project_card.cannot_be_removed_it_has"),
        class = u-muted,
        if = @can_delete != "1",
      )
    }
  }
}
