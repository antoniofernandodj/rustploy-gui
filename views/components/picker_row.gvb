// Linha de escolha do wizard "Novo serviço": título + subtítulo à esquerda e um
// botão de ação à direita.
component {
  props {
    prop(name = title)
    prop(name = subtitle)
    prop(name = button_label)
    prop(name = action)
  }

  row(class = kv_row) {
    column(class = header_titles) {
      text(class = env_key, content = "@title")
      text(class = muted, content = "@subtitle")
    }

    button(class = btn_primary, on_click = @action, text = @button_label)
  }
}
