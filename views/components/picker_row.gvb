// Linha de escolha do wizard "Novo serviço": título + subtítulo à esquerda e um
// botão de ação à direita.
component {
  props {
    prop(name = title)
    prop(name = subtitle)
    prop(name = button_label)
    prop(name = action)
  }

  row(class = kv-list__row) {
    column(class = page-head__titles) {
      text("@title", class = env__key)
      text("@subtitle", class = u-muted)
    }

    button(class = "btn btn--primary", on_click = @action, text = @button_label)
  }
}
