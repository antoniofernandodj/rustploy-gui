// Variante "badge" da célula de estado (mesmo ponto + rótulo, mas com o
// espaçamento/estilo de crachá — `badge_lbl`).
component {
  // Contrato do componente: o que era o comentário "
  // verificado. Prop passada e não declarada vira erro citando estas.
  props {
    prop(name = color)
    prop(name = label)
  }

  row(class = badge) {
    text(class = status-dot, color = @color, content = "●")
    text(class = badge__label, color = @color, content = "@label")
  }
}
