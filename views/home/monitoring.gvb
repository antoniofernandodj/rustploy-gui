// Seção `monitoring` (view = monitoring) das telas globais; importada por home.gvb.
component {
  resources {
    // Vazio das listas Docker/Monitoring e dos repositórios do registry.
    component(name = SemMetricas) {
      text(
        class = muted,
        content = """
          Nenhuma métrica ainda — aguardando o primeiro container em execução.
        """,
      )
    }
  }

  row(class = header_row) {
    column(class = header_titles) {
      text(class = title, content = "Monitoring")

      text(
        class = subtitle,
        content = "Host and per-container resource usage.",
      )
    }
  }

  row(class = "stats_row stats_hide_md") {
    StatCard(label = CPU, value = @sys_cpu)
    StatCard(label = MEMORY, value = @sys_mem, accent = 1)
    StatCard(label = DISK, value = @sys_disk)
    StatCard(label = LOAD, value = @sys_load)
  }

  column(class = panel_fill) {
    tableview(
      :items = monitoring,
      :sort = monitoring_sort,
      var = m,
      header_class = "thead th",
      row_class = "trow td tv_row",
      class = scroll_fill,
    ) {
      tablecolumn(key = name, label = CONTAINER, class = col_svc) {
        text(class = td_key, content = "@m.name")
      }

      tablecolumn(key = project, label = PROJETO, class = col_proj)
      tablecolumn(key = cpu, sort_key = cpu_n, label = CPU, class = col_dur)
      tablecolumn(key = mem, sort_key = mem_n, label = MEM, class = col_dur)

      tablecolumn(key = rx, sort_key = rx_n, label = RX, class = col_dur) {
        text(class = muted, content = "@m.rx")
      }

      tablecolumn(key = tx, sort_key = tx_n, label = TX, class = col_start) {
        text(class = muted, content = "@m.tx")
      }

      if @data_loading == "true" {
        LoadingRow
      } else {
        SemMetricas
      }
    }
  }
}
