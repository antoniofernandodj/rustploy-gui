// Seção `schedules` (view = schedules) das telas globais; importada por home.gvb.
component {
  resources {
    component(name = SemJobs) {
      text(class = u-muted, content = "Nenhum job cadastrado ainda.")
    }
  }

  row(class = page-head) {
    column(class = page-head__titles) {
      text(class = page-head__title, content = "Schedules")

      text(
        class = page-head__subtitle,
        content = """
          Tarefas one-shot (docker-compose) agendadas ou manuais, de todos
          os projetos.
        """,
      )
    }

    row(class = "page-head__stats page-head__stats--hide-md") {
      StatCard(label = JOBS, value = @jobs_count)
    }

    button(
      class = "btn btn--primary",
      on_click = open_new_job_window,
      disabled = @busy_open_new_job_window,
      text = "+ Novo job",
    )
  }

  column(class = "panel panel--fill") {
    tableview(
      :items = jobs_summary,
      :sort = jobs_sort,
      var = j,
      header_class = "table__head table__head-cell",
      row_class = "table__row table__cell table__row--divided",
      class = u-fill-all,
    ) {
      tablecolumn(key = name, label = NOME, class = table__col-svc) {
        text(class = "table__cell table__cell--key", content = "@j.name")
      }

      tablecolumn(key = owner, label = "PROJETO / GATILHO", class = table__col-proj)

      tablecolumn(
        key = last_run_label,
        label = "ÚLTIMA EXECUÇÃO",
        class = table__col-state,
      ) {
        StateCell(kind = @j.last_run_kind, label = @j.last_run_label)
      }

      tablecolumn(key = recurrence, label = "RECORRÊNCIA", class = table__col-dur) {
        text(class = u-muted, content = "@j.recurrence")
      }

      tablecolumn(
        key = next_run_at,
        label = "PRÓXIMA EXECUÇÃO",
        class = table__col-dur,
      ) {
        text(class = u-muted, content = "@j.next_run_at")
      }

      tablecolumn(label = "AÇÕES", class = table__col-act-5, align = right) {
        row(class = table__col-act-5) {
          button(
            class = "btn btn--ghost btn--xs",
            if = @j.running,
            not_equals = true,
            on_click = job_run_now:@j.id,
            disabled = @busy_job_run_now,
            text = "▶",
            tooltip = "Rodar agora",
          )

          button(
            class = env__del,
            if = @j.running,
            equals = true,
            on_click = job_run_cancel:@j.last_run_id,
            disabled = @busy_job_run_cancel,
            text = "■",
            tooltip = Cancelar,
          )

          button(
            class = "btn btn--ghost btn--xs",
            if = @j.last_run_id,
            not_equals = "",
            on_click = open_job_logs_window:@j.last_run_id,
            disabled = @busy_open_job_logs_window,
            text = "≡",
            tooltip = "Ver logs",
          )

          button(
            class = "btn btn--ghost btn--xs",
            if = @j.enabled,
            equals = true,
            on_click = job_toggle:@j.id,
            disabled = @busy_job_toggle,
            text = "‖",
            tooltip = Pausar,
          )

          button(
            class = "btn btn--ghost btn--xs",
            if = @j.enabled,
            not_equals = true,
            on_click = job_toggle:@j.id,
            disabled = @busy_job_toggle,
            text = "▶",
            tooltip = Ativar,
          )

          button(
            class = "btn btn--ghost btn--xs",
            on_click = open_edit_job_window:@j.id,
            disabled = @busy_open_edit_job_window,
            text = "✎",
            tooltip = Editar,
          )

          button(
            class = env__del,
            on_click = job_delete:@j.id,
            disabled = @busy_job_delete,
            text = "✕",
            tooltip = Remover,
          )
        }
      }

      SemJobs
    }
  }
}
