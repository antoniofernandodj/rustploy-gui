// Seção `schedules` (view = schedules) das telas globais; importada por home.gvb.
component {
  resources {
    component(name = SemJobs) {
      text(class = muted, content = "Nenhum job cadastrado ainda.")
    }
  }

  row(class = header_row) {
    column(class = header_titles) {
      text(class = title, content = "Schedules")

      text(
        class = subtitle,
        content = """
          Tarefas one-shot (docker-compose) agendadas ou manuais, de todos
          os projetos.
        """,
      )
    }

    row(class = "stats_row stats_hide_md") {
      StatCard(label = JOBS, value = @jobs_count)
    }

    button(
      class = btn_primary,
      on_click = open_new_job_window,
      disabled = @busy_open_new_job_window,
      text = "+ Novo job",
    )
  }

  column(class = panel_fill) {
    tableview(
      :items = jobs_summary,
      :sort = jobs_sort,
      var = j,
      header_class = "thead th",
      row_class = "trow td tv_row",
      class = scroll_fill,
    ) {
      tablecolumn(key = name, label = NOME, class = col_svc) {
        text(class = td_key, content = "@j.name")
      }

      tablecolumn(key = owner, label = "PROJETO / GATILHO", class = col_proj)

      tablecolumn(
        key = last_run_label,
        label = "ÚLTIMA EXECUÇÃO",
        class = col_state,
      ) {
        StateCell(kind = @j.last_run_kind, label = @j.last_run_label)
      }

      tablecolumn(key = recurrence, label = "RECORRÊNCIA", class = col_dur) {
        text(class = muted, content = "@j.recurrence")
      }

      tablecolumn(
        key = next_run_at,
        label = "PRÓXIMA EXECUÇÃO",
        class = col_dur,
      ) {
        text(class = muted, content = "@j.next_run_at")
      }

      tablecolumn(label = "AÇÕES", class = col_act_5, align = right) {
        row(class = col_act_5) {
          button(
            class = copy_btn,
            if = @j.running,
            not_equals = true,
            on_click = job_run_now:@j.id,
            disabled = @busy_job_run_now,
            text = "▶",
            tooltip = "Rodar agora",
          )

          button(
            class = env_del,
            if = @j.running,
            equals = true,
            on_click = job_run_cancel:@j.last_run_id,
            disabled = @busy_job_run_cancel,
            text = "■",
            tooltip = Cancelar,
          )

          button(
            class = copy_btn,
            if = @j.last_run_id,
            not_equals = "",
            on_click = open_job_logs_window:@j.last_run_id,
            disabled = @busy_open_job_logs_window,
            text = "≡",
            tooltip = "Ver logs",
          )

          button(
            class = copy_btn,
            if = @j.enabled,
            equals = true,
            on_click = job_toggle:@j.id,
            disabled = @busy_job_toggle,
            text = "‖",
            tooltip = Pausar,
          )

          button(
            class = copy_btn,
            if = @j.enabled,
            not_equals = true,
            on_click = job_toggle:@j.id,
            disabled = @busy_job_toggle,
            text = "▶",
            tooltip = Ativar,
          )

          button(
            class = copy_btn,
            on_click = open_edit_job_window:@j.id,
            disabled = @busy_open_edit_job_window,
            text = "✎",
            tooltip = Editar,
          )

          button(
            class = env_del,
            on_click = job_del:@j.id,
            disabled = @busy_job_del,
            text = "✕",
            tooltip = Remover,
          )
        }
      }

      SemJobs
    }
  }
}
