// Seção `ingress` (view = ingress) das telas globais; importada por home.gvb.
component {
  resources {
    component(name = SemPortasDeHost) {
      text(
        class = u-muted,
        content = "Nenhum serviço com porta de host configurada.",
      )
    }
  }

  row(class = page-head) {
    column(class = page-head__titles) {
      text(class = page-head__title, content = "Ingress")

      text(
        class = page-head__subtitle,
        content = "Active routes in the reverse proxy.",
      )
    }

    row(class = page-head__stats) {
      StatCard(label = ROUTES, value = @ingress_count)
      StatCard(label = "PORTAS DE HOST", value = @host_ports_count)
    }
  }

  column(class = "panel panel--fill") {
    tableview(
      :items = ingress,
      :sort = ingress_sort,
      var = i,
      header_class = "table__head table__head-cell",
      row_class = "table__row table__cell table__row--divided",
      class = u-fill-all,
    ) {
      tablecolumn(key = domain, label = "DOMÍNIO", class = table__col-svc) {
        text(class = "table__cell table__cell--key", content = "@i.domain")
      }

      tablecolumn(key = service, label = "SERVIÇO", class = table__col-proj)
      tablecolumn(key = upstream, label = UPSTREAM, class = table__col-dur)

      tablecolumn(key = tls, label = TLS, class = table__col-start) {
        text(class = u-muted, content = "@i.tls")
      }

      if @data_loading == "true" {
        LoadingRow
      }
    }

    text(
      class = u-label-cap,
      content = "PORTAS TCP DE HOST (@host_ports_count)",
    )

    // Sem `height`: a lista é curta e cresce com a página, sem rolagem própria.
    tableview(
      :items = host_ports,
      :sort = host_ports_sort,
      var = hp,
      header_class = "table__head table__head-cell",
      row_class = "table__row table__cell table__row--divided",
      width = fill,
    ) {
      tablecolumn(key = service, label = "SERVIÇO", class = table__col-svc) {
        text(class = "table__cell table__cell--key", content = "@hp.service")
      }

      tablecolumn(key = project, label = PROJETO, class = table__col-proj)
      tablecolumn(key = host_port, label = "PORTA HOST", class = table__col-dur)

      tablecolumn(
        key = container_port,
        label = "PORTA CONTAINER",
        class = table__col-start,
      ) {
        text(class = u-muted, content = "@hp.container_port")
      }

      SemPortasDeHost
    }
  }
}
