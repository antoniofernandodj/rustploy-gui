// Seção `ingress` (view = ingress) das telas globais; importada por home.gvb.
component {
  resources {
    component(name = SemPortasDeHost) {
      text(
        class = muted,
        content = "Nenhum serviço com porta de host configurada.",
      )
    }
  }

  row(class = header_row) {
    column(class = header_titles) {
      text(class = title, content = "Ingress")

      text(
        class = subtitle,
        content = "Active routes in the reverse proxy.",
      )
    }

    row(class = stats_row) {
      StatCard(label = ROUTES, value = @ingress_count)
      StatCard(label = "PORTAS DE HOST", value = @host_ports_count)
    }
  }

  column(class = panel_fill) {
    tableview(
      :items = ingress,
      :sort = ingress_sort,
      var = i,
      header_class = "thead th",
      row_class = "trow td tv_row",
      class = scroll_fill,
    ) {
      tablecolumn(key = domain, label = "DOMÍNIO", class = col_svc) {
        text(class = td_key, content = "@i.domain")
      }

      tablecolumn(key = service, label = "SERVIÇO", class = col_proj)
      tablecolumn(key = upstream, label = UPSTREAM, class = col_dur)

      tablecolumn(key = tls, label = TLS, class = col_start) {
        text(class = muted, content = "@i.tls")
      }

      if @data_loading == "true" {
        LoadingRow
      }
    }

    text(
      class = label_cap,
      content = "PORTAS TCP DE HOST (@host_ports_count)",
    )

    // Sem `height`: a lista é curta e cresce com a página, sem rolagem própria.
    tableview(
      :items = host_ports,
      :sort = host_ports_sort,
      var = hp,
      header_class = "thead th",
      row_class = "trow td tv_row",
      width = fill,
    ) {
      tablecolumn(key = service, label = "SERVIÇO", class = col_svc) {
        text(class = td_key, content = "@hp.service")
      }

      tablecolumn(key = project, label = PROJETO, class = col_proj)
      tablecolumn(key = host_port, label = "PORTA HOST", class = col_dur)

      tablecolumn(
        key = container_port,
        label = "PORTA CONTAINER",
        class = col_start,
      ) {
        text(class = muted, content = "@hp.container_port")
      }

      SemPortasDeHost
    }
  }
}
