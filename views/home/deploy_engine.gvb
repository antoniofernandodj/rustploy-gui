// Seção `deploy_engine` (view = deploy_engine) das telas globais; importada por home.gvb.
component {
  resources {
    link(rel = import, href = "deploy_engine/fila.gvb", as = EngineFilaTab)
    link(rel = import, href = "deploy_engine/executando.gvb", as = EngineExecutandoTab)
    link(rel = import, href = "deploy_engine/historico.gvb", as = EngineHistoricoTab)
  }

  row(class = page-head) {
    column(class = page-head__titles) {
      text(class = page-head__title, content = "Deploy Engine")

      text(
        class = page-head__subtitle,
        content = "Pipeline de deploy: em andamento e histórico recente.",
      )
    }

    // 5 cards + valor largo (UPTIME) ao lado do título: deixa de caber
    // bem antes dos breakpoints gerais — some mais cedo (xl).
    row(class = "page-head__stats page-head__stats--hide-xl") {
      StatCard(label = ATIVOS, value = @deploy_engine_active_count, accent = 1)
      StatCard(label = "SUCESSO 24H", value = @deploy_engine_success_24h)
      StatCard(label = "FALHAS 24H", value = @deploy_engine_failed_24h)
      StatCard(label = "TOTAL 24H", value = @deploy_engine_total_24h)
      StatCard(label = UPTIME, value = @deploy_engine_uptime)
    }
  }

  row(class = tabs) {
    TabButton(
      label = "Fila (@deploy_engine_queued_count)",
      current = @deploy_engine_tab,
      target = fila,
      action = deploy_engine_tab:fila,
    )

    TabButton(
      label = "Executando (@deploy_engine_active_count)",
      current = @deploy_engine_tab,
      target = executando,
      action = deploy_engine_tab:executando,
    )

    TabButton(
      label = "Histórico 24h (@deploy_engine_recent_count)",
      current = @deploy_engine_tab,
      target = historico,
      action = deploy_engine_tab:historico,
    )
  }

  hr

  EngineFilaTab(if = @deploy_engine_tab, equals = fila)

  EngineExecutandoTab(if = @deploy_engine_tab, equals = executando)

  EngineHistoricoTab(if = @deploy_engine_tab, equals = historico)
}
