// Web Server (default)
component {
  form(
    error_prefix = error_,
    name = settings,
    on_submit = settings_save,
    class = form
  ) {
    scrollable(direction = vertical, class = u-fill-all) {
      column(class = form-stack) {
        column(class = "form-panel form-panel--grouped") {
          field(
            label = t("settings_web.public_api_url"),
            label_class = u-label-cap,
            description =
              t("settings_web.derived_from_api_domain_port_in"),
          ) {
            row(class = copy-row) {
              container(class = copy-row__value) {
                text("@server_settings_public_base", class = copy-row__text)
              }

              button(
                t("common.copy"),
                class = "btn btn--ghost btn--sm",
                on_click = copy_ctx("server_settings_public_base")
              )
            }
          }

          field(
            label = t("settings_web.connection_token"),
            label_class = u-label-cap,
            description =
              t("settings_web.base64_of_host_port_token_server"),
          ) {
            row(class = copy-row) {
              container(class = copy-row__value) {
                text("@server_access_key_short", class = copy-row__text)
              }

              button(
                t("common.copy"),
                class = "btn btn--ghost btn--sm",
                on_click = copy_ctx("server_access_key")
              )
            }
          }

          field(
            label = t("settings_web.let_s_encrypt_email_automatic"),
            label_class = u-label-cap,
            error = @error_server_settings_email,
            description =
              t("settings_web.tls_certificates_issued_automatically"),
          ) {
            input(
              placeholder = t("settings_web.you_example_com"),
              class = field__input,
              form_control = server_settings_email,
            )
          }

          field(
            label = t("settings_web.registry_domain_public_exposure"),
            label_class = u-label-cap,
            description =
              t("settings_web.exposes_the_built_in_docker_registry"),
          ) {
            input(
              placeholder = t("settings_web.registry_mysite_com"),
              class = field__input,
              form_control = server_settings_registry_domain,
            )
          }

          row(class = form-panel__actions) {
            button(
              t("common.save_2"),
              class = "btn btn--primary",
              type = submit,
              disabled = @busy_settings_save
            )
            text("@settings_message", class = u-muted)
          }
        }

        column(class = "form-panel form-panel--grouped") {
          column(class = form-panel__head) {
            text(
              t("settings_web.connect_an_ai_agent_mcp"),
              class = u-label-cap
            )
            text(
              t("settings_web.each_button_copies_this_server_s"),
              class = u-muted,
            )
          }

          field(
            label = t("settings_web.claude_code"),
            label_class = u-label-cap
          ) {
            row(class = copy-row) {
              container(class = copy-row__value) {
                text(
                  t("settings_web.claude_mcp_add_rustploy_mcp"),
                  class = copy-row__text
                )
              }

              button(
                t("common.copy"),
                class = "btn btn--ghost btn--sm",
                on_click = copy_ctx("server_mcp_command")
              )
            }
          }

          field(
            label = t("settings_web.codex_codex_config_toml"),
            label_class = u-label-cap
          ) {
            row(class = copy-row) {
              container(class = copy-row__value) {
                text(
                  t("settings_web.mcp_servers_rustploy_url_mcp"),
                  class = copy-row__text
                )
              }

              button(
                t("common.copy"),
                class = "btn btn--ghost btn--sm",
                on_click = copy_ctx("server_mcp_command_codex")
              )
            }
          }

          field(
            label = t("settings_web.gemini_cli"),
            label_class = u-label-cap
          ) {
            row(class = copy-row) {
              container(class = copy-row__value) {
                text(
                  t("settings_web.gemini_mcp_add_rustploy_mcp"),
                  class = copy-row__text
                )
              }

              button(
                t("common.copy"),
                class = "btn btn--ghost btn--sm",
                on_click = copy_ctx("server_mcp_command_gemini")
              )
            }
          }
        }
      }
    }
  }
}
