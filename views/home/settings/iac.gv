// Infra as Code: o manifesto é um `.zip` com exatamente rustploy.yml
// (projetos/serviços, env vars sempre como ${VAR}) + rustploy.vars.toml
// (os valores reais, aninhados por escopo).
component {
  scrollable(direction = vertical, class = u-fill-all) {
    column(class = form-panel) {
      text("{t('settings_iac.export')}", class = u-label-cap)

      text(
        "{t('settings_iac.generates_a_zip_with_rustploy_yml')}",
        class = u-muted,
      )

      row(class = busy-row) {
        button(
          class = "btn btn--primary",
          on_click = manifest_export,
          disabled = @busy_manifest_export,
          text = "{t('settings_iac.export_to_a_zip')}",
        )

        spinner(class = busy-row__spin, if = @manifest_busy)
        text("@manifest_export_message", class = u-muted)
      }

      hr
      text("{t('settings_iac.import')}", class = u-label-cap)

      text(
        "{t('settings_iac.choose_the_manifest_zip_the_same')}",
        class = u-muted,
      )

      row(class = env__add) {
        checkbox(
          :checked = manifest_prune,
          on_toggle = field:manifest_prune,
          label = "{t('settings_iac.remove_services_missing_from_the')}",
        )
      }

      row(class = env__add) {
        checkbox(
          :checked = manifest_deploy,
          on_toggle = field:manifest_deploy,
          label = "{t('settings_iac.trigger_a_deploy_of_the')}",
        )
      }

      row(class = busy-row) {
        button(
          class = "btn btn--primary",
          on_click = manifest_import,
          disabled = @busy_manifest_import,
          text = "{t('settings_iac.import_from_a_zip')}",
        )

        spinner(class = busy-row__spin, if = @manifest_busy)
        text("@manifest_import_message", class = u-muted)
      }

      if @manifest_has_missing == "true" {
        text(
          "{t('settings_iac.variables_with_no_value_in', manifest_missing_vars=manifest_missing_vars)}",
          class = u-error,
        )
      }

      if @manifest_has_report == "true" {
        text("{t('settings_iac.result')}", class = u-label-cap)

        column(class = kv-list) {
          row(class = kv-list__row, :for_each = manifest_report_lines, var = l) {
            text("@l", class = u-muted)
          }
        }
      }
    }
  }
}
