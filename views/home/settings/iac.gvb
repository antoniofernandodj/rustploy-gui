// Infra as Code: o manifesto é um `.zip` com exatamente rustploy.yml
// (projetos/serviços, env vars sempre como ${VAR}) + rustploy.vars.toml
// (os valores reais, aninhados por escopo).
component {
  scrollable(direction = vertical, class = u-fill-all) {
    column(class = form-panel) {
      text(class = u-label-cap, content = "EXPORTAR")

      text(
        class = u-muted,
        content = """
          Gera um `.zip` com rustploy.yml + rustploy.vars.toml no lugar
          que você escolher. Os valores das env vars ficam só no TOML;
          secrets nunca saem do daemon.
        """,
      )

      row(class = busy-row) {
        button(
          class = "btn btn--primary",
          on_click = manifest_export,
          disabled = @busy_manifest_export,
          text = "Exportar para um .zip…",
        )

        spinner(class = busy-row__spin, if = @manifest_busy)
        text(class = u-muted, content = "@manifest_export_message")
      }

      hr
      text(class = u-label-cap, content = "IMPORTAR")

      text(
        class = u-muted,
        content = """
          Escolha o `.zip` do manifesto (o mesmo que o Exportar gera). Ele
          precisa ter exatamente um .yml e um .toml na raiz — nada mais,
          ou o import é recusado. Falta o valor de alguma variável usada
          no YAML? Também é cancelado antes de aplicar qualquer coisa (a
          faltante vem rotulada com o escopo, ex. "Chiquitos/api:
          APP_PORT").
        """,
      )

      row(class = env__add) {
        checkbox(
          :checked = manifest_prune,
          on_toggle = field:manifest_prune,
          label = "Remover serviços ausentes do manifesto (prune)",
        )
      }

      row(class = env__add) {
        checkbox(
          :checked = manifest_deploy,
          on_toggle = field:manifest_deploy,
          label = "Disparar deploy dos serviços criados/alterados",
        )
      }

      row(class = busy-row) {
        button(
          class = "btn btn--primary",
          on_click = manifest_import,
          disabled = @busy_manifest_import,
          text = "Importar de um .zip…",
        )

        spinner(class = busy-row__spin, if = @manifest_busy)
        text(class = u-muted, content = "@manifest_import_message")
      }

      if @manifest_has_missing == "true" {
        text(
          class = u-error,
          content = "Variáveis sem valor no TOML: @manifest_missing_vars",
        )
      }

      if @manifest_has_report == "true" {
        text(class = u-label-cap, content = "RESULTADO")

        column(class = kv-list) {
          row(class = kv-list__row, :for-each = manifest_report_lines, var = l) {
            text(class = u-muted, content = "@l")
          }
        }
      }
    }
  }
}
