// Atualizações: pergunta ao daemon se há release mais nova (Command::CheckUpdate).
// Só consulta — instalar é manual por enquanto (docs/plano-updaters-daemon-e-gui.md).
component {
  scrollable(direction = vertical, class = u-fill-all) {
    column(class = form-panel) {
      text("{t('settings_updates.daemon')}", class = u-label-cap)

      row(class = kv-list__row) {
        text("{t('settings_updates.installed_version')}", class = kv-list__key)
        text("@update_current_version", class = "kv-list__val kv-list__val--compact")
      }

      row(class = kv-list__row) {
        text("{t('settings_updates.latest_version')}", class = kv-list__key)
        text("@update_latest_version", class = "kv-list__val kv-list__val--compact")
      }

      row(class = kv-list__row) {
        text("{t('settings_updates.checked_at')}", class = kv-list__key)
        text("@update_checked_at_label", class = "kv-list__val kv-list__val--compact")
      }

      row(class = healthcheck__grid) {
        button(
          "{t('settings_updates.check_for_updates')}",
          class = "btn btn--ghost btn--sm",
          on_click = update_check_now
        )
      }

      text("@update_message", class = u-muted)

      if @update_is_helper_available == "true" {
        text("{t('settings_updates.update_from_the_app')}", class = u-label-cap)

        text(
          "{t('settings_updates.the_daemon_downloads_the_new_version')}",
          class = u-muted,
        )

        row(class = healthcheck__grid) {
          if @update_is_available == "true" {
            button(
              "{t('settings_updates.update_daemon')}",
              class = "btn btn--primary btn--sm",
              on_click = update_apply
            )
          }

          button(
            "{t('settings_updates.roll_back_to_the_previous')}",
            class = "btn btn--ghost btn--sm",
            on_click = update_rollback
          )
        }
      }

      text("@update_progress_message", class = u-muted)

      if @update_app_current_version != "" {
        text("{t('settings_updates.desktop_app')}", class = u-label-cap)

        row(class = kv-list__row) {
          text("{t('settings_updates.installed_version')}", class = kv-list__key)
          text("@update_app_current_version", class = "kv-list__val kv-list__val--compact")
        }

        row(class = kv-list__row) {
          text("{t('settings_updates.latest_version')}", class = kv-list__key)
          text("@update_app_latest_version", class = "kv-list__val kv-list__val--compact")
        }

        text("@update_app_message", class = u-muted)

        if @update_app_is_available == "true" {
          if @update_app_can_update == "true" {
            row(class = healthcheck__grid) {
              button(
                "{t('settings_updates.update_app')}",
                class = "btn btn--primary btn--sm",
                on_click = update_app_apply
              )
            }

            progressbar(if = @update_app_running, equals = true, :value = update_app_percent)

            row(class = healthcheck__grid) {
              button(
                "{t('common.cancel')}",
                class = "btn btn--ghost btn--sm",
                on_click = update_app_cancel,
                if = @update_app_running,
                equals = true
              )
            }

            text("@update_app_apply_hint", class = u-muted)
          }

          if @update_app_can_update == "false" {
            text(
              "{t('settings_updates.this_app_was_not_installed')}",
              class = u-muted,
            )

            row(class = kv-list__row) {
              text("@update_app_manual_command", class = "kv-list__val kv-list__val--compact")

              button(
                "{t('common.copy')}",
                class = "btn btn--ghost btn--xs",
                on_click = copy_ctx:update_app_manual_command
              )
            }
          }
        }
      }

      if @update_is_available == "true" {
        text("{t('settings_updates.how_to_update_by_hand')}", class = u-label-cap)

        text(
          "{t('settings_updates.there_is_a_new_version_for')}",
          class = u-muted,
        )

        row(class = kv-list__row) {
          text("@update_install_command", class = "kv-list__val kv-list__val--compact kv-list__val--wrap")

          button(
            "{t('common.copy')}",
            class = "btn btn--ghost btn--xs",
            on_click = copy_ctx:update_install_command
          )
        }

        row(class = kv-list__row) {
          text("{t('settings_updates.release_notes')}", class = "kv-list__key kv-list__key--fit")
          text("@update_release_url", class = "kv-list__val kv-list__val--compact kv-list__val--wrap")

          button(
            "{t('common.copy')}",
            class = "btn btn--ghost btn--xs",
            on_click = copy_ctx:update_release_url
          )
        }
      }
    }
  }
}
