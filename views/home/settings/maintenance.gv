// Manutenção: limpeza automática de recursos do runtime sem uso (ver
// docs/plano-limpeza-automatica-docker.md) — mesmas funções dos botões
// manuais da aba Runtime, disparadas por agendamento em vez de clique.
component {
  scrollable(direction = vertical, class = u-fill-all) {
    column(class = form-panel) {
      text("{t('settings_maintenance.automatic_cleanup')}", class = u-label-cap)

      toggle(
        :checked = docker_cleanup_enabled,
        on_toggle = field:docker_cleanup_enabled,
        label = "{t('settings_maintenance.enable_automatic_cleanup')}",
      )

      text(
        "{t('settings_maintenance.runs_by_itself_at_the_time')}",
        class = u-muted,
      )

      text("{t('settings_maintenance.frequency')}", class = u-label-cap)

      scroll(class = tabs__scroll, direction = horizontal) {
        tabbar(
          :value = docker_cleanup_kind, active = @docker_cleanup_kind, :items = docker_cleanup_kinds,
          tab_class = tabs__tab, tab_active_class = "tabs__tab tabs__tab--active", padding = "9 16", size = 14, active_bold = false,
        )
      }

      row(class = healthcheck__grid, if = @docker_cleanup_kind, equals = interval) {
        column(class = healthcheck__field) {
          text("{t('settings_maintenance.every_hours')}", class = u-label-cap)

          // Teto de 168 = uma semana. Acima disso o usuário quer a
          // frequência "semanal", que é a aba ao lado.
          spinbox(
            field_class = field__spin,
            form_control = docker_cleanup_hours,
            :value = docker_cleanup_hours,
            min = 1,
            max = 168,
            width = 90,
            placeholder = 6,
          )
        }
      }

      scroll(class = tabs__scroll, direction = horizontal, if = @docker_cleanup_kind, equals = weekly) {
        row(class = tabs__main) {
          radiogroup(:value = docker_cleanup_weekday, :items = weekdays, layout = row)
        }
      }

      row(class = healthcheck__grid, if = @docker_cleanup_kind, not_equals = interval) {
        column(class = healthcheck__field) {
          text("{t('common.time')}", class = u-label-cap)
          timeedit(:value = docker_cleanup_time)
        }
      }

      text(
        "{t('settings_maintenance.next_scheduled_run', docker_cleanup_next_run_label=docker_cleanup_next_run_label)}",
        class = u-muted,
      )

      hr
      text("{t('settings_maintenance.what_to_clean')}", class = u-label-cap)

      checkbox(
        :checked = docker_cleanup_containers,
        on_toggle = field:docker_cleanup_containers,
        label = "{t('settings_maintenance.stopped_containers')}",
      )

      checkbox(
        :checked = docker_cleanup_images,
        on_toggle = field:docker_cleanup_images,
        label = "{t('settings_maintenance.unused_images')}",
      )

      checkbox(
        if = @docker_cleanup_images,
        equals = true,
        :checked = docker_cleanup_images_all,
        on_toggle = field:docker_cleanup_images_all,
        label = "{t('settings_maintenance.include_all_unused_not_just')}",
      )

      row(class = healthcheck__grid, if = @docker_cleanup_images, equals = true) {
        column(class = healthcheck__field) {
          text("{t('settings_maintenance.only_images_created_more_than')}", class = u-label-cap)

          spinbox(
            field_class = field__spin,
            form_control = docker_cleanup_images_older_than_hours,
            :value = docker_cleanup_images_older_than_hours,
            min = 0,
            max = 8760,
            width = 110,
            placeholder = 168,
          )

          text(
            "{t('settings_maintenance.0_does_not_filter_by_age')}",
            class = u-muted,
          )
        }
      }

      checkbox(
        :checked = docker_cleanup_networks,
        on_toggle = field:docker_cleanup_networks,
        label = "{t('settings_maintenance.unused_networks')}",
      )

      checkbox(
        :checked = docker_cleanup_build_cache,
        on_toggle = field:docker_cleanup_build_cache,
        label = "{t('settings_maintenance.build_cache')}",
      )

      row(class = healthcheck__grid, if = @docker_cleanup_build_cache, equals = true) {
        column(class = healthcheck__field) {
          text("{t('settings_maintenance.keep_the_cache_used_in')}", class = u-label-cap)

          spinbox(
            field_class = field__spin,
            form_control = docker_cleanup_build_cache_older_than_hours,
            :value = docker_cleanup_build_cache_older_than_hours,
            min = 0,
            max = 8760,
            width = 110,
            placeholder = 168,
          )

          text(
            "{t('settings_maintenance.0_removes_all_unused_cache_with')}",
            class = u-muted,
          )
        }
      }

      checkbox(
        :checked = docker_cleanup_warm_after,
        on_toggle = field:docker_cleanup_warm_after,
        label = "{t('settings_maintenance.warm_the_builds_after_cleanup')}",
      )

      text(
        "{t('settings_maintenance.after_cleaning_rebuilds_the_image_of')}",
        class = u-muted,
      )

      hr
      text("{t('settings_maintenance.volumes_careful')}", class = "u-label-cap u-error")

      text(
        "{t('settings_maintenance.unused_volumes_created_outside_rustploy_not')}",
        class = u-muted,
      )

      checkbox(
        :checked = docker_cleanup_volumes,
        on_toggle = field:docker_cleanup_volumes,
        label = "{t('settings_maintenance.unused_volumes')}",
      )

      checkbox(
        if = @docker_cleanup_volumes,
        equals = true,
        :checked = docker_cleanup_volumes_all,
        on_toggle = field:docker_cleanup_volumes_all,
        label = "{t('settings_maintenance.include_all_unused_not_just_2')}",
      )

      row(class = env__add) {
        button(class = "btn btn--primary", on_click = docker_cleanup_save, disabled = @busy_docker_cleanup_save, text = "{t('common.save')}")

        button(
          class = tabs__tab,
          if = @docker_cleanup_running,
          not_equals = true,
          on_click = docker_cleanup_run_now,
          disabled = @busy_docker_cleanup_run_now,
          text = "{t('settings_maintenance.run_now')}",
        )

        button(
          class = tabs__tab,
          if = @docker_cleanup_running,
          equals = true,
          text = "{t('settings_maintenance.running')}",
        )

        text("@docker_cleanup_message", class = u-muted)
      }

      hr
      text("{t('common.last_run')}", class = u-label-cap)
      text("@docker_cleanup_last_run_text", class = u-muted)
    }
  }
}
