// Seção `settings` (view = settings) das telas globais; importada por home.component.gv.
component {
  resources {
    link(rel = import, href = "settings/web.component.gv", as = SettingsWebTab)
    link(rel = import, href = "settings/git.component.gv", as = SettingsGitTab)
    link(rel = import, href = "settings/maintenance.component.gv", as = SettingsMaintenanceTab)
    link(rel = import, href = "settings/gitsync.component.gv", as = SettingsGitSyncTab)
    link(rel = import, href = "settings/backups.component.gv", as = SettingsBackupsTab)
    link(rel = import, href = "settings/recover.component.gv", as = SettingsRecoverTab)
    link(rel = import, href = "settings/recoverykey.component.gv", as = SettingsRecoveryKeyTab)
    link(rel = import, href = "settings/updates.component.gv", as = SettingsUpdatesTab)
    link(rel = import, href = "settings/language.component.gv", as = SettingsLanguageTab)
  }

  row(class = page-head) {
    column(class = page-head__titles) {
      text("{t('common.settings')}", class = page-head__title)

      text(
        "{t('settings.daemon_web_server_https_and')}",
        class = page-head__subtitle,
      )
    }
  }

  scroll(class = tabs__scroll, direction = horizontal) {
    tabbar(
      :value = settings_tab,
      active = @settings_tab,
      :items = settings_tabs,
      tab_class = tabs__tab,
      tab_active_class = "tabs__tab tabs__tab--active",
      padding = "9 16",
      size = 14,
      active_bold = false,
    )
  }

  hr

  if @settings_tab == "web" {
    SettingsWebTab
  }

  if @settings_tab == "git" {
    SettingsGitTab
  }

  if @settings_tab == "maintenance" {
    SettingsMaintenanceTab
  }

  if @settings_tab == "gitsync" {
    SettingsGitSyncTab
  }

  if @settings_tab == "backups" {
    SettingsBackupsTab
  }

  if @settings_tab == "recoverykey" {
    SettingsRecoveryKeyTab
  }

  if @settings_tab == "recover" {
    SettingsRecoverTab
  }

  if @settings_tab == "updates" {
    SettingsUpdatesTab
  }

  if @settings_tab == "language" {
    SettingsLanguageTab
  }
}
