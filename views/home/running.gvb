// Seção `running` (view = running) das telas globais; importada por home.gvb.
// Só projetos com serviço rodando e, dentro deles, só os serviços rodando.
component {
  resources {
    component(name = NadaRodando) {
      text(class = u-muted, content = "Nenhum serviço em execução agora.")
    }
  }

  row(class = page-head) {
    column(class = page-head__titles) {
      text(class = page-head__title, content = "Em execução")

      text(
        class = page-head__subtitle,
        content = "Projetos e serviços rodando agora — projetos sem serviço no ar não aparecem.",
      )
    }
  }

  row(class = "page-head__stats page-head__stats--hide-md") {
    StatCard(label = "SERVIÇOS NO AR", value = @running_count)
  }

  scrollable(direction = vertical, class = u-fill-all) {
    column(class = running__projects) {
      each @running as p (fallback = NadaRodando) {
        column(class = grid) {
          row(class = running__head) {
            text(class = card__title, content = "@p.project_name")
            text(class = "u-muted u-fill", content = "@p.count_label")

            button(
              class = "card__action card__action--auto",
              on_click = open_project:@p.project_id,
              disabled = @busy_open_project,
              text = "Abrir projeto  ›",
            )
          }

          each @p.rows as r {
            row(class = grid__row) {
              RunningCard(:for-each = r.cards, var = c, spread = @c)
            }
          }
        }
      }
    }
  }
}
