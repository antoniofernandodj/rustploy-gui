// Aba "Histórico" do Deploy Engine; importada por deploy_engine.gvb.
component {
  resources {
    component(name = SemDeployRecente) {
      text(
        class = empty_state,
        content = "Nenhum deploy concluído nas últimas 24h.",
      )
    }
  }

  // Histórico 24h: a única lista que cresce sem limite — é ela que fica
  // com o espaço restante da tela e com o scroll.
  column(class = section_fill) {
    row(class = section_head) {
      text(
        class = section_title,
        content = "HISTÓRICO 24H (@eng_recent_count)",
      )
    }

    // O cabeçalho só aparece com algum deploy — sem nenhum, só o aviso.
    if @eng_recent is empty {
      column(class = section_body) {
        SemDeployRecente
      }
    } else {
      column(class = section_scroll) {
        tableview(
          :items = eng_recent,
          :sort = eng_recent_sort,
          var = r,
          header_class = "thead th",
          row_class = "trow td tv_row",
          class = scroll_fill,
        ) {
          tablecolumn(label = " ", class = col_icon) {
            text(class = td, content = "@r.icon")
          }

          tablecolumn(key = service, label = "SERVIÇO", class = col_svc) {
            text(class = td_key, content = "@r.service")
          }

          tablecolumn(key = project, label = PROJETO, class = col_proj)

          tablecolumn(key = state_label, label = ESTADO, class = col_state) {
            StateCell(kind = @r.state_kind, label = @r.state_label)
          }

          tablecolumn(
            key = duration,
            sort_key = elapsed_secs,
            label = "DURAÇÃO",
            class = col_dur,
          ) {
            text(class = muted, content = "@r.duration")
          }

          tablecolumn(
            key = start,
            sort_key = start_iso,
            label = "INÍCIO",
            class = col_start,
          ) {
            text(class = muted, content = "@r.start")
          }
        }
      }
    }
  }
}
