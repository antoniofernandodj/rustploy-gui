// Aba "Histórico" do Deploy Engine; importada por deploy_engine.gvb.
component {
  resources {
    component(name = SemDeployRecente) {
      text(
        class = empty-state,
        content = "Nenhum deploy concluído nas últimas 24h.",
      )
    }
  }

  // Histórico 24h: a única lista que cresce sem limite — é ela que fica
  // com o espaço restante da tela e com o scroll.
  column(class = "section section--fill") {
    row(class = section__head) {
      text(
        class = section__title,
        content = "HISTÓRICO 24H (@deploy_engine_recent_count)",
      )
    }

    // O cabeçalho só aparece com algum deploy — sem nenhum, só o aviso.
    if @deploy_engine_recent is empty {
      column(class = section__body) {
        SemDeployRecente
      }
    } else {
      column(class = section__scroll) {
        tableview(
          :items = deploy_engine_recent,
          :sort = deploy_engine_recent_sort,
          var = r,
          header_class = "table__head table__head-cell",
          row_class = "table__row table__cell table__row--divided",
          class = u-fill-all,
        ) {
          tablecolumn(label = " ", class = table__col-icon) {
            text(class = table__cell, content = "@r.icon")
          }

          tablecolumn(key = service, label = "SERVIÇO", class = table__col-svc) {
            text(class = "table__cell table__cell--key", content = "@r.service")
          }

          tablecolumn(key = project, label = PROJETO, class = table__col-proj)

          tablecolumn(key = state_label, label = ESTADO, class = table__col-state) {
            StateCell(kind = @r.state_kind, label = @r.state_label)
          }

          tablecolumn(
            key = duration,
            sort_key = elapsed_secs,
            label = "DURAÇÃO",
            class = table__col-dur,
          ) {
            text(class = u-muted, content = "@r.duration")
          }

          tablecolumn(
            key = start,
            sort_key = start_iso,
            label = "INÍCIO",
            class = table__col-start,
          ) {
            text(class = u-muted, content = "@r.start")
          }
        }
      }
    }
  }
}
