// Aba "Histórico" do Deploy Engine; importada por deploy_engine.gvb.
component {
  resources {
    component(name = SemDeployRecente) {
      text(
        class = empty_state,
        content = "Nenhum deploy concluído nas últimas 24h.",
      )
    }
  }

  // Histórico 24h: a única lista que cresce sem limite — é ela que fica
  // com o espaço restante da tela e com o scroll.
  column(class = section_fill) {
    row(class = section_head) {
      text(
        class = section_title,
        content = "HISTÓRICO 24H (@eng_recent_count)",
      )
    }

    column(class = section_body) {
      row(class = thead, if = @eng_recent, not_empty) {
        text(class = "th col_icon")
        text(class = "th col_svc", content = "SERVIÇO")
        text(class = "th col_proj", content = "PROJETO")
        text(class = "th col_state", content = "ESTADO")
        text(class = "th col_dur", content = "DURAÇÃO")
        text(class = "th col_start", content = "INÍCIO")
      }
    }

    scrollable(direction = vertical, class = section_scroll) {
      column(class = table_body) {
        each @eng_recent as r (fallback = SemDeployRecente) {
          column(class = row_wrap) {
            row(class = trow) {
              text(class = "td col_icon", content = "@r.icon")
              text(class = "td_key col_svc", content = "@r.service")
              text(class = "td col_proj", content = "@r.project")
              StateCell(kind = @r.state_kind, label = @r.state_label)
              text(class = "muted col_dur", content = "@r.duration")
              text(class = "muted col_start", content = "@r.start")
            }

            hr
          }
        }
      }
    }
  }
}
