// Aba "Histórico" do Deploy Engine; importada por deploy_engine.component.gv.
component {
  resources {
    component(name = SemDeployRecente) {
      text(
        "{t('deploy_engine_historico.no_deploy_finished_in_the')}",
        class = empty-state,
      )
    }
  }

  // Histórico 24h: a única lista que cresce sem limite — é ela que fica
  // com o espaço restante da tela e com o scroll.
  column(class = "section section--fill") {
    row(class = section__head) {
      text(
        "{t('deploy_engine_historico.history_24h', deploy_engine_recent_count=deploy_engine_recent_count)}",
        class = section__title,
      )
    }

    // O cabeçalho só aparece com algum deploy — sem nenhum, só o aviso.
    if @deploy_engine_recent is empty {
      column(class = section__body) {
        SemDeployRecente
      }
    } else {
      column(class = section__scroll) {
        tableview(
          :items = deploy_engine_recent,
          :sort = deploy_engine_recent_sort,
          var = r,
          header_class = "table__head table__head-cell",
          row_class = "table__row table__cell table__row--divided",
          class = u-fill-all,
        ) {
          tablecolumn(
            label = " ",
            class = table__col-icon
          ) {
            text(
              "@r.icon",
              class = table__cell
            )
          }

          tablecolumn(
            key = service,
            label = "{t('common.service')}",
            class = table__col-svc
          ) {
            TableLink(
              kind = service,
              id = @r.service_id,
              label = @r.service
            )
          }

          tablecolumn(
            key = project,
            label = "{t('common.project')}",
            class = table__col-proj
          ) {
            TableLink(
              kind = project,
              id = @r.project_id,
              label = @r.project
            )
          }

          tablecolumn(
            key = state_label,
            label = "{t('common.state')}",
            class = table__col-state
          ) {
            StateCell(
              kind = @r.state_kind,
              label = @r.state_label
            )
          }

          tablecolumn(
            key = duration,
            sort_key = elapsed_secs,
            label = "{t('common.duration')}",
            class = table__col-dur,
          ) {
            text("@r.duration", class = u-muted)
          }

          tablecolumn(
            key = start,
            sort_key = start_iso,
            label = "{t('common.start')}",
            class = table__col-start,
          ) {
            text("@r.start", class = u-muted)
          }
        }
      }
    }
  }
}
