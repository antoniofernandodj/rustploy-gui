// Registry — repositórios/tags do registry OCI embutido (Fase 1: só
// push/pull via docker CLI; sem auth ainda).
component {
  resources {
    component(name = SemRepositorios) {
      text(
        if = @registry_repos_count,
        equals = 0,
        class = muted,
        content = """
          Nenhum repositório ainda. Faça `docker push` para o registry embutido.
        """,
      )

      text(
        if = @registry_repos_count,
        not_equals = 0,
        class = muted,
        content = "Nenhum repositório corresponde à busca.",
      )
    }

    component(name = SemTokens) {
      text(
        class = muted,
        content = """
          Nenhum token ainda. Sem token nenhum push/pull é autenticado — crie um
          antes de usar o registry.
        """,
      )
    }
  }

  column(class = panel_fill) {
    row(class = env_head) {
      text(
        class = muted_fill,
        content = """
          Registry @registry_status_label · @registry_repos_count
          repositório(s) · @registry_storage_human
        """,
      )

      button(
        class = btn_danger,
        if = @registry_status_enabled,
        equals = true,
        on_click = registry_gc,
        disabled = @busy_registry_gc,
        text = "Executar GC",
      )
    }

    text(
      if = @registry_msg,
      not_equals = "",
      class = muted,
      content = "@registry_msg",
    )

    column(class = panel_fill, if = @registry_selected_repo, equals = "") {
      tableview(
        :items = registry_repos,
        :sort = registry_repos_sort,
        var = r,
        header_class = "thead th",
        row_class = "trow td tv_row",
        class = scroll_fill,
      ) {
        tablecolumn(key = name, label = "REPOSITÓRIO", class = col_svc) {
          text(class = td_key, content = "@r.name")
        }

        tablecolumn(key = tag_count, label = TAGS, class = col_proj)

        tablecolumn(key = size, label = TAMANHO, class = col_dur) {
          text(class = muted, content = "@r.size")
        }

        tablecolumn(key = created, label = CRIADO, class = col_dur) {
          text(class = muted, content = "@r.created")
        }

        tablecolumn(label = "AÇÃO", class = col_act_2, align = right) {
          row(class = col_act_2) {
            button(
              class = copy_btn,
              on_click = registry_open_repo:@r.name,
              disabled = @busy_registry_open_repo,
              text = "≡",
              tooltip = "Ver tags",
            )

            button(
              class = env_del,
              on_click = registry_rm_repo:@r.name,
              disabled = @busy_registry_rm_repo,
              text = "✕",
              tooltip = Remover,
            )
          }
        }

        if @data_loading == "true" {
          LoadingRow
        } else {
          SemRepositorios
        }
      }

      text(
        class = label_cap,
        content = "TOKENS DE ACESSO (@registry_tokens_count)",
      )

      row(class = env_head) {
        text(
          class = muted_fill,
          content = """
            Basic auth (docker login) — o segredo só aparece uma vez, na
            criação.
          """,
        )

        button(
          class = btn_primary,
          on_click = registry_open_token_window,
          disabled = @busy_registry_open_token_window,
          text = "+ Novo token",
        )
      }

      // Sem `height`: a lista é curta e cresce com o painel. O cabeçalho só
      // aparece com algum token — sem nenhum, só o aviso.
      if @registry_tokens is empty {
        SemTokens
      } else {
        tableview(
          :items = registry_tokens,
          var = tk,
          header_class = "thead th",
          row_class = "trow td tv_row",
          width = fill,
        ) {
          tablecolumn(key = name, label = NOME, class = col_svc) {
            text(class = td_key, content = "@tk.name")
          }

          tablecolumn(key = scope, label = ESCOPO, class = col_proj)

          tablecolumn(key = created, label = CRIADO, class = col_dur) {
            text(class = muted, content = "@tk.created")
          }

          tablecolumn(key = last_used, label = "ÚLTIMO USO", class = col_dur) {
            text(class = muted, content = "@tk.last_used")
          }

          tablecolumn(label = "AÇÃO", class = col_act) {
            button(
              class = env_del,
              on_click = registry_rm_token:@tk.name,
              disabled = @busy_registry_rm_token,
              text = "✕",
              tooltip = Revogar,
            )
          }
        }
      }
    }

    column(
      class = panel_fill,
      if = @registry_selected_repo,
      not_equals = "",
    ) {
      row(class = env_head) {
        text(
          class = muted_fill,
          content = "@registry_selected_repo — @registry_tags_count tag(s)",
        )

        button(
          class = btn_ghost,
          on_click = registry_close_repo,
          disabled = @busy_registry_close_repo,
          text = "← Voltar",
        )
      }

      tableview(
        :items = registry_tags,
        :sort = registry_tags_sort,
        var = t,
        header_class = "thead th",
        row_class = "trow td tv_row",
        class = scroll_fill,
      ) {
        tablecolumn(key = tag, label = TAG, class = col_svc) {
          text(class = td_key, content = "@t.tag")
        }

        tablecolumn(key = digest, label = DIGEST, class = col_proj) {
          text(class = muted, content = "@t.digest")
        }

        tablecolumn(key = size, label = TAMANHO, class = col_dur) {
          text(class = muted, content = "@t.size")
        }

        tablecolumn(key = updated, label = ATUALIZADA, class = col_dur) {
          text(class = muted, content = "@t.updated")
        }

        tablecolumn(label = "AÇÃO", class = col_act) {
          button(
            class = dk_rm,
            on_click = registry_rm_tag:@t.tag,
            disabled = @busy_registry_rm_tag,
            text = Remover,
          )
        }

        if @registry_tags_loading == "true" {
          LoadingRow
        }
      }
    }
  }
}
