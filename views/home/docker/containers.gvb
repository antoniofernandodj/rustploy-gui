// Containers — um por serviço gerido pelo Rustploy (ligação com
// projeto/serviço é direta, já que o container nasce de um Service).
component {
  resources {
    component(name = SemContainersDocker) {
      text(class = muted, content = "Nenhum container.")
    }
  }

  column(class = panel_fill) {
    row(class = env_head) {
      text(
        class = muted_fill,
        content = "@docker_containers_count container(s)",
      )

      button(
        class = btn_danger,
        on_click = docker_prune_containers,
        disabled = @busy_docker_prune_containers,
        text = "Limpar parados",
      )
    }

    text(
      if = @docker_msg,
      not_equals = "",
      class = muted,
      content = "@docker_msg",
    )

    tableview(
      :items = docker_containers,
      :sort = docker_containers_sort,
      var = c,
      header_class = "thead th",
      row_class = "trow td tv_row",
      class = scroll_fill,
    ) {
      tablecolumn(key = name, label = NOME, class = col_svc) {
        text(class = td_key, content = "@c.name")
      }

      tablecolumn(key = image, label = IMAGEM, class = col_img)

      tablecolumn(key = owner, label = DONO, class = col_state) {
        text(class = muted, content = "@c.owner")
      }

      tablecolumn(key = state_label, label = ESTADO, class = col_state) {
        StateCell(kind = @c.state_kind, label = @c.state_label)
      }

      tablecolumn(label = "AÇÃO", class = col_act) {
        button(
          if = @c.can_remove,
          equals = 1,
          class = dk_rm,
          on_click = docker_rm_container:@c.id_full,
          disabled = @busy_docker_rm_container,
          text = Remover,
        )
      }

      // Sem linha nenhuma: o "carregando" do primeiro snapshot, ou o vazio.
      if @data_loading == "true" {
        LoadingRow
      } else {
        SemContainersDocker
      }
    }
  }
}
