// Volumes — Rustploy só usa bind mounts, então volumes nomeados aqui são
// sempre externos ao Rustploy (criados manualmente ou por VOLUME da imagem).
component {
  resources {
    component(name = SemVolumes) {
      text(class = muted, content = "Nenhum volume.")
    }
  }

  column(class = panel_fill) {
    row(class = env_head) {
      text(class = muted_fill, content = "@docker_volumes_count volume(s)")

      // O filtro mora em fmt.docker_volumes — ver images.gvb.
      checkbox(
        :checked = docker_volumes_only_used,
        on_toggle = docker_only_used:docker_volumes_only_used,
        label = "Somente em uso",
      )

      checkbox(
        :checked = docker_prune_all_volumes,
        on_toggle = field:docker_prune_all_volumes,
        label = "-a (limpar tudo, não só anônimos)",
      )

      button(
        class = btn_danger,
        on_click = docker_prune_volumes,
        text = "Limpar sem uso",
      )
    }

    text(
      if = @docker_msg,
      not_equals = "",
      class = muted,
      content = "@docker_msg",
    )

    tableview(
      :items = docker_volumes,
      :sort = docker_volumes_sort,
      var = v,
      header_class = "thead th",
      row_class = "trow td tv_row",
      class = scroll_fill,
    ) {
      tablecolumn(key = name, label = NOME, class = col_svc) {
        text(class = td_key, content = "@v.name")
      }

      tablecolumn(key = driver, label = DRIVER, class = col_proj)

      tablecolumn(
        key = size,
        sort_key = size_bytes,
        label = TAMANHO,
        class = col_dur,
      ) {
        text(class = muted, content = "@v.size")
      }

      tablecolumn(key = in_use_label, label = USO, class = col_state) {
        StateCell(kind = @v.in_use_kind, label = @v.in_use_label)
      }

      tablecolumn(label = "AÇÃO", class = col_act) {
        button(
          if = @v.in_use_label,
          equals = "SEM USO",
          class = dk_rm,
          on_click = docker_rm_volume:@v.name_full,
          text = Remover,
        )
      }

      if @data_loading == "true" {
        LoadingRow
      } else {
        SemVolumes
      }
    }
  }
}
