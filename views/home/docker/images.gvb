// Images — projeto/serviço é melhor esforço (inferido pela tag; imagens
// manuais/de terceiros ficam com "—").
component {
  resources {
    component(name = SemImagens) {
      text(class = muted, content = "Nenhuma imagem.")
    }
  }

  column(class = panel_fill) {
    row(class = env_head) {
      text(class = muted_fill, content = "@docker_images_count imagem(ns)")

      // O filtro mora em fmt.docker_images (a tableview desenha toda linha
      // que recebe): o toggle grava a chave e remonta a lista.
      checkbox(
        :checked = docker_images_only_used,
        on_toggle = docker_only_used:docker_images_only_used,
        label = "Somente em uso",
      )

      checkbox(
        :checked = docker_prune_all_images,
        on_toggle = field:docker_prune_all_images,
        label = "-a (limpar tudo, não só dangling)",
      )

      button(
        class = btn_danger,
        on_click = docker_prune_images,
        text = "Limpar sem uso",
      )
    }

    text(
      if = @docker_msg,
      not_equals = "",
      class = muted,
      content = "@docker_msg",
    )

    tableview(
      :items = docker_images,
      :sort = docker_images_sort,
      var = i,
      header_class = "thead th",
      row_class = "trow td tv_row",
      class = scroll_fill,
    ) {
      tablecolumn(key = tags, label = TAGS, class = col_svc) {
        text(class = td_key, content = "@i.tags")
      }

      tablecolumn(key = owner, label = "PROJETO / SERVIÇO", class = col_proj)

      tablecolumn(
        key = size,
        sort_key = size_bytes,
        label = TAMANHO,
        class = col_dur,
      ) {
        text(class = muted, content = "@i.size")
      }

      tablecolumn(
        key = created,
        sort_key = created_iso,
        label = CRIADA,
        class = col_dur,
      ) {
        text(class = muted, content = "@i.created")
      }

      tablecolumn(key = in_use_label, label = USO, class = col_state) {
        StateCell(kind = @i.in_use_kind, label = @i.in_use_label)
      }

      tablecolumn(label = "AÇÃO", class = col_act) {
        button(
          if = @i.in_use_label,
          equals = "SEM USO",
          class = dk_rm,
          on_click = docker_rm_image:@i.id_full,
          text = Remover,
        )
      }

      if @data_loading == "true" {
        LoadingRow
      } else {
        SemImagens
      }
    }
  }
}
