// Networks — projeto reconhecido pela convenção rp_net_&lt;id curto&gt;.
component {
  resources {
    component(name = SemNetworks) {
      text(class = muted, content = "Nenhuma network.")
    }
  }

  column(class = panel_fill) {
    row(class = env_head) {
      text(
        class = muted_fill,
        content = "@docker_networks_count network(s)",
      )

      // O filtro mora em fmt.docker_networks — ver images.gvb.
      checkbox(
        :checked = docker_networks_only_used,
        on_toggle = docker_only_used:docker_networks_only_used,
        label = "Somente em uso",
      )

      button(
        class = btn_danger,
        on_click = docker_prune_networks,
        disabled = @busy_docker_prune_networks,
        text = "Limpar sem uso",
      )
    }

    text(
      if = @docker_msg,
      not_equals = "",
      class = muted,
      content = "@docker_msg",
    )

    tableview(
      :items = docker_networks,
      :sort = docker_networks_sort,
      var = n,
      header_class = "thead th",
      row_class = "trow td tv_row",
      class = scroll_fill,
    ) {
      tablecolumn(key = name, label = NOME, class = col_svc) {
        text(class = td_key, content = "@n.name")
      }

      tablecolumn(key = project, label = PROJETO, class = col_proj)

      tablecolumn(key = driver, label = DRIVER, class = col_dur) {
        text(class = muted, content = "@n.driver")
      }

      tablecolumn(key = containers, label = CONTAINERS, class = col_dur) {
        text(class = muted, content = "@n.containers")
      }

      tablecolumn(key = in_use_label, label = USO, class = col_state) {
        StateCell(kind = @n.in_use_kind, label = @n.in_use_label)
      }

      tablecolumn(label = "AÇÃO", class = col_act) {
        button(
          if = @n.in_use_label,
          equals = "SEM USO",
          class = dk_rm,
          on_click = docker_rm_network:@n.id_full,
          disabled = @busy_docker_rm_network,
          text = Remover,
        )
      }

      if @data_loading == "true" {
        LoadingRow
      } else {
        SemNetworks
      }
    }
  }
}
