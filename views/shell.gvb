// Casca do app conectado: sidebar, topbar e as views de projeto (Deployments,
// Projects, serviços de um projeto, detalhe de serviço); importa home.gv para
// as telas globais.
component {
  resources {
    // ── Imports ────────────────────────────────────────────────────
    link(rel = import, href = service.gvb, as = ServiceDetail)
    link(rel = import, href = home.gvb, as = HomeViews)
    link(rel = import, href = "shell/deployments.gvb", as = DeploymentsView)
    link(rel = import, href = "shell/projects.gvb", as = ProjectsView)
    link(rel = import, href = "shell/project_services.gvb", as = ProjectServicesView)
    link(rel = import, href = "components/project_card.gvb", as = ProjectCard)
    link(rel = import, href = "components/service_card.gvb", as = ServiceCard)
    link(rel = import, href = "components/stat_card.gvb", as = StatCard)
    link(rel = import, href = "components/state_cell.gvb", as = StateCell)
    link(rel = import, href = "components/badge.gvb", as = rp-badge)
    link(rel = import, href = "components/nav_item.gvb", as = NavItem)
    link(rel = import, href = "components/tab_button.gvb", as = TabButton)
    link(rel = import, href = "components/loading_row.gvb", as = LoadingRow)
    link(rel = import, href = "components/picker_row.gvb", as = PickerRow)
    link(rel = import, href = "components/template_row.gvb", as = TemplateRow)

    style """
      /* A sidebar é uma <drawer> (glacier-ui 0.92+, Onda 2 da reforma — ver
        docs/plano-reforma-gui-glacier-0.102.md): largura/padding/spacing vêm
        das props do `<drawer>` no markup; aqui fica só a cor (o painel carrega
        `drawer-panel` + `sidebar`). */
      .sidebar { background: var(--surface); }
      .menu_btn       { color: var(--border); text-color: var(--text); padding: 9 13; border-radius: 5; }
      .brand_box      { spacing: 2; padding: 0 8 18 8; }
      .brand          { size: 21; bold: true; color: var(--text); }
      .brand_sub      { size: 11; color: var(--faint); }
      .nav_section    { size: 11; bold: true; color: var(--faint); padding: 16 8 6 8; }
      .nav_spacer     { height: fill; }
      .main_col       { width: fill; height: fill; }
      /* Top bar */
      .topbar     { width: fill; padding: 18 28; spacing: 18; align-y: center; }
      .search     { width: fill; padding: 11 14; }
      /* Ações do cabeçalho do projeto (variantes compactas, à direita) */
      .btn_sm_primary { color: var(--green); padding: 7 13; border-radius: 4; size: 12 }
      .btn_sm_ghost   { color: var(--border); padding: 7 12; border-radius: 4; size: 12 }
      .btn_sm_danger  { color: var(--danger); padding: 7 13; border-radius: 4; size: 12 }
      .proj_topbar    { width: fill; align-y: center; }
      .proj_actions   { spacing: 8; align-y: center; }
      .hspacer        { width: fill; }
      /* Grid de cards (projetos / serviços) */
      .grid           { width: fill; spacing: 16; }
      .card_row       { width: fill; spacing: 16; }
      /* Responsivo (glacier-ui 0.9.0+): a sidebar-gaveta FECHA pelo ☰ da topbar
        em janela estreita (o motor anima a largura 264→0), em vez do antigo
        trilho de ícones. Sobra só o aperto da própria topbar. */
      @media (max-width: 900) {
        .topbar { padding: 12 16; spacing: 10; }
      }

      @media (max-width: 560) {
        .topbar { padding: 10 10; spacing: 8; }
        /* Sem largura pra tudo na topbar: some com a busca e o status do daemon
          (baixa prioridade) pra ☰ / Stop All / Disconnect não serem cortados. */
        .search        { hidden: true; }
        .topbar_status { hidden: true; }
      }
    """
  }

  row(class = screen) {
    // ── Sidebar (gaveta) ─────────────────────────────────────────────────
    // `<drawer>` empurra o conteúdo (não cobre); não desenha gatilho — o ☰ mora
    // na topbar e `drawer::toggle:menu` funciona de qualquer lugar. `init()`
    // (connection.luau) semeia `menu = "true"` pra começar aberta.
    drawer(
      :value = menu,
      open = @menu,
      size = 264,
      padding = "28 20",
      spacing = 6,
      panel_class = sidebar,
    ) {
      column(class = brand_box) {
        text(class = brand, content = "Rustploy")
        text(class = brand_sub, content = "PRODUCTION CLUSTER")
      }

      text(class = nav_section, content = "DEPLOYMENT OPS")

      NavItem(
        label = Deployments,
        icon = "▶",
        target = deployments,
        action = nav_deployments,
      )

      NavItem(
        label = "Deploy Engine",
        icon = "⚡",
        target = deploy_engine,
        action = nav_deploy_engine,
      )

      NavItem(
        label = Monitoring,
        icon = "◔",
        target = monitoring,
        action = nav_monitoring,
      )

      NavItem(
        label = Schedules,
        icon = "◫",
        target = schedules,
        action = nav_schedules,
      )

      NavItem(
        label = Ingress,
        icon = "↦",
        target = ingress,
        action = nav_ingress,
      )

      NavItem(label = Docker, icon = "◉", target = docker, action = nav_docker)
      text(class = nav_section, content = "MANAGEMENT")

      NavItem(
        label = "Projects (@projects_count)",
        icon = "◧",
        target = "projects project_services service",
        action = nav_projects,
      )

      column(class = nav_spacer)
      hr

      NavItem(
        label = Settings,
        icon = "⌥",
        target = settings,
        action = nav_settings,
      )

      NavItem(
        label = Support,
        icon = "◊",
        target = support,
        action = nav_support,
      )
    }

    // ── Main column ────────────────────────────────────────────────────
    column(class = main_col) {
      // Top bar
      row(class = topbar) {
        // `app:` tira o prefixo de dono (`Shell::…`) que o motor poria numa
        // ação escrita dentro de um <component> — sem ele a ação não chegaria
        // ao builtin `drawer`. Sai `drawer::toggle:menu`, que o dispatch roteia
        // pro <drawer> (o alias minúsculo é um componente registrado).
        button(
          class = menu_btn,
          text = "☰",
          on_click = app:drawer::toggle:menu,
          tooltip = "Mostrar/ocultar o menu",
        )

        input(
          class = search,
          :value = search,
          on_change = search_changed,
          placeholder = "Search deployments, nodes…",
        )

        text(
          class = "muted topbar_status",
          content = "● daemon v@daemon_version",
        )

        button(class = btn_danger, on_click = stop_all, text = "Stop All")
        button(class = btn_ghost, on_click = disconnect, text = Disconnect)
      }

      hr

      // Content
      if @view == "deployments" {
        DeploymentsView
      } else if @view == "projects" {
        ProjectsView
      } else if @view == "project_services" {
        ProjectServicesView
      } else if @view == "service" {
        // ── Service detail / demais views ────────────────────────────
        // O wizard "Novo serviço" saiu daqui (view=new_service): agora abre
        // numa JANELA à parte (new_service_window.gv), disparada por
        // open_new_service_window.
        ServiceDetail
      } else {
        HomeViews
      }
    }
  }
}
