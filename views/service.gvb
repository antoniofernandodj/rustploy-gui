// Detalhe de um serviço: cabeçalho com ações (deploy, stop, reload) e as abas
// General (fonte), Connection, Domains, Environment, Deployments, Logs e
// Advanced.
component {
  resources {
    component(name = SemVariaveisDoServico) {
      text(class = muted, content = "Nenhuma variável.")
    }

    component(name = SemDominios) {
      text(class = muted, content = "Nenhum domínio configurado.")
    }

    component(name = SemDeploysDoServico) {
      text(class = muted, content = "Nenhum deploy ainda.")
    }

    component(name = SemChecks) {
      text(
        class = muted,
        content = "Nenhum check configurado — deploy segue direto.",
      )
    }

    // Estado vazio da lista de containers (`fallback` do <foreach>).
    component(name = SemContainers) {
      text(class = muted, content = "Nenhum container em execução.")
    }

    style """
      /* Cabeçalho + ações */
      .svc_head      { width: fill; align-y: start; }
      .svc_title_row { width: fill; spacing: 14; align-y: center; }
      /* O nome do serviço é o elemento FLEXÍVEL da linha do título (width: fill): ele
        absorve a folga e quebra dentro da coluna quando aperta. Sem isso, o back-button,
        o nome e o badge são todos `shrink` (largura natural) e, quando a soma passa da
        largura da coluna, o iced NÃO encolhe — transborda para a direita e o nome/badge
        invadem os botões de ação (o "Deploy/▶ por cima do nome"). Deixar o nome `fill`
        garante que a linha nunca ultrapasse os próprios limites. */
      .svc_title     { width: fill; }
      /* Sub-linha de status (badge + timer) logo abaixo do nome. */
      .svc_substatus { spacing: 10; align-y: center; }
      /* Abas com scroll horizontal: a viewport ocupa a largura toda; a fileira interna
        fica na largura natural (shrink) para poder transbordar e rolar. */
      .tabs_scroll   { width: fill; }
      .tabs_main     { width: shrink; spacing: 4; }
      .svc_actions   { spacing: 10; align-y: center; }
      /* .svc_actions_full / .svc_actions_compact e o swap por @media vivem em app.gss
        (junto das outras regras responsivas — cruzar arquivo com o inline daqui
        deixaria a precedência ambígua). */
      .btn_blue      { color: var(--blue); padding: 11 22; border-radius: 5 }
      /* Corpo: conteúdo da aba + painel lateral */
      .svc_body      { width: fill; height: fill; spacing: 20; }
      .svc_main      { width: fill; height: fill; spacing: 16; }
      .svc_aside     { width: 360; height: fill; spacing: 16; }
      .svc_err       { size: 13; color: var(--error); }
      /* Connection (pares chave/valor) */
      .kv_key        { width: fill; size: 13; color: var(--muted); }
      .kv_val        { size: 16; bold: true; color: var(--text); }
      /* Environment / General (editores) — .btn_export/.btn_export_on/.env_editor
        agora vivem em app.gss (compartilhados com shell.gv). */
      .select        { width: fill; padding: 12 14; background: var(--raised); border-radius: 4; border-width: 1; border-color: #30363D; color: var(--text-2); }
      /* Deployments (lista + build log) */
      .col_dep_id    { width: 130; }
      .col_dep_start { width: fill; }
      .dep_image     { size: 11; color: var(--faint); padding: 2 0 0 0; }
      .dep_wrap      { width: fill; height: fill; spacing: 8; }
      .dep_list_scroll { width: fill; height: 240; }
      /* Ações da linha de deployment: 2 botões-ícone (ver build log / remover), com o
        rótulo no tooltip. O padding era 7 15 — dimensionado para "Build log ↗" e
        "Remover" escritos por extenso, que estouravam a coluna em janela estreita. */
      .dep_actions   { spacing: 8; align-y: center; }
      .dep_logs_btn  { color: var(--border); padding: 5 12; border-radius: 3 }
      .dep_del_btn   { color: var(--danger); padding: 5 12; border-radius: 3 }
      .label_cap_fill { width: fill; size: 11; bold: true; color: var(--faint); }
      /* Logs (aba Logs = launcher da janela isolada; painel usado só p/ layout) */
      .log_panel     { width: fill; height: fill; background: var(--surface); border-radius: 6; border-width: 1; border-color: var(--border); padding: 14 16; spacing: 8; }
      .log_body      { width: fill; spacing: 2; }
      .log_line      { width: fill; spacing: 12; }
      .log_time      { width: 76; size: 11; color: var(--faint); }
      .log_text      { width: fill; size: 12; color: #9DA7B3; }
      /* Painel lateral */
      .aside_panel   { width: fill; background: var(--surface); border-radius: 6; border-width: 1; border-color: var(--border); padding: 18; spacing: 8; }
      .aside_panel_fill { width: fill; height: fill; background: var(--surface); border-radius: 6; border-width: 1; border-color: var(--border); padding: 14 16; spacing: 8; }
      /* Responsivo: estreita o painel lateral e aperta o corpo (glacier-ui 0.9.0+). */
      @media (max-width: 900) {
        .svc_aside { width: 240; }
        .svc_body  { spacing: 12; }
      }
      @media (max-width: 560) {
        .svc_aside { width: 170; }
      }
    """
  }

  column(class = content) {
    // ── Header: nome + estado + ações ──────────────────────────────────
    row(class = svc_head) {
      column(class = header_titles) {
        row(class = svc_title_row) {
          button(
            class = btn_ghost,
            on_click = open_project:@svc_project_id,
            text = "‹ @svc_project",
          )

          text(class = "title svc_title", content = "@svc_name")
        }

        // Status + timer numa SUB-LINHA abaixo do nome — nunca na mesma linha do
        // título. Antes o badge ficava inline no título e, quando o nome quebrava
        // em duas linhas, o "Running" era desenhado por cima da 2ª linha: um
        // elemento de texto do iced não corta ao ultrapassar sua caixa `fill`, e o
        // badge (posicionado logo após a caixa estreita) caía sobre o texto vazado.
        // Descê-lo elimina qualquer disputa horizontal com o nome.
        row(class = svc_substatus) {
          rp-badge(color = @svc_status_color, label = @svc_status_label)

          // Live "1s, 2s, 3s…" deploy timer: shown only while a deploy started
          // from this panel (Deploy/Rebuild) is in flight. Ticked once a second
          // by the poll subscription (see `net::poll_stream`'s `sec_tick`), and
          // hidden once the deploy finishes — the outcome (success/failure) and
          // its total elapsed time then show in `svc_action_msg` below instead.
          row(class = badge, if = @svc_deploy_running, equals = true) {
            text(class = state_dot, color = #58A6FF, content = "⏱")

            text(
              class = badge_lbl,
              color = #58A6FF,
              content = "@svc_deploy_elapsed",
            )
          }
        }

        text(
          if = @svc_action_msg,
          not_equals = "",
          class = muted,
          color = @svc_action_color,
          content = "@svc_action_msg",
        )

        // Ações compactas EMPILHADAS abaixo do título (só ≤1240px). Ficam dentro
        // da coluna do título de propósito: quando aperta, a fileira de rótulos à
        // direita some (@media) e header_titles passa a ocupar a largura toda,
        // então os ícones descem para cá — título e ações nunca dividem a mesma
        // linha em janela estreita, e por isso nada sobrepõe o nome.
        row(class = "svc_actions svc_actions_compact") {
          button(
            class = btn_primary,
            on_click = svc_deploy,
            text = "▶",
            tooltip = Deploy,
          )

          button(
            class = btn_blue,
            on_click = svc_reload,
            text = "⟳",
            tooltip = Reload,
          )

          button(
            class = btn_blue,
            on_click = svc_rebuild,
            text = "⚙",
            tooltip = Rebuild,
          )

          button(
            class = btn_danger,
            on_click = svc_stop,
            text = "■",
            tooltip = Stop,
          )
        }
      }

      // Fileira de rótulos por extenso à DIREITA do título — só >1240px, onde há
      // espaço de sobra. Abaixo disso ela some (@media em app.gss) e entram os
      // ícones empilhados acima.
      row(class = "svc_actions svc_actions_full") {
        button(class = btn_primary, on_click = svc_deploy, text = Deploy)
        button(class = btn_blue, on_click = svc_reload, text = Reload)
        button(class = btn_blue, on_click = svc_rebuild, text = Rebuild)
        button(class = btn_danger, on_click = svc_stop, text = Stop)
      }
    }

    // ── Abas ───────────────────────────────────────────────────────────
    // Scroll horizontal: são 8 abas e, em janela estreita, as últimas
    // ("Healthcheck"/"Logs"/"Advanced") saíam da tela sem como alcançá-las.
    // A viewport (`.tabs_scroll`) é `width: fill`; a fileira interna
    // (`.tabs_main`) é `width: shrink` (largura natural), então quando as abas
    // não cabem ela transborda a viewport e a barra de rolagem aparece.
    scroll(class = tabs_scroll, direction = horizontal) {
      row(class = tabs_main) {
        TabButton(
          label = General,
          current = @tab,
          target = general,
          action = tab:general,
        )

        TabButton(
          label = Connection,
          current = @tab,
          target = connection,
          action = tab:connection,
        )

        TabButton(
          label = Environment,
          current = @tab,
          target = environment,
          action = tab:environment,
        )

        TabButton(
          label = Domains,
          current = @tab,
          target = domains,
          action = tab:domains,
        )

        TabButton(
          label = Deployments,
          current = @tab,
          target = deployments,
          action = tab:deployments,
        )

        if @svc_shared == "true" {
          TabButton(
            label = Databases,
            current = @tab,
            target = databases,
            action = tab:databases,
          )
        }

        if @svc_can_migrate == "true" {
          TabButton(
            label = Migrar,
            current = @tab,
            target = migrar,
            action = tab:migrar,
          )
        }

        TabButton(
          label = Healthcheck,
          current = @tab,
          target = healthcheck,
          action = tab:healthcheck,
        )

        TabButton(
          label = Logs,
          current = @tab,
          target = logs,
          action = tab:logs,
        )

        TabButton(
          label = Advanced,
          current = @tab,
          target = advanced,
          action = tab:advanced,
        )
      }
    }

    hr

    // ── Corpo: conteúdo da aba + painel lateral ────────────────────────
    row(class = svc_body) {
      column(class = svc_main) {
        text(
          if = @svc_error,
          not_equals = "",
          class = svc_err,
          content = "@svc_error",
        )

        // General (source / build, editável)
        scrollable(
          if = @tab,
          equals = general,
          direction = vertical,
          class = scroll_fill,
        ) {
          // O scrollable só renderiza o PRIMEIRO filho: os forms ficam numa coluna.
          column(width = fill, spacing = 12) {
            // Enquanto o fetch do detalhe (spec + listas conta/repo/branch do
            // Gitea) não completa, mostramos um loading — os Selects só aparecem
            // depois, já populados, em vez de piscarem vazios.
            column(class = form_panel, if = @svc_loading, equals = true) {
              if @svc_loading == "true" {
                LoadingRow(note = "Carregando dados do serviço…")
              }
            }

            // Renomear: form próprio, FORA do form "general" (form não aninha).
            // O nome é só de exibição para Compose (stack e volumes ficam
            // gravados); em Application o alias de rede acompanha o nome no
            // próximo deploy — o aviso abaixo diz qual dos dois vale.
            form(
              class = form_panel,
              if = @svc_loading,
              not_equals = true,
              name = svc_rename,
              on_submit = save_service_name,
              on_validation_error = svc_rename_apontar,
              spacing = 6,
            ) {
              text(class = label_cap, content = "NOME DO SERVIÇO")

              row(class = env_add) {
                input(
                  class = field_input,
                  form_control = edit_svc_name,
                  rules = required,
                  msg = "informe um nome",
                  placeholder = "Nome do serviço",
                )

                button(type = submit, class = btn_primary, text = Renomear)
              }

              text(
                class = err,
                if = @erro_edit_svc_name,
                not_empty,
                content = "@erro_edit_svc_name",
              )

              text(class = muted, content = "@svc_rename_note")
            }

            form(
              class = form_panel,
              if = @svc_loading,
              not_equals = true,
              name = general,
              on_submit = gen_save,
            ) {
              // Serviços Compose (bancos/brokers) editam o YAML direto; não têm
              // provider Git/Registry.
              if @svc_source_kind == "Compose" {
                text(class = label_cap, content = "DOCKER COMPOSE (YAML)")

                text(
                  class = muted,
                  content = """
                    Edite o compose do serviço. Salvar aplica no próximo deploy.
                  """,
                )

                textarea(
                  class = env_editor,
                  font = mono,
                  :value = svc_compose,
                  placeholder = "services:
  app:
    image: …",
                )

                row(class = env_add) {
                  button(
                    class = btn_primary,
                    on_click = compose_save,
                    text = "Salvar compose",
                  )

                  button(
                    class = btn_ghost,
                    on_click = compose_cancel,
                    text = Cancelar,
                  )

                  text(class = muted, content = "@svc_action_msg")
                }
              }

              // Provider Git/conta-conectada/Zip — apenas para serviços não-Compose.
              if @svc_source_kind != "Compose" {
                text(class = label_cap, content = "PROVIDER")

                row(class = tabs) {
                  TabButton(
                    label = Git,
                    current = @prov_tab,
                    target = git,
                    action = prov:git,
                  )

                  template(if = @gitea_providers, not_empty) {
                    // Vale para qualquer conta conectada em Settings → Git —
                    // Gitea *e* GitHub. O `target`/`action` seguem "gitea" por
                    // ser a chave de estado (prov_tab), não o nome do provedor.
                    TabButton(
                      label = "Gitea/GitHub",
                      current = @prov_tab,
                      target = gitea,
                      action = prov:gitea,
                    )
                  }

                  TabButton(
                    label = Zip,
                    current = @prov_tab,
                    target = zip,
                    action = prov:zip,
                  )
                }

                hr

                // ── Sub-aba Git: form de URL/imagem crua ───────────────
                if @prov_tab == "git" {
                  text(
                    class = label_cap,
                    content = "SOURCE — REPOSITORY URL / IMAGE",
                  )

                  input(
                    class = field_input,
                    form_control = f_repo_url,
                    :value = f_repo_url,
                    on_change = field:f_repo_url,
                    placeholder = "github.com/user/repo  ou  nginx:latest",
                  )

                  text(
                    class = muted,
                    content = """
                      URL de repositório vira Git; caso contrário é imagem de
                      registry.
                    """,
                  )

                  row(class = hc_grid) {
                    column(class = hc_field) {
                      text(class = label_cap, content = "BRANCH")

                      input(
                        class = field_input,
                        form_control = f_branch,
                        :value = f_branch,
                        on_change = field:f_branch,
                        placeholder = main,
                      )
                    }

                    column(class = hc_field) {
                      text(class = label_cap, content = "PORT")

                      input(
                        class = field_input,
                        form_control = f_gen_port,
                        :value = f_gen_port,
                        on_change = field:f_gen_port,
                        placeholder = 80,
                      )

                      text(
                        if = @erro_f_gen_port,
                        not_equals = "",
                        class = err,
                        content = "@erro_f_gen_port",
                      )
                    }
                  }

                  row(class = hc_grid) {
                    column(class = hc_field) {
                      text(class = label_cap, content = "USERNAME")

                      input(
                        class = field_input,
                        form_control = f_username,
                        :value = f_username,
                        on_change = field:f_username,
                        placeholder = "(opcional)",
                      )
                    }

                    column(class = hc_field) {
                      text(class = label_cap, content = "CREDENTIALS (secret)")

                      input(
                        class = field_input,
                        form_control = f_credentials,
                        :value = f_credentials,
                        on_change = field:f_credentials,
                        placeholder = "(opcional)",
                      )

                      text(
                        class = muted,
                        content = """
                          Nome de um secret do projeto (aba Secrets), puro — sem
                          <secret:>. Usado para clonar repositório Git privado
                          via HTTPS; não tem efeito com URL SSH.
                        """,
                      )
                    }
                  }

                  text(class = label_cap, content = "BUILD PATH (root)")

                  input(
                    class = field_input,
                    form_control = f_build_path,
                    :value = f_build_path,
                    on_change = field:f_build_path,
                    placeholder = .,
                  )

                  text(
                    class = label_cap,
                    content = "WATCH PATHS (separados por vírgula)",
                  )

                  input(
                    class = field_input,
                    form_control = f_watch_paths,
                    :value = f_watch_paths,
                    on_change = field:f_watch_paths,
                    placeholder = "src, Cargo.toml",
                  )

                  toggle(
                    :checked = f_submodules,
                    on_toggle = field:f_submodules,
                    label = " Enable submodules",
                  )

                  text(class = label_cap, content = "BUILD ENGINE: DOCKERFILE")

                  row(class = hc_grid) {
                    column(class = hc_field) {
                      text(class = label_cap, content = "DOCKERFILE")

                      input(
                        class = field_input,
                        form_control = f_dockerfile,
                        :value = f_dockerfile,
                        on_change = field:f_dockerfile,
                        placeholder = Dockerfile,
                      )
                    }

                    column(class = hc_field) {
                      text(class = label_cap, content = "CONTEXT PATH")

                      input(
                        class = field_input,
                        form_control = f_context_path,
                        :value = f_context_path,
                        on_change = field:f_context_path,
                        placeholder = .,
                      )
                    }
                  }

                  text(class = label_cap, content = "BUILD STAGE (opcional)")

                  input(
                    class = field_input,
                    form_control = f_build_stage,
                    :value = f_build_stage,
                    on_change = field:f_build_stage,
                    placeholder = "(multi-stage target)",
                  )

                  row(class = env_add) {
                    button(
                      class = btn_primary,
                      on_click = gen_save,
                      text = Save,
                    )

                    text(class = muted, content = "@svc_action_msg")
                  }
                }

                // ── Sub-aba Zip: upload de arquivo local com Dockerfile na raiz ─
                if @prov_tab == "zip" {
                  text(class = label_cap, content = "ZIP DOCKERFILE")

                  input(
                    class = field_input,
                    form_control = f_archive_path,
                    :value = f_archive_path,
                    on_change = field:f_archive_path,
                    placeholder = "/caminho/para/app.zip",
                  )

                  text(
                    class = muted,
                    content = """
                      O zip deve conter um Dockerfile na raiz. Depois do envio,
                      o deploy normal usa os arquivos descompactados pelo
                      daemon.
                    """,
                  )

                  row(class = hc_grid) {
                    column(class = hc_field) {
                      text(class = label_cap, content = "PORT")

                      input(
                        class = field_input,
                        form_control = f_gen_port,
                        :value = f_gen_port,
                        on_change = field:f_gen_port,
                        placeholder = 80,
                      )
                    }

                    column(class = hc_field) {
                      text(class = label_cap, content = "STATUS")
                      text(class = muted, content = "@svc_action_msg")
                    }
                  }

                  row(class = env_add) {
                    button(
                      class = btn_primary,
                      on_click = archive_upload,
                      text = "Enviar zip",
                    )

                    button(
                      class = btn_secondary,
                      on_click = gen_save,
                      text = "Salvar porta",
                    )
                  }
                }

                // ── Sub-aba conta conectada (Gitea/GitHub): picker conta/repo/branch ─
                if @prov_tab == "gitea" {
                  text(
                    class = muted,
                    content = """
                      Selecione a conta conectada, o repositório e a branch a
                      implantar.
                    """,
                  )

                  row(class = busy_row, if = @gitea_msg, not_equals = "") {
                    spinner(class = busy_spin, if = @gitea_busy)
                    text(class = muted, content = "@gitea_msg")
                  }

                  text(class = label_cap, content = "CONTA CONECTADA")

                  select(
                    class = select,
                    :options = gitea_providers,
                    :value = gitea_provider_id,
                    on_change = gitea_provider_pick,
                    placeholder = "selecione a conta",
                    labelField = display,
                    valueField = id,
                  )

                  text(
                    class = muted,
                    content = "Conecte contas em Settings → Git.",
                  )

                  text(class = label_cap, content = "REPOSITÓRIO")

                  select(
                    class = select,
                    :options = gitea_repos,
                    :value = gitea_repo,
                    on_change = gitea_repo_pick,
                    placeholder = "selecione o repositório",
                    labelField = full_name,
                    valueField = full_name,
                  )

                  text(class = label_cap, content = "BRANCH")

                  select(
                    class = select,
                    :options = gitea_branches,
                    :value = f_branch,
                    on_change = field:f_branch,
                    placeholder = "selecione a branch",
                    labelField = name,
                    valueField = name,
                  )

                  text(class = label_cap, content = "SELEÇÃO ATUAL")

                  row(class = kv_row) {
                    text(class = kv_key, content = "Repo (clone URL)")
                    text(class = kv_val_fill, content = "@f_repo_url")
                  }

                  text(class = label_cap, content = "BUILD")

                  row(class = hc_grid) {
                    column(class = hc_field) {
                      text(class = label_cap, content = "BUILD PATH (root)")

                      input(
                        class = field_input,
                        form_control = f_build_path,
                        :value = f_build_path,
                        on_change = field:f_build_path,
                        placeholder = .,
                      )
                    }

                    column(class = hc_field) {
                      text(class = label_cap, content = "PORT")

                      input(
                        class = field_input,
                        form_control = f_gen_port,
                        :value = f_gen_port,
                        on_change = field:f_gen_port,
                        placeholder = 80,
                      )

                      text(
                        if = @erro_f_gen_port,
                        not_equals = "",
                        class = err,
                        content = "@erro_f_gen_port",
                      )
                    }
                  }

                  row(class = hc_grid) {
                    column(class = hc_field) {
                      text(class = label_cap, content = "DOCKERFILE")

                      input(
                        class = field_input,
                        form_control = f_dockerfile,
                        :value = f_dockerfile,
                        on_change = field:f_dockerfile,
                        placeholder = Dockerfile,
                      )
                    }

                    column(class = hc_field) {
                      text(class = label_cap, content = "CONTEXT PATH")

                      input(
                        class = field_input,
                        form_control = f_context_path,
                        :value = f_context_path,
                        on_change = field:f_context_path,
                        placeholder = .,
                      )
                    }
                  }

                  text(
                    class = label_cap,
                    content = "WATCH PATHS (separados por vírgula)",
                  )

                  input(
                    class = field_input,
                    form_control = f_watch_paths,
                    :value = f_watch_paths,
                    on_change = field:f_watch_paths,
                    placeholder = "src, Cargo.toml",
                  )

                  toggle(
                    :checked = f_submodules,
                    on_toggle = field:f_submodules,
                    label = "  Enable submodules",
                  )

                  row(class = env_add) {
                    button(
                      class = btn_primary,
                      on_click = gen_save,
                      text = Save,
                    )

                    text(class = muted, content = "@svc_action_msg")
                  }
                }
              }
            }
          }
        }

        // Connection (valores copiáveis)
        column(if = @tab, equals = connection, class = kv_list) {
          row(class = kv_row) {
            text(class = kv_key, content = "Container port")
            text(class = kv_val_fill, content = "@svc_port")
            text(content = " ")

            button(
              class = copy_btn,
              on_click = clipboard:svc_port,
              text = Copiar,
            )
          }

          row(class = kv_row) {
            text(class = kv_key, content = "Host port")
            text(class = kv_val_fill, content = "@svc_host_port")
            text(content = " ")

            button(
              class = copy_btn,
              on_click = clipboard:svc_host_port,
              text = Copiar,
            )
          }

          row(class = kv_row) {
            text(class = kv_key, content = "Domain")
            text(class = kv_val_fill, content = "@svc_domain")
            text(content = " ")

            button(
              class = copy_btn,
              on_click = clipboard:svc_domain,
              text = Copiar,
            )
          }

          row(class = kv_row) {
            text(class = kv_key, content = "TLS")
            text(class = kv_val_fill, content = "@svc_tls")
          }

          row(class = kv_row) {
            text(class = kv_key, content = "External URL")
            text(class = kv_val_fill, content = "@svc_external_url_short")
            text(content = " ")

            button(
              class = copy_btn,
              on_click = clipboard:svc_external_url,
              text = Copiar,
            )
          }

          row(class = kv_row) {
            text(class = kv_key, content = "Internal URL")
            text(class = kv_val_fill, content = "@svc_internal_url_short")
            text(content = " ")

            button(
              class = copy_btn,
              on_click = clipboard:svc_internal_url,
              text = Copiar,
            )
          }

          row(class = kv_row, if = @svc_can_share, equals = true) {
            text(class = kv_key, content = "Compartilhado")
            text(class = kv_val_fill, content = "@svc_shared")

            if @svc_shared == "false" {
              button(
                class = copy_btn,
                on_click = shared_enable,
                text = Compartilhar,
              )
            }

            if @svc_shared == "true" {
              button(
                class = copy_btn,
                on_click = shared_disable,
                text = Desligar,
              )
            }
          }

          row(class = kv_row, if = @svc_db_kind, not_equals = "—") {
            text(class = kv_key, content = "Tipo")
            text(class = kv_val_fill, content = "@svc_db_kind")
          }

          // Containers reais em execução para este serviço (id + nome + estado).
          hr

          text(
            class = label_cap,
            content = "CONTAINERS (@svc_containers_count)",
          )

          each @svc_containers as c (fallback = SemContainers) {
            row(class = kv_row) {
              rp-badge(color = @c.state_color, label = @c.state)
              text(class = kv_val_fill, content = "  ")
              text(class = kv_val_fill, content = "@c.name")
              text(class = kv_val_fill, content = "  ")
              text(class = muted, content = "@c.id_short")
            }
          }
        }

        // Environment
        column(if = @tab, equals = environment, class = env_wrap) {
          row(class = env_head) {
            text(class = muted_fill, content = "@svc_env_count variável(eis)")
            button(class = btn_export, on_click = env_export, text = Exportar)
            text(content = " ")

            if @env_text_open == "true" {
              button(
                class = btn_export_on,
                on_click = env_text_toggle,
                text = Fechar,
              )
            } else {
              button(class = tab, on_click = env_text_toggle, text = .env)
            }
          }

          form(name = env_add, on_submit = env_add, width = fill, spacing = 8) {
            row(class = env_add) {
              input(
                class = env_in_key,
                form_control = env_new_key,
                placeholder = KEY,
              )
            }

            row(class = env_add) {
              input(
                class = env_in_val,
                form_control = env_new_val,
                placeholder = value,
              )
            }

            row(class = env_add) {
              button(class = btn_primary, on_click = env_add, text = Adicionar)
            }
          }

          text(
            class = muted_fill,
            content = """
              Para um valor sensível, use um secret do projeto: escreva
              <secret:NOME> ou secret:NOME como valor aqui ou no editor .env —
              as duas formas valem. O secret é criado na aba Secrets do projeto,
              só é decifrado no deploy, e na lista aparece com 🔒.
            """,
          )

          text(
            if = @erro_env_new_key,
            not_equals = "",
            class = err,
            content = "@erro_env_new_key",
          )

          // scrollable só renderiza o PRIMEIRO filho (glacier-ui
          // widget.rs: NodeType::Scrollable usa node.children.first()) —
          // por isso a lista e o editor .env vivem dentro de UM único
          // <column>, nunca como irmãos diretos do <scrollable>.
          scrollable(direction = vertical, class = env_list_scroll) {
            column(class = kv_list) {
              template(
                :for-each = svc_env,
                var = e,
                on_reorder = env_reorder,
                reorder_key = key,
                foreach_fallback = SemVariaveisDoServico,
              ) {
                // Comentários (# ...) do .env: arrastáveis como as vars (ao
                // soltar, reancoram na var seguinte da nova ordem), mas sem
                // delete — removem-se editando o .env. A classe da linha muda
                // para `kv_row_drag` no item agarrado ({e.__dragging} vem do
                // glacier-ui durante o arrasto).
                if @e.__dragging == "true" {
                  row(class = kv_row_drag, if = @e.kind, equals = comment) {
                    text(
                      class = "env_drag_handle env_dragging",
                      dragHandle = true,
                      content = "⋮ ",
                    )

                    text(class = muted, content = "@e.value")
                  }

                  row(class = kv_row_drag, else) {
                    text(
                      class = "env_drag_handle env_dragging",
                      dragHandle = true,
                      content = "⋮ ",
                    )

                    button(
                      class = env_del,
                      on_click = env_del:@e.key,
                      text = "✕",
                    )

                    text(class = env_sep)
                    text(class = env_key, content = "@e.key_display")
                    text(class = kv_val_fill, content = "@e.value")
                  }
                } else {
                  row(class = kv_row, if = @e.kind, equals = comment) {
                    text(
                      class = env_drag_handle,
                      dragHandle = true,
                      content = "⋮ ",
                    )

                    text(class = muted, content = "@e.value")
                  }

                  row(class = kv_row, else) {
                    text(
                      class = env_drag_handle,
                      dragHandle = true,
                      content = "⋮ ",
                    )

                    button(
                      class = env_del,
                      on_click = env_del:@e.key,
                      text = "✕",
                    )

                    text(class = env_sep)
                    text(class = env_key, content = "@e.key_display")
                    text(class = kv_val_fill, content = "@e.value")
                  }
                }
              }

              // Editor .env: vários filhos condicionais → `<template>` (o atributo
              // if= só esconderia o Text, deixando TextArea/botões sempre
              // visíveis). Vive dentro do mesmo <column> da lista (e não
              // como irmão dela) para que os botões Salvar/Cancelar nunca
              // fiquem fora da área visível da janela (antes eram irmãos
              // fixos após um scrollable height:fill, e podiam ser
              // cortados/escondidos em janelas mais baixas).
              if @env_text_open == "true" {
                text(
                  class = muted,
                  content = "Cole/edite no formato KEY=VALUE (# comentário).",
                )

                textarea(
                  class = env_editor,
                  font = mono,
                  :value = svc_env_text,
                  placeholder = "KEY=VALUE   (# comentário)",
                )

                row(class = env_add) {
                  button(
                    class = btn_primary,
                    on_click = env_import,
                    text = Salvar,
                  )

                  button(
                    class = btn_ghost,
                    on_click = env_text_cancel,
                    text = Cancelar,
                  )
                }
              }
            }
          }
        }

        // Domains (editável): lista de rotas HTTP (domínio → porta de container,
        // TLS por rota), mais o form de adição e a porta TCP crua do host.
        column(if = @tab, equals = domains, class = form_panel) {
          text(class = label_cap, content = "DOMÍNIOS (@svc_domains_count)")

          text(
            class = muted,
            content = """
              Cada domínio pode apontar para uma porta de container diferente.
            """,
          )

          scrollable(direction = vertical, class = env_list_scroll) {
            column(class = kv_list) {
              each @svc_domains as d (fallback = SemDominios) {
                row(class = kv_row) {
                  button(
                    class = env_del,
                    on_click = dom_del:@d.domain,
                    text = "✕",
                  )

                  text(class = env_sep)
                  text(class = env_key, content = "@d.domain")
                  text(class = kv_val_fill, content = "→ @d.port")
                  text(class = muted, content = "@d.tls_label")
                }
              }
            }
          }

          text(class = label_cap, content = "ADICIONAR DOMÍNIO")

          input(
            class = field_input,
            form_control = f_domain,
            :value = f_domain,
            on_change = field:f_domain,
            placeholder = app.exemplo.com,
          )

          text(
            if = @erro_f_domain,
            not_equals = "",
            class = err,
            content = "@erro_f_domain",
          )

          text(class = label_cap, content = "PORTA DO CONTAINER (opcional)")

          input(
            class = field_input,
            form_control = f_port,
            :value = f_port,
            on_change = field:f_port,
            placeholder = "(padrão do serviço)",
          )

          text(
            if = @erro_f_port,
            not_equals = "",
            class = err,
            content = "@erro_f_port",
          )

          toggle(
            :checked = f_tls,
            on_toggle = field:f_tls,
            label = "  HTTPS / TLS",
          )

          row(class = env_add) {
            button(
              class = btn_primary,
              on_click = dom_add,
              text = "Adicionar domínio",
            )

            text(class = muted, content = "@svc_action_msg")
          }

          text(
            class = label_cap,
            content = "PORTA TCP DO HOST (passthrough, opcional)",
          )

          input(
            class = field_input,
            form_control = f_host_port,
            :value = f_host_port,
            on_change = field:f_host_port,
            placeholder = "(padrão do serviço)",
          )

          text(
            if = @erro_f_host_port,
            not_equals = "",
            class = err,
            content = "@erro_f_host_port",
          )

          row(class = env_add) {
            button(
              class = btn_ghost,
              on_click = dom_hostport_save,
              text = "Salvar porta",
            )

            button(
              class = btn_ghost,
              on_click = dom_hostport_auto,
              text = Automática,
            )
          }

          text(
            class = muted,
            content = """
              "Automática" aloca uma porta livre e a libera no firewall do host.
            """,
          )
        }

        // Migrar este banco para um servidor compartilhado
        scrollable(
          if = @tab,
          equals = migrar,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(width = fill, spacing = 8, class = form_panel) {
            text(class = label_cap, content = "MIGRAR PARA BANCO COMPARTILHADO")

            text(
              class = muted,
              content = """
                Crie antes o database de destino no servidor compartilhado (aba
                Databases de lá, marcando "Não mexer em env var"). Mesmo motor e
                mesmo projeto. A migração é com parada: os serviços que usam
                este banco ficam fora do ar durante a cópia.
              """,
            )

            text(
              class = label_cap,
              content = "DATABASE DE ORIGEM (dentro deste banco)",
            )

            input(
              class = field_input,
              form_control = f_mig_db,
              :value = f_mig_db,
              on_change = field:f_mig_db,
              placeholder = "nome do database",
            )

            text(class = label_cap, content = "DESTINO")

            select(
              class = select,
              :options = mig_dests,
              :value = f_mig_dest,
              on_change = field:f_mig_dest,
              placeholder = "database de destino...",
              labelField = name,
              valueField = id,
            )

            text(class = label_cap, content = "ENV VAR A TROCAR")

            input(
              class = field_input,
              form_control = f_mig_env,
              :value = f_mig_env,
              on_change = field:f_mig_env,
              placeholder = "padrão DATABASE_URL / MONGODB_URI",
            )

            row(class = env_add) {
              button(class = btn_primary, on_click = mig_start, text = Migrar)

              button(
                class = btn_ghost,
                on_click = mig_refresh,
                text = Atualizar,
              )
            }

            if @mig_has == "true" {
              text(class = label_cap, content = "ANDAMENTO — @mig_status")

              column(class = kv_list) {
                row(class = kv_row, :for-each = mig_steps, var = s) {
                  text(class = env_key, content = "@s.icon")
                  text(class = kv_val_fill, content = "@s.name")
                  text(class = muted, content = "@s.detail")
                }
              }

              if @mig_can_finish == "true" {
                text(
                  class = muted,
                  content = """
                    Migração concluída — o banco antigo foi mantido (parado)
                    para rollback.
                  """,
                )

                row(class = env_add) {
                  button(
                    class = btn_ghost,
                    on_click = mig_rollback,
                    text = Reverter,
                  )

                  button(
                    class = btn_ghost,
                    on_click = mig_discard,
                    text = "Descartar banco antigo",
                  )
                }
              }
            }
          }
        }

        // Databases (servidor de banco compartilhado entre projetos)
        scrollable(
          if = @tab,
          equals = databases,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(width = fill, spacing = 8, class = form_panel) {
            text(class = label_cap, content = "DATABASES (@svc_mdbs_count)")

            text(
              class = muted,
              content = """
                Cada database tem usuário próprio, sem acesso aos demais. O
                projeto consumidor recebe a connection string numa env var.
              """,
            )

            scrollable(direction = vertical, class = env_list_scroll) {
              column(class = kv_list) {
                row(class = kv_row, :for-each = svc_mdbs, var = d) {
                  button(
                    class = env_del,
                    on_click = mdb_delete:@d.id,
                    text = "✕",
                  )

                  text(class = env_sep)
                  button(class = tab, on_click = mdb_show:@d.id, text = @d.name)
                  text(class = kv_val_fill, content = "→ @d.project")
                  text(class = muted, content = "@d.env_var")
                }
              }
            }

            row(class = kv_row, if = @mdb_url, not_equals = "") {
              text(class = kv_key, content = "URL")
              text(class = kv_val_fill, content = "@mdb_url_short")

              button(
                class = copy_btn,
                on_click = clipboard:mdb_url,
                text = Copiar,
              )
            }

            text(class = label_cap, content = "NOVO DATABASE")

            input(
              class = field_input,
              form_control = f_mdb_name,
              :value = f_mdb_name,
              on_change = field:f_mdb_name,
              placeholder = "nome (a-z, 0-9, _)",
            )

            select(
              class = select,
              :options = svc_mdb_projects,
              :value = f_mdb_project,
              on_change = field:f_mdb_project,
              placeholder = "projeto consumidor...",
              labelField = name,
              valueField = id,
            )

            input(
              class = field_input,
              form_control = f_mdb_env,
              :value = f_mdb_env,
              on_change = field:f_mdb_env,
              placeholder = "env var (padrão DATABASE_URL / MONGODB_URI)",
            )

            input(
              class = field_input,
              form_control = f_mdb_limit,
              :value = f_mdb_limit,
              on_change = field:f_mdb_limit,
              placeholder = "limite de conexões (opcional; não vale no Mongo)",
            )

            input(
              class = field_input,
              form_control = f_mdb_timeout,
              :value = f_mdb_timeout,
              on_change = field:f_mdb_timeout,
              placeholder = "timeout de query em ms (opcional; só Postgres)",
            )

            toggle(
              :checked = f_mdb_overwrite,
              on_toggle = field:f_mdb_overwrite,
              label = "  Sobrescrever a env var se o projeto já a tiver",
            )

            toggle(
              :checked = f_mdb_skip_env,
              on_toggle = field:f_mdb_skip_env,
              label = "  Não mexer em env var (vou migrar os dados antes)",
            )

            row(class = env_add) {
              button(
                class = btn_primary,
                on_click = mdb_create,
                text = "Criar database",
              )

              text(class = muted, content = "@svc_action_msg")
            }
          }
        }

        // Deployments
        column(if = @tab, equals = deployments, class = dep_wrap) {
          // Webhook de deploy: servido pelo MESMO listener da API (base
          // derivada de [api] domain/port). Compose não tem webhook.
          column(
            if = @svc_webhook_supported,
            equals = true,
            class = form_panel,
          ) {
            text(class = label_cap, content = "WEBHOOK DE DEPLOY")

            // URL e botões em LINHAS separadas: a URL é longa (~100 chars) e,
            // com width fill, empurraria os botões para fora do painel. Exibida
            // TRUNCADA (svc_webhook_url_short) — inteira, ela estoura o card em
            // janelas estreitas; o valor completo vai no tooltip e no clipboard.
            column(if = @svc_webhook_url, not_equals = "", class = wh_block) {
              text(
                class = wh_url,
                tooltip = @svc_webhook_url,
                content = "@svc_webhook_url_short",
              )

              row(class = wh_actions) {
                button(
                  class = copy_btn,
                  on_click = clipboard:svc_webhook_url,
                  text = Copiar,
                )

                button(
                  class = dep_del_btn,
                  on_click = regen_webhook,
                  text = Regenerar,
                )
              }
            }

            text(
              if = @svc_webhook_url,
              equals = "",
              class = muted,
              content = """
                O token nasce no primeiro deploy deste serviço — rode um deploy
                para a URL aparecer.
              """,
            )

            text(
              class = muted,
              content = """
                Um POST nesta URL dispara um deploy. O corpo é ignorado: o token
                na própria URL é a autenticação. Regenerar invalida a URL
                anterior.
              """,
            )
          }

          text(class = muted, content = "@svc_deployments_count deployments")

          scrollable(direction = vertical, class = dep_list_scroll) {
            column(class = table_body) {
              each @svc_deployments as d (fallback = SemDeploysDoServico) {
                column(class = row_wrap) {
                  row(class = trow) {
                    text(class = "td_key col_dep_id", content = "@d.id")
                    StateCell(kind = @d.state_kind, label = @d.state_label)
                    text(class = "td col_dur", content = "@d.duration")
                    text(class = "muted col_dep_start", content = "@d.start")

                    // Ícone + tooltip (eram "Build log ↗" e "Remover" por
                    // extenso): os rótulos quebravam em duas linhas e estouravam a
                    // coluna quando a janela estreitava. Mesmo padrão das linhas de
                    // job e de repo do Registry (home.gv).
                    row(class = dep_actions) {
                      button(
                        class = dep_logs_btn,
                        on_click = dep_logs:@d.id_full,
                        text = "≡",
                        tooltip = "Ver build log",
                      )

                      button(
                        if = @d.can_delete,
                        equals = 1,
                        class = dep_del_btn,
                        on_click = delete_deployment:@d.id_full,
                        text = "✕",
                        tooltip = "Remover deployment",
                      )
                    }
                  }

                  text(class = dep_image, content = "@d.image")
                  hr
                }
              }
            }
          }

          // Build log abre em JANELA isolada (dep_logs → open_window), não inline:
          // render de milhares de linhas por reavaliação travava a principal.
        }

        // Healthcheck (editável)
        form(
          if = @tab,
          equals = healthcheck,
          class = form_panel,
          name = healthcheck,
          on_submit = hc_save,
        ) {
          text(class = label_cap, content = "KIND")

          row(class = tabs) {
            TabButton(
              label = None,
              current = @f_hc_kind,
              target = none,
              action = hckind:none,
            )

            TabButton(
              label = Tcp,
              current = @f_hc_kind,
              target = tcp,
              action = hckind:tcp,
            )

            TabButton(
              label = Http,
              current = @f_hc_kind,
              target = http,
              action = hckind:http,
            )

            TabButton(
              label = Docker,
              current = @f_hc_kind,
              target = docker,
              action = hckind:docker,
            )
          }

          if @f_hc_kind == "http" {
            text(class = label_cap, content = "HTTP PATH")

            input(
              class = field_input,
              form_control = f_hc_path,
              :value = f_hc_path,
              on_change = field:f_hc_path,
              placeholder = "/health",
            )

            text(class = label_cap, content = "EXPECTED STATUS")

            spinbox(
              field_class = spin_field,
              form_control = f_hc_status,
              :value = f_hc_status,
              min = 100,
              max = 599,
              width = 90,
              placeholder = 200,
            )

            // Era um <input> de texto livre com esta linha de erro abaixo:
            //
            // <text if="{erro_f_hc_status}" not_equals="" class="err">
            //   {erro_f_hc_status}
            // </text>
            //
            // `erro_f_hc_status` nunca foi escrita por ninguém (nem Luau nem
            // Rust) — a validação que ela anunciava não existia, e o handler
            // engolia lixo em silêncio (`tonumber(...) or 200`). Quem valida
            // agora é o próprio widget, que satura em min/max. Mesma história
            // nos outros cinco campos numéricos desta tela.
          }

          // Os quatro números do health check. A faixa de cada um sai do que
          // o daemon aceita: intervalo/timeout/start em segundos (1h de teto é
          // folgado para qualquer check razoável), retries na faixa do Docker.
          // As linhas `erro_f_hc_*` que ficavam sob cada campo saíram junto —
          // ver o comentário do EXPECTED STATUS acima.
          row(class = hc_grid) {
            column(class = hc_field) {
              text(class = label_cap, content = "INTERVAL (s)")

              spinbox(
                field_class = spin_field,
                form_control = f_hc_interval,
                :value = f_hc_interval,
                min = 1,
                max = 3600,
                width = 90,
              )
            }

            column(class = hc_field) {
              text(class = label_cap, content = "TIMEOUT (s)")

              spinbox(
                field_class = spin_field,
                form_control = f_hc_timeout,
                :value = f_hc_timeout,
                min = 1,
                max = 3600,
                width = 90,
              )
            }
          }

          row(class = hc_grid) {
            column(class = hc_field) {
              text(class = label_cap, content = "RETRIES")

              spinbox(
                field_class = spin_field,
                form_control = f_hc_retries,
                :value = f_hc_retries,
                min = 1,
                max = 10,
                width = 90,
              )
            }

            column(class = hc_field) {
              text(class = label_cap, content = "START PERIOD (s)")

              spinbox(
                field_class = spin_field,
                form_control = f_hc_start,
                :value = f_hc_start,
                min = 0,
                max = 3600,
                width = 90,
              )
            }
          }

          row(class = env_add) {
            button(class = btn_primary, on_click = hc_save, text = Save)
            text(class = muted, content = "@svc_action_msg")
          }
        }

        // Logs de runtime: vivem numa JANELA isolada (motor leve), não inline —
        // renderizar o stream aqui reavaliaria a árvore inteira da janela principal
        // por linha e a travava. A aba é só o launcher.
        column(if = @tab, equals = logs, class = log_panel) {
          text(
            class = muted,
            content = """
              Os logs de runtime abrem numa janela própria, isolada do restante
              do app (para não travar a interface sob alto volume de logs).
            """,
          )

          row(class = env_add) {
            button(
              class = btn_primary,
              on_click = open_logs_window,
              text = "Abrir logs em janela",
            )
          }
        }

        scrollable(
          direction = vertical,
          class = scroll_fill,
          if = @tab,
          equals = advanced,
        ) {
          column(class = svc_main) {
            form(name = advanced, on_submit = adv_save, class = form_panel) {
              text(class = label_cap, content = "REPLICAS")

              // O teto de 20 é arbitrário mas deliberado: um número acima disso
              // num single-node é quase sempre engano de digitação, e o widget não
              // deixa mais chegar lá. O piso de 1 substitui o `if r < 1 then r = 1`
              // do adv_save, que fica como rede redundante.
              spinbox(
                field_class = spin_field,
                form_control = f_replicas,
                :value = f_replicas,
                min = 1,
                max = 20,
                width = 90,
                placeholder = 1,
              )

              text(class = label_cap, content = "RUN COMMAND")

              input(
                class = field_input,
                form_control = f_run_command,
                :value = f_run_command,
                on_change = field:f_run_command,
                placeholder = "(padrão da imagem)",
              )

              text(class = muted, content = "Run args atuais: @svc_run_args")

              row(class = env_add) {
                button(class = btn_primary, on_click = adv_save, text = "Save")
                text(class = muted, content = "@svc_action_msg")
              }
            }

            // Fila de pré-deploy (editável, efeito imediato — como Domains, não
            // passa pelo Save do form acima): cada item roda em ORDEM antes do
            // deploy; a primeira falha para a fila inteira.
            column(class = form_panel) {
              text(
                class = label_cap,
                content = "FILA DE PRÉ-DEPLOY (@pre_deploy_checks_count)",
              )

              text(
                class = muted,
                content = """
                  Roda esses Jobs em ORDEM antes do deploy (manual ou webhook),
                  um de cada vez. Se o exit code de algum for diferente de 0, a
                  fila para e o deploy não acontece — os checks seguintes não
                  rodam. Arraste pelo ⋮ para reordenar. Cadastre jobs em
                  Schedules.
                """,
              )

              scrollable(direction = vertical, class = env_list_scroll) {
                column(class = kv_list, height = shrink) {
                  template(
                    :for-each = pre_deploy_checks,
                    foreach_fallback = SemChecks,
                    var = c,
                    on_reorder = pdc_reorder,
                    reorder_key = id,
                  ) {
                    if @c.__dragging == "true" {
                      row(class = kv_row_drag) {
                        text(
                          class = "env_drag_handle env_dragging",
                          dragHandle = true,
                          content = "⋮",
                        )

                        button(
                          class = env_del,
                          on_click = pdc_del:@c.id,
                          text = "✕",
                        )

                        text(class = env_sep)
                        text(class = env_key, content = "@c.index.")
                        text(class = kv_val_fill, content = "@c.name")
                      }
                    } else {
                      row(class = kv_row) {
                        text(
                          class = env_drag_handle,
                          dragHandle = true,
                          content = "⋮",
                        )

                        button(
                          class = env_del,
                          on_click = pdc_del:@c.id,
                          text = "✕",
                        )

                        text(class = env_sep)
                        text(class = env_key, content = "@c.index.")
                        text(class = kv_val_fill, content = "@c.name")
                      }
                    }
                  }
                }
              }

              text(class = label_cap, content = "ADICIONAR À FILA")

              select(
                class = select,
                :options = pre_deploy_available_jobs,
                :value = f_pdc_add_job_id,
                on_change = field:f_pdc_add_job_id,
                placeholder = "escolher job...",
                labelField = name,
                valueField = id,
              )

              row(class = env_add) {
                button(
                  class = btn_primary,
                  on_click = pdc_add,
                  text = "Adicionar à fila",
                )
              }
            }
          }
        }
      }

      // Painel lateral: status. O log ao vivo saiu daqui (era um for-each sempre
      // renderizado que a reavaliação processava a cada tick) — agora é janela.
      column(class = svc_aside) {
        column(class = aside_panel) {
          text(class = label_cap, content = "STATUS")
          rp-badge(color = @svc_status_color, label = @svc_status_label)
          text(class = label_cap, content = "UPTIME")
          text(class = kv_val, content = "@daemon_uptime")
          text(class = label_cap, content = "SERVICES")
          text(class = kv_val, content = "@services_label")
        }

        column(class = aside_panel_fill) {
          text(class = label_cap, content = "LOGS")

          text(
            class = muted,
            content = "Runtime e build logs abrem em janelas próprias (isoladas).",
          )

          row(class = env_add) {
            button(
              class = tab,
              on_click = open_logs_window,
              text = "Logs de runtime",
            )
          }
        }
      }
    }
  }
}
