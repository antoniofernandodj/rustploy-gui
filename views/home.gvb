// Telas globais da sidebar, cada uma numa seção por valor de view: Monitoring,
// Ingress, Deploy Engine, Docker (e Registry), Settings, Schedules e Suporte.
component {
  resources {
    // Vazio das listas Docker/Monitoring e dos repositórios do registry.
    component(name = SemMetricas) {
      text(
        class = muted,
        content = """
          Nenhuma métrica ainda — aguardando o primeiro container em execução.
        """,
      )
    }

    component(name = SemContainersDocker) {
      text(class = muted, content = "Nenhum container.")
    }

    component(name = SemImagens) {
      text(class = muted, content = "Nenhuma imagem.")
    }

    component(name = SemVolumes) {
      text(class = muted, content = "Nenhum volume.")
    }

    component(name = SemNetworks) {
      text(class = muted, content = "Nenhuma network.")
    }

    // `registry_repos` chega FILTRADO pela busca; o count é da lista crua.
    // Por isso o fallback distingue "registry vazio" de "busca sem resultado".
    component(name = SemRepositorios) {
      text(
        if = @registry_repos_count,
        equals = 0,
        class = muted,
        content = """
          Nenhum repositório ainda. Faça `docker push` para o registry embutido.
        """,
      )

      text(
        if = @registry_repos_count,
        not_equals = 0,
        class = muted,
        content = "Nenhum repositório corresponde à busca.",
      )
    }

    // Estados vazios das listas: o `fallback` do <foreach> (e o
    // `foreach_fallback` do <template>) desenha um destes no lugar da lista.
    component(name = SemPortasDeHost) {
      text(
        class = muted,
        content = "Nenhum serviço com porta de host configurada.",
      )
    }

    component(name = FilaVazia) {
      text(class = empty_state, content = "Nenhum deploy na fila.")
    }

    component(name = SemDeployAtivo) {
      text(class = empty_state, content = "Nenhum deploy em andamento.")
    }

    component(name = SemDeployRecente) {
      text(
        class = empty_state,
        content = "Nenhum deploy concluído nas últimas 24h.",
      )
    }

    component(name = SemTokens) {
      text(
        class = muted,
        content = """
          Nenhum token ainda. Sem token nenhum push/pull é autenticado — crie um
          antes de usar o registry.
        """,
      )
    }

    component(name = SemContasGit) {
      text(class = muted, content = "Nenhuma conta Git conectada ainda.")
    }

    component(name = SemJobs) {
      text(class = muted, content = "Nenhum job cadastrado ainda.")
    }

    style """
      .col_icon       { width: 28; }
      .content_center { width: fill; height: fill; align-x: center; align-y: center; }
      /* Botão "Remover" compacto por-linha nas sub-abas Docker. */
      .dk_rm    { color: var(--danger); padding: 5 12; border-radius: 3; }
      /* align-x só afeta como um container de linha/coluna posiciona seus FILHOS —
        não alinha o texto de um elemento de texto dentro da própria caixa (isso é
        text-align). Como a classe é reaproveitada tanto no texto do cabeçalho
        quanto no container dos botões, sem text-align o rótulo "AÇÃO" ficava
        colado à esquerda enquanto os botões (align-x: end) ficavam colados à
        direita — desalinhados entre si mesmo depois de não sobreporem mais. */
      .col_act  { width: 120; align-x: end; text-align: end; }
      /* Linha de repo do Registry: 2 ícones (ver tags/remover) + tooltip — largura
        bem menor que antes, quando ambos eram texto por extenso. */
      .col_act_2 { width: 90; align-x: end; text-align: end; spacing: 8; }
      /* Linha de job em Schedules: 4 controles (rodar/logs/pausar-ativar/remover).
        Viraram ícone + tooltip (eram texto: "Rodar agora"/"Ver logs"/"Pausar") —
        uma linha de 360px pensada pra rótulos por extenso empurrava o botão de
        remover pra fora da largura visível da janela (sem scroll horizontal);
        4 ícones cabem em bem menos espaço. */
      .col_act_4 { width: 170; align-x: end; text-align: end; spacing: 8; }
      /* Mesma linha de job acima, +1 controle (editar). */
      .col_act_5 { width: 210; align-x: end; text-align: end; spacing: 8; }
    """
  }

  column(class = content) {
    // ── Monitoring ─────────────────────────────────────────────────────
    // Bloco com múltiplos filhos condicionais: precisa de `<template>`, não do
    // atributo if= (que condicionaria só um elemento).
    if @view == "monitoring" {
      row(class = header_row) {
        column(class = header_titles) {
          text(class = title, content = "Monitoring")

          text(
            class = subtitle,
            content = "Host and per-container resource usage.",
          )
        }
      }

      row(class = "stats_row stats_hide_md") {
        StatCard(label = CPU, value = @sys_cpu)
        StatCard(label = MEMORY, value = @sys_mem, accent = 1)
        StatCard(label = DISK, value = @sys_disk)
        StatCard(label = LOAD, value = @sys_load)
      }

      column(class = panel_fill) {
        row(class = thead) {
          text(class = "th col_svc", content = "CONTAINER")
          text(class = "th col_proj", content = "PROJETO")
          text(class = "th col_dur", content = "CPU")
          text(class = "th col_dur", content = "MEM")
          text(class = "th col_dur", content = "RX")
          text(class = "th col_start", content = "TX")
        }

        if @data_loading == "true" {
          LoadingRow
        }

        scrollable(
          if = @data_loading,
          not_equals = true,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(class = table_body) {
            each @monitoring as m (fallback = SemMetricas) {
              column(class = row_wrap) {
                row(class = trow) {
                  text(class = "td_key col_svc", content = "@m.name")
                  text(class = "td col_proj", content = "@m.project")
                  text(class = "td col_dur", content = "@m.cpu")
                  text(class = "td col_dur", content = "@m.mem")
                  text(class = "muted col_dur", content = "@m.rx")
                  text(class = "muted col_start", content = "@m.tx")
                }

                hr
              }
            }
          }
        }
      }
    }

    // ── Ingress ────────────────────────────────────────────────────────
    if @view == "ingress" {
      row(class = header_row) {
        column(class = header_titles) {
          text(class = title, content = "Ingress")

          text(
            class = subtitle,
            content = "Active routes in the reverse proxy.",
          )
        }

        row(class = stats_row) {
          StatCard(label = ROUTES, value = @ingress_count)
          StatCard(label = "PORTAS DE HOST", value = @host_ports_count)
        }
      }

      column(class = panel_fill) {
        row(class = thead) {
          text(class = "th col_svc", content = "DOMÍNIO")
          text(class = "th col_proj", content = "SERVIÇO")
          text(class = "th col_dur", content = "UPSTREAM")
          text(class = "th col_start", content = "TLS")
        }

        if @data_loading == "true" {
          LoadingRow
        }

        scrollable(
          if = @data_loading,
          not_equals = true,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(class = table_body) {
            template(:for-each = ingress, var = i) {
              column(class = row_wrap) {
                row(class = trow) {
                  text(class = "td_key col_svc", content = "@i.domain")
                  text(class = "td col_proj", content = "@i.service")
                  text(class = "td col_dur", content = "@i.upstream")
                  text(class = "muted col_start", content = "@i.tls")
                }

                hr
              }
            }
          }
        }

        // Portas TCP de host: exposição direta de porta (fora do proxy HTTP
        // por domínio acima) — um serviço pode ter as duas, só uma, ou nenhuma.
        text(
          class = label_cap,
          content = "PORTAS TCP DE HOST (@host_ports_count)",
        )

        row(class = thead) {
          text(class = "th col_svc", content = "SERVIÇO")
          text(class = "th col_proj", content = "PROJETO")
          text(class = "th col_dur", content = "PORTA HOST")
          text(class = "th col_start", content = "PORTA CONTAINER")
        }

        column(class = table_body) {
          template(
            :for-each = host_ports,
            var = hp,
            foreach_fallback = SemPortasDeHost,
          ) {
            column(class = row_wrap) {
              row(class = trow) {
                text(class = "td_key col_svc", content = "@hp.service")
                text(class = "td col_proj", content = "@hp.project")
                text(class = "td col_dur", content = "@hp.host_port")
                text(class = "muted col_start", content = "@hp.container_port")
              }

              hr
            }
          }
        }
      }
    }

    // ── Deploy Engine ──────────────────────────────────────────────────
    // KPIs + deploys em andamento + histórico das últimas 24h. Tudo vem do
    // Command::DeployEngineStatus (ver eng_* em app/net.rs); sem backend novo.
    if @view == "deploy_engine" {
      row(class = header_row) {
        column(class = header_titles) {
          text(class = title, content = "Deploy Engine")

          text(
            class = subtitle,
            content = "Pipeline de deploy: em andamento e histórico recente.",
          )
        }

        // 5 cards + valor largo (UPTIME) ao lado do título: deixa de caber
        // bem antes dos breakpoints gerais — some mais cedo (xl).
        row(class = "stats_row stats_hide_xl") {
          StatCard(label = ATIVOS, value = @eng_active_count, accent = 1)
          StatCard(label = "SUCESSO 24H", value = @eng_success_24h)
          StatCard(label = "FALHAS 24H", value = @eng_failed_24h)
          StatCard(label = "TOTAL 24H", value = @eng_total_24h)
          StatCard(label = UPTIME, value = @eng_uptime)
        }
      }

      // Na fila: fila GLOBAL de deploys (um por vez). O primeiro é o próximo a
      // rodar. Arraste pela alça (⋮) para reordenar; ↑ fura fila; ✕ cancela.
      // Pausar/retomar interrompe o worker de puxar o próximo (o que já está
      // rodando segue). Tudo em handlers/deploy_queue.luau.
      //
      // As três seções desta tela são irmãs e de tamanhos diferentes: fila e
      // "executando agora" crescem com o conteúdo (uma fila vazia não tem por
      // que ocupar um terço da janela) e só o histórico recebe o espaço que
      // sobra, porque é a única lista que cresce sem limite.
      column(class = section) {
        row(class = section_head) {
          text(class = section_title, content = "NA FILA (@eng_queued_count)")

          button(
            if = @eng_paused,
            equals = true,
            class = copy_btn,
            on_click = queue_toggle_pause,
            text = "Retomar fila",
          )

          button(
            if = @eng_paused,
            not_equals = true,
            class = copy_btn,
            on_click = queue_toggle_pause,
            text = "Pausar fila",
          )
        }

        column(class = section_body) {
          text(
            if = @eng_paused,
            equals = true,
            class = banner_warn,
            content = "Fila pausada — deploys esperam até você retomar.",
          )

          column(class = table_body) {
            template(
              :for-each = eng_queued,
              foreach_fallback = FilaVazia,
              var = q,
              on_reorder = queue_reorder,
              reorder_key = deployment_id,
            ) {
              row(class = trow) {
                text(class = env_drag_handle, dragHandle = true, content = "⋮")
                text(class = "td_key col_svc", content = "@q.pos. @q.service")
                text(class = "td col_start", content = "@q.project")

                button(
                  class = copy_btn,
                  on_click = queue_promote:@q.deployment_id,
                  text = "↑ topo",
                )

                button(
                  class = env_del,
                  on_click = queue_cancel:@q.deployment_id,
                  text = "✕",
                )
              }

              hr
            }
          }
        }
      }

      // Executando agora: no máximo um deploy por vez (a fila é serial), então
      // esta seção também encolhe para o conteúdo em vez de reservar meia
      // tela para uma linha.
      column(class = section) {
        row(class = section_head) {
          text(
            class = section_title,
            content = "EXECUTANDO AGORA (@eng_active_count)",
          )
        }

        column(class = section_body) {
          row(class = thead, if = @eng_active, not_empty) {
            text(class = "th col_svc", content = "SERVIÇO")
            text(class = "th col_proj", content = "PROJETO")
            text(class = "th col_state", content = "ESTADO")
            text(class = "th col_dur", content = "PROGRESSO")
            text(class = "th col_dur", content = "TOTAL")
            text(class = "th col_start", content = "FASE")
          }

          if @data_loading == "true" {
            LoadingRow
          }

          column(if = @data_loading, not_equals = true, class = table_body) {
            each @eng_active as a (fallback = SemDeployAtivo) {
              column(class = row_wrap) {
                row(class = trow) {
                  text(class = "td_key col_svc", content = "@a.service")
                  text(class = "td col_proj", content = "@a.project")
                  StateCell(kind = @a.state_kind, label = @a.state_label)

                  progressbar(
                    class = col_dur,
                    :value = @a.pct_key,
                    min = 0,
                    max = 100,
                    showValue = true,
                  )

                  text(class = "muted col_dur", content = "@a.total")
                  text(class = "muted col_start", content = "@a.phase")
                }

                hr
              }
            }
          }
        }
      }

      // Histórico 24h: a única lista que cresce sem limite — é ela que fica
      // com o espaço restante da tela e com o scroll.
      column(class = section_fill) {
        row(class = section_head) {
          text(
            class = section_title,
            content = "HISTÓRICO 24H (@eng_recent_count)",
          )
        }

        column(class = section_body) {
          row(class = thead, if = @eng_recent, not_empty) {
            text(class = "th col_icon")
            text(class = "th col_svc", content = "SERVIÇO")
            text(class = "th col_proj", content = "PROJETO")
            text(class = "th col_state", content = "ESTADO")
            text(class = "th col_dur", content = "DURAÇÃO")
            text(class = "th col_start", content = "INÍCIO")
          }
        }

        scrollable(direction = vertical, class = section_scroll) {
          column(class = table_body) {
            each @eng_recent as r (fallback = SemDeployRecente) {
              column(class = row_wrap) {
                row(class = trow) {
                  text(class = "td col_icon", content = "@r.icon")
                  text(class = "td_key col_svc", content = "@r.service")
                  text(class = "td col_proj", content = "@r.project")
                  StateCell(kind = @r.state_kind, label = @r.state_label)
                  text(class = "muted col_dur", content = "@r.duration")
                  text(class = "muted col_start", content = "@r.start")
                }

                hr
              }
            }
          }
        }
      }
    }

    // ── Docker ─────────────────────────────────────────────────────────
    // Sub-abas Containers / Images / Volumes / Networks. As três últimas
    // listam TODO o host Docker (não só recursos geridos pelo Rustploy — ver
    // `docker_inventory` no daemon), com indicação de uso e botão de limpar
    // as que estão sem uso.
    if @view == "docker" {
      row(class = header_row) {
        column(class = header_titles) {
          text(class = title, content = "Docker")

          text(
            class = subtitle,
            content = "Containers, imagens, volumes e networks do host.",
          )
        }

        row(class = "stats_row stats_hide_md") {
          StatCard(label = CONTAINERS, value = @docker_containers_count)
          StatCard(label = IMAGENS, value = @docker_images_count)
          StatCard(label = VOLUMES, value = @docker_volumes_count)
          StatCard(label = NETWORKS, value = @docker_networks_count, accent = 1)
        }
      }

      row(class = tabs) {
        TabButton(
          label = Containers,
          current = @docker_tab,
          target = containers,
          action = docker_tab:containers,
        )

        TabButton(
          label = Images,
          current = @docker_tab,
          target = images,
          action = docker_tab:images,
        )

        TabButton(
          label = Volumes,
          current = @docker_tab,
          target = volumes,
          action = docker_tab:volumes,
        )

        TabButton(
          label = Networks,
          current = @docker_tab,
          target = networks,
          action = docker_tab:networks,
        )

        TabButton(
          label = Registry,
          current = @docker_tab,
          target = registry,
          action = docker_tab:registry,
        )
      }

      hr

      // Containers — um por serviço gerido pelo Rustploy (ligação com
      // projeto/serviço é direta, já que o container nasce de um Service).
      // Containers — todos do host (rodando + parados). Remover é oferecido só
      // nos PARADOS (o Docker recusa `rm` de um rodando sem force).
      column(class = panel_fill, if = @docker_tab, equals = containers) {
        row(class = env_head) {
          text(
            class = muted_fill,
            content = "@docker_containers_count container(s)",
          )

          button(
            class = btn_danger,
            on_click = docker_prune_containers,
            text = "Limpar parados",
          )
        }

        text(
          if = @docker_msg,
          not_equals = "",
          class = muted,
          content = "@docker_msg",
        )

        row(class = thead) {
          text(class = "th col_svc", content = "NOME")
          text(class = "th col_img", content = "IMAGEM")
          text(class = "th col_state", content = "DONO")
          text(class = "th col_dur", content = "ESTADO")
          text(class = "th col_act", content = "AÇÃO")
        }

        if @data_loading == "true" {
          LoadingRow
        }

        scrollable(
          if = @data_loading,
          not_equals = true,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(class = table_body) {
            each @docker_containers as c (fallback = SemContainersDocker) {
              column(class = row_wrap) {
                row(class = trow) {
                  text(class = "td_key col_svc", content = "@c.name")
                  text(class = "td col_img", content = "@c.image")
                  text(class = "muted col_state", content = "@c.owner")
                  StateCell(kind = @c.state_kind, label = @c.state_label)

                  row(class = col_act) {
                    button(
                      if = @c.can_remove,
                      equals = 1,
                      class = dk_rm,
                      on_click = docker_rm_container:@c.id_full,
                      text = Remover,
                    )
                  }
                }

                hr
              }
            }
          }
        }
      }

      // Images — projeto/serviço é melhor esforço (inferido pela tag; imagens
      // manuais/de terceiros ficam com "—").
      column(class = panel_fill, if = @docker_tab, equals = images) {
        row(class = env_head) {
          text(class = muted_fill, content = "@docker_images_count imagem(ns)")

          checkbox(
            :checked = docker_images_only_used,
            on_toggle = field:docker_images_only_used,
            label = "Somente em uso",
          )

          checkbox(
            :checked = docker_prune_all_images,
            on_toggle = field:docker_prune_all_images,
            label = "-a (limpar tudo, não só dangling)",
          )

          button(
            class = btn_danger,
            on_click = docker_prune_images,
            text = "Limpar sem uso",
          )
        }

        text(
          if = @docker_msg,
          not_equals = "",
          class = muted,
          content = "@docker_msg",
        )

        row(class = thead) {
          text(class = "th col_svc", content = "TAGS")
          text(class = "th col_proj", content = "PROJETO / SERVIÇO")
          text(class = "th col_dur", content = "TAMANHO")
          text(class = "th col_dur", content = "CRIADA")
          text(class = "th col_state", content = "USO")
          text(class = "th col_act", content = "AÇÃO")
        }

        if @data_loading == "true" {
          LoadingRow
        }

        scrollable(
          if = @data_loading,
          not_equals = true,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(class = table_body) {
            // Sub-aba já vem ordenada por tag (docker_images_json); o checkbox
            // "Somente em uso" só esconde as linhas SEM USO, sem round-trip.
            if @docker_images_only_used == "true" {
              each @docker_images as i (fallback = SemImagens) {
                column(
                  class = row_wrap,
                  if = @i.in_use_label,
                  equals = "EM USO",
                ) {
                  row(class = trow) {
                    text(class = "td_key col_svc", content = "@i.tags")
                    text(class = "td col_proj", content = "@i.owner")
                    text(class = "muted col_dur", content = "@i.size")
                    text(class = "muted col_dur", content = "@i.created")
                    StateCell(kind = @i.in_use_kind, label = @i.in_use_label)

                    row(class = col_act) {
                      button(
                        if = @i.in_use_label,
                        equals = "SEM USO",
                        class = dk_rm,
                        on_click = docker_rm_image:@i.id_full,
                        text = Remover,
                      )
                    }
                  }

                  hr
                }
              }
            } else {
              each @docker_images as i (fallback = SemImagens) {
                column(class = row_wrap) {
                  row(class = trow) {
                    text(class = "td_key col_svc", content = "@i.tags")
                    text(class = "td col_proj", content = "@i.owner")
                    text(class = "muted col_dur", content = "@i.size")
                    text(class = "muted col_dur", content = "@i.created")
                    StateCell(kind = @i.in_use_kind, label = @i.in_use_label)

                    row(class = col_act) {
                      button(
                        if = @i.in_use_label,
                        equals = "SEM USO",
                        class = dk_rm,
                        on_click = docker_rm_image:@i.id_full,
                        text = Remover,
                      )
                    }
                  }

                  hr
                }
              }
            }
          }
        }
      }

      // Volumes — Rustploy só usa bind mounts, então volumes nomeados aqui são
      // sempre externos ao Rustploy (criados manualmente ou por VOLUME da imagem).
      column(class = panel_fill, if = @docker_tab, equals = volumes) {
        row(class = env_head) {
          text(class = muted_fill, content = "@docker_volumes_count volume(s)")

          checkbox(
            :checked = docker_volumes_only_used,
            on_toggle = field:docker_volumes_only_used,
            label = "Somente em uso",
          )

          checkbox(
            :checked = docker_prune_all_volumes,
            on_toggle = field:docker_prune_all_volumes,
            label = "-a (limpar tudo, não só anônimos)",
          )

          button(
            class = btn_danger,
            on_click = docker_prune_volumes,
            text = "Limpar sem uso",
          )
        }

        text(
          if = @docker_msg,
          not_equals = "",
          class = muted,
          content = "@docker_msg",
        )

        row(class = thead) {
          text(class = "th col_svc", content = "NOME")
          text(class = "th col_proj", content = "DRIVER")
          text(class = "th col_dur", content = "TAMANHO")
          text(class = "th col_state", content = "USO")
          text(class = "th col_act", content = "AÇÃO")
        }

        if @data_loading == "true" {
          LoadingRow
        }

        scrollable(
          if = @data_loading,
          not_equals = true,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(class = table_body) {
            if @docker_volumes_only_used == "true" {
              template(
                :for-each = docker_volumes,
                var = v,
                foreach_fallback = SemVolumes,
              ) {
                column(
                  class = row_wrap,
                  if = @v.in_use_label,
                  equals = "EM USO",
                ) {
                  row(class = trow) {
                    text(class = "td_key col_svc", content = "@v.name")
                    text(class = "td col_proj", content = "@v.driver")
                    text(class = "muted col_dur", content = "@v.size")
                    StateCell(kind = @v.in_use_kind, label = @v.in_use_label)
                    row(class = col_act)
                  }

                  hr
                }
              }
            } else {
              each @docker_volumes as v (fallback = SemVolumes) {
                column(class = row_wrap) {
                  row(class = trow) {
                    text(class = "td_key col_svc", content = "@v.name")
                    text(class = "td col_proj", content = "@v.driver")
                    text(class = "muted col_dur", content = "@v.size")
                    StateCell(kind = @v.in_use_kind, label = @v.in_use_label)

                    row(class = col_act) {
                      button(
                        if = @v.in_use_label,
                        equals = "SEM USO",
                        class = dk_rm,
                        on_click = docker_rm_volume:@v.name_full,
                        text = Remover,
                      )
                    }
                  }

                  hr
                }
              }
            }
          }
        }
      }

      // Networks — projeto reconhecido pela convenção rp_net_&lt;id curto&gt;.
      column(class = panel_fill, if = @docker_tab, equals = networks) {
        row(class = env_head) {
          text(
            class = muted_fill,
            content = "@docker_networks_count network(s)",
          )

          checkbox(
            :checked = docker_networks_only_used,
            on_toggle = field:docker_networks_only_used,
            label = "Somente em uso",
          )

          button(
            class = btn_danger,
            on_click = docker_prune_networks,
            text = "Limpar sem uso",
          )
        }

        text(
          if = @docker_msg,
          not_equals = "",
          class = muted,
          content = "@docker_msg",
        )

        row(class = thead) {
          text(class = "th col_svc", content = "NOME")
          text(class = "th col_proj", content = "PROJETO")
          text(class = "th col_dur", content = "DRIVER")
          text(class = "th col_dur", content = "CONTAINERS")
          text(class = "th col_state", content = "USO")
          text(class = "th col_act", content = "AÇÃO")
        }

        if @data_loading == "true" {
          LoadingRow
        }

        scrollable(
          if = @data_loading,
          not_equals = true,
          direction = vertical,
          class = scroll_fill,
        ) {
          column(class = table_body) {
            if @docker_networks_only_used == "true" {
              template(
                :for-each = docker_networks,
                var = n,
                foreach_fallback = SemNetworks,
              ) {
                column(
                  class = row_wrap,
                  if = @n.in_use_label,
                  equals = "EM USO",
                ) {
                  row(class = trow) {
                    text(class = "td_key col_svc", content = "@n.name")
                    text(class = "td col_proj", content = "@n.project")
                    text(class = "muted col_dur", content = "@n.driver")
                    text(class = "muted col_dur", content = "@n.containers")
                    StateCell(kind = @n.in_use_kind, label = @n.in_use_label)

                    row(class = col_act) {
                      button(
                        if = @n.in_use_label,
                        equals = "SEM USO",
                        class = dk_rm,
                        on_click = docker_rm_network:@n.id_full,
                        text = Remover,
                      )
                    }
                  }

                  hr
                }
              }
            } else {
              template(
                :for-each = docker_networks,
                var = n,
                foreach_fallback = SemNetworks,
              ) {
                column(class = row_wrap) {
                  row(class = trow) {
                    text(class = "td_key col_svc", content = "@n.name")
                    text(class = "td col_proj", content = "@n.project")
                    text(class = "muted col_dur", content = "@n.driver")
                    text(class = "muted col_dur", content = "@n.containers")
                    StateCell(kind = @n.in_use_kind, label = @n.in_use_label)

                    row(class = col_act) {
                      button(
                        if = @n.in_use_label,
                        equals = "SEM USO",
                        class = dk_rm,
                        on_click = docker_rm_network:@n.id_full,
                        text = Remover,
                      )
                    }
                  }

                  hr
                }
              }
            }
          }
        }
      }

      // Registry — repositórios/tags do registry OCI embutido (Fase 1: só
      // push/pull via docker CLI; sem auth ainda). Leitura + delete
      // (metadados) + GC (libera do disco blobs/manifests órfãos). Tags de um
      // repositório são buscadas sob demanda ao clicar "Ver tags" — não
      // vêm no snapshot periódico, diferente das outras sub-abas Docker.
      column(class = panel_fill, if = @docker_tab, equals = registry) {
        row(class = env_head) {
          text(
            class = muted_fill,
            content = """
              Registry @registry_status_label · @registry_repos_count
              repositório(s) · @registry_storage_human
            """,
          )

          button(
            class = btn_danger,
            if = @registry_status_enabled,
            equals = true,
            on_click = registry_gc,
            text = "Executar GC",
          )
        }

        text(
          if = @registry_msg,
          not_equals = "",
          class = muted,
          content = "@registry_msg",
        )

        column(class = panel_fill, if = @registry_selected_repo, equals = "") {
          row(class = thead) {
            text(class = "th col_svc", content = "REPOSITÓRIO")
            text(class = "th col_proj", content = "TAGS")
            text(class = "th col_dur", content = "TAMANHO")
            text(class = "th col_dur", content = "CRIADO")
            text(class = "th col_act_2", content = "AÇÃO")
          }

          if @data_loading == "true" {
            LoadingRow
          }

          // Fica com `registry_repos_count` (não vira `empty` em
          // `registry_repos` como os outros pares lista/count deste plano de
          // convergência): `registry_repos` é FILTRADO pela busca
          // (fmt.registry_repos(snap.registry_repos, term) em stream.luau),
          // enquanto o count é da lista crua. Trocar faria essa mensagem
          // ("Faça docker push...") aparecer quando a busca só não achou
          // nada, não quando o registry está genuinamente vazio.
          scrollable(
            if = @data_loading,
            not_equals = true,
            direction = vertical,
            class = scroll_fill,
          ) {
            column(class = table_body) {
              each @registry_repos as r (fallback = SemRepositorios) {
                column(class = row_wrap) {
                  row(class = trow) {
                    text(class = "td_key col_svc", content = "@r.name")
                    text(class = "td col_proj", content = "@r.tag_count")
                    text(class = "muted col_dur", content = "@r.size")
                    text(class = "muted col_dur", content = "@r.created")

                    row(class = col_act_2) {
                      button(
                        class = copy_btn,
                        on_click = registry_open_repo:@r.name,
                        text = "≡",
                        tooltip = "Ver tags",
                      )

                      button(
                        class = env_del,
                        on_click = registry_rm_repo:@r.name,
                        text = "✕",
                        tooltip = Remover,
                      )
                    }
                  }

                  hr
                }
              }
            }
          }

          text(
            class = label_cap,
            content = "TOKENS DE ACESSO (@registry_tokens_count)",
          )

          row(class = env_head) {
            text(
              class = muted_fill,
              content = """
                Basic auth (docker login) — o segredo só aparece uma vez, na
                criação.
              """,
            )

            button(
              class = btn_primary,
              on_click = registry_open_token_window,
              text = "+ Novo token",
            )
          }

          row(class = thead, if = @registry_tokens, not_empty) {
            text(class = "th col_svc", content = "NOME")
            text(class = "th col_proj", content = "ESCOPO")
            text(class = "th col_dur", content = "CRIADO")
            text(class = "th col_dur", content = "ÚLTIMO USO")
            text(class = "th col_act", content = "AÇÃO")
          }

          each @registry_tokens as tk (fallback = SemTokens) {
            column(class = table_body) {
              row(class = trow) {
                text(class = "td_key col_svc", content = "@tk.name")
                text(class = "td col_proj", content = "@tk.scope")
                text(class = "muted col_dur", content = "@tk.created")
                text(class = "muted col_dur", content = "@tk.last_used")

                row(class = col_act) {
                  button(
                    class = env_del,
                    on_click = registry_rm_token:@tk.name,
                    text = "✕",
                    tooltip = Revogar,
                  )
                }
              }

              hr
            }
          }
        }

        column(
          class = panel_fill,
          if = @registry_selected_repo,
          not_equals = "",
        ) {
          row(class = env_head) {
            text(
              class = muted_fill,
              content = "@registry_selected_repo — @registry_tags_count tag(s)",
            )

            button(
              class = btn_ghost,
              on_click = registry_close_repo,
              text = "← Voltar",
            )
          }

          row(class = thead) {
            text(class = "th col_svc", content = "TAG")
            text(class = "th col_proj", content = "DIGEST")
            text(class = "th col_dur", content = "TAMANHO")
            text(class = "th col_dur", content = "ATUALIZADA")
            text(class = "th col_act", content = "AÇÃO")
          }

          if @registry_tags_loading == "true" {
            LoadingRow
          }

          scrollable(
            if = @registry_tags_loading,
            not_equals = true,
            direction = vertical,
            class = scroll_fill,
          ) {
            column(class = table_body) {
              column(class = row_wrap, :for-each = registry_tags, var = t) {
                row(class = trow) {
                  text(class = "td_key col_svc", content = "@t.tag")
                  text(class = "muted col_proj", content = "@t.digest")
                  text(class = "muted col_dur", content = "@t.size")
                  text(class = "muted col_dur", content = "@t.updated")

                  row(class = col_act) {
                    button(
                      class = dk_rm,
                      on_click = registry_rm_tag:@t.tag,
                      text = Remover,
                    )
                  }
                }

                hr
              }
            }
          }
        }
      }
    }

    // ── Settings: sub-abas Web Server | Git ────────────────────────────
    if @view == "settings" {
      row(class = header_row) {
        column(class = header_titles) {
          text(class = title, content = "Settings")

          text(
            class = subtitle,
            content = "Daemon web server, HTTPS e contas Git.",
          )
        }
      }

      row(class = tabs) {
        TabButton(
          label = "Web Server",
          current = @settings_tab,
          target = web,
          action = settings_tab:web,
        )

        TabButton(
          label = Git,
          current = @settings_tab,
          target = git,
          action = settings_tab:git,
        )

        TabButton(
          label = "Infra as Code",
          current = @settings_tab,
          target = iac,
          action = settings_tab:iac,
        )

        TabButton(
          label = Manutenção,
          current = @settings_tab,
          target = maintenance,
          action = settings_tab:maintenance,
        )
      }

      hr

      // Web Server (default)
      if @settings_tab == "web" {
        form(name = settings, on_submit = settings_save, width = fill) {
          column(class = form_panel) {
            text(class = label_cap, content = "URL PÚBLICA DA API")

            row(class = kv_row) {
              text(class = kv_val_fill, content = "@ss_public_base")

              button(
                class = copy_btn,
                on_click = clipboard:ss_public_base,
                text = Copiar,
              )
            }

            text(
              class = muted,
              content = """
                Derivada de [api] domain/port no daemon — é a base das URLs de
                webhook dos serviços e do callback OAuth (mesma porta da API).
                Para mudá-la, configure api.domain e reinicie o daemon.
              """,
            )

            text(
              class = label_cap,
              content = "E-MAIL LET'S ENCRYPT (HTTPS AUTOMÁTICO)",
            )

            TextInput(
              placeholder = voce@@exemplo.com,
              class = field_input,
              formControl = ss_email,
            )

            text(
              if = @erro_ss_email,
              not_equals = "",
              class = err,
              content = "@erro_ss_email",
            )

            text(
              class = muted,
              content = """
                Certificados TLS emitidos automaticamente. Requer restart do
                daemon.
              """,
            )

            text(
              class = label_cap,
              content = "DOMÍNIO DO REGISTRY (EXPOSIÇÃO PÚBLICA)",
            )

            TextInput(
              placeholder = registry.meusite.com,
              class = field_input,
              formControl = ss_registry_domain,
            )

            text(
              class = muted,
              content = """
                Expõe o registry Docker embutido via ingress + certificado
                automático. Requer [registry] enabled = true na config. Vazio =
                só acessível em 127.0.0.1.
              """,
            )

            row(class = env_add) {
              button(class = btn_primary, on_click = settings_save, text = Save)
              text(class = muted, content = "@settings_msg")
            }
          }
        }
      }

      // Git: contas conectadas + formulário de conexão
      if @settings_tab == "git" {
        scrollable(direction = vertical, class = scroll_fill) {
          column(class = form_panel) {
            text(
              class = label_cap,
              content = "CONTAS CONECTADAS (@gitea_count)",
            )

            column(class = kv_list) {
              template(
                :for-each = gitea_providers,
                var = p,
                foreach_fallback = SemContasGit,
              ) {
                row(class = kv_row) {
                  column(class = header_titles) {
                    text(class = env_key, content = "@p.name")

                    text(
                      class = muted,
                      content = "@p.kind · @p.base_url · @p.auth_mode · @p.account",
                    )
                  }

                  button(
                    class = btn_danger,
                    on_click = gp_delete:@p.id,
                    text = Remover,
                  )
                }
              }
            }

            hr
            text(class = label_cap, content = "CONECTAR CONTA GIT")

            // Tipo de provedor: Gitea ou GitHub. Troca a redirect URI (path por
            // provedor) e os textos de ajuda abaixo.
            row(class = tabs) {
              TabButton(
                label = Gitea,
                current = @gp_kind,
                target = gitea,
                action = gp_kind:gitea,
              )

              TabButton(
                label = GitHub,
                current = @gp_kind,
                target = github,
                action = gp_kind:github,
              )
            }

            text(
              if = @gp_msg,
              not_equals = "",
              class = muted,
              content = "@gp_msg",
            )

            // OAuth: o Luau não abre o navegador; guarda a URL em gp_oauth_url e
            // o built-in open:<chave> do glacier abre no navegador padrão.
            button(
              if = @gp_oauth_url,
              not_equals = "",
              class = btn_primary,
              on_click = open:gp_oauth_url,
              text = "Abrir autorização no navegador",
            )

            form(
              name = git_provider,
              on_submit = gp_connect,
              spacing = 10,
              width = fill,
            ) {
              row(class = hc_grid) {
                column(class = hc_field) {
                  text(class = label_cap, content = "NOME")

                  TextInput(
                    placeholder = "Meu Gitea",
                    class = field_input,
                    formControl = gp_name,
                    :value = gp_name,
                    on_change = field:gp_name,
                  )

                  text(
                    if = @erro_gp_name,
                    not_equals = "",
                    class = err,
                    content = "@erro_gp_name",
                  )
                }

                column(class = hc_field) {
                  text(class = label_cap, content = "BASE URL")

                  TextInput(
                    placeholder = "https://gitea.exemplo.com",
                    class = field_input,
                    formControl = gp_base_url,
                    :value = gp_base_url,
                    on_change = field:gp_base_url,
                  )

                  text(
                    if = @gp_kind,
                    equals = github,
                    class = muted,
                    content = """
                      Deixe vazio para github.com. Só preencha para GitHub
                      Enterprise Server (ex.: https://ghe.suaempresa.com).
                    """,
                  )
                }
              }

              text(class = label_cap, content = "MÉTODO")

              row(class = tabs) {
                TabButton(
                  label = OAuth2,
                  current = @gp_mode,
                  target = oauth,
                  action = gp_mode:oauth,
                )

                TabButton(
                  label = "Token (PAT)",
                  current = @gp_mode,
                  target = pat,
                  action = gp_mode:pat,
                )
              }

              // OAuth2
              if @gp_mode != "pat" {
                text(class = label_cap, content = "CLIENT ID")

                TextInput(
                  placeholder = "",
                  class = field_input,
                  formControl = gp_client_id,
                  :value = gp_client_id,
                  on_change = field:gp_client_id,
                )

                text(class = label_cap, content = "CLIENT SECRET")

                TextInput(
                  placeholder = "",
                  secure = true,
                  class = field_input,
                  formControl = gp_client_secret,
                  :value = gp_client_secret,
                  on_change = field:gp_client_secret,
                )

                text(
                  class = label_cap,
                  content = "REDIRECT URI (cole no app OAuth do provedor)",
                )

                row(class = kv_row) {
                  text(class = kv_val_fill, content = "@gp_redirect")

                  button(
                    class = copy_btn,
                    on_click = clipboard:gp_redirect,
                    text = Copiar,
                  )
                }

                text(
                  if = @gp_kind,
                  not_equals = github,
                  class = muted,
                  content = """
                    No Gitea: Settings → Applications → crie um OAuth2 app e
                    cole a Redirect URI acima.
                  """,
                )

                text(
                  if = @gp_kind,
                  equals = github,
                  class = muted,
                  content = """
                    No GitHub: Settings → Developer settings → OAuth Apps → New
                    OAuth App e cole a Redirect URI acima em "Authorization
                    callback URL".
                  """,
                )
              }

              // PAT
              if @gp_mode == "pat" {
                text(class = label_cap, content = "PERSONAL ACCESS TOKEN")

                TextInput(
                  placeholder = "",
                  secure = true,
                  class = field_input,
                  formControl = gp_pat,
                  :value = gp_pat,
                  on_change = field:gp_pat,
                )

                text(
                  if = @gp_kind,
                  not_equals = github,
                  class = muted,
                  content = """
                    No Gitea: Settings → Applications → Generate New Token
                    (escopo: repo).
                  """,
                )

                text(
                  if = @gp_kind,
                  equals = github,
                  class = muted,
                  content = """
                    No GitHub: Settings → Developer settings → Personal access
                    tokens → gere um token com escopo "repo".
                  """,
                )
              }

              row(class = env_add) {
                button(
                  class = btn_primary,
                  on_click = gp_connect,
                  text = "Conectar conta",
                )

                button(
                  class = tab,
                  on_click = gp_refresh,
                  text = "Atualizar lista",
                )
              }
            }
          }
        }
      }

      // Infra as Code: o manifesto é um `.zip` com exatamente rustploy.yml
      // (projetos/serviços, env vars sempre como ${VAR}) + rustploy.vars.toml
      // (os valores reais, aninhados por escopo). Exportar/importar usam os
      // diálogos nativos do SO; o import rejeita um zip que tenha qualquer
      // outra coisa. Ver iac_export/iac_import em handlers/settings.luau.
      if @settings_tab == "iac" {
        scrollable(direction = vertical, class = scroll_fill) {
          column(class = form_panel) {
            text(class = label_cap, content = "EXPORTAR")

            text(
              class = muted,
              content = """
                Gera um `.zip` com rustploy.yml + rustploy.vars.toml no lugar
                que você escolher. Os valores das env vars ficam só no TOML;
                secrets nunca saem do daemon.
              """,
            )

            row(class = busy_row) {
              button(
                class = btn_primary,
                on_click = iac_export,
                text = "Exportar para um .zip…",
              )

              spinner(class = busy_spin, if = @iac_busy)
              text(class = muted, content = "@iac_export_msg")
            }

            hr
            text(class = label_cap, content = "IMPORTAR")

            text(
              class = muted,
              content = """
                Escolha o `.zip` do manifesto (o mesmo que o Exportar gera). Ele
                precisa ter exatamente um .yml e um .toml na raiz — nada mais,
                ou o import é recusado. Falta o valor de alguma variável usada
                no YAML? Também é cancelado antes de aplicar qualquer coisa (a
                faltante vem rotulada com o escopo, ex. "Chiquitos/api:
                APP_PORT").
              """,
            )

            row(class = env_add) {
              checkbox(
                :checked = iac_prune,
                on_toggle = field:iac_prune,
                label = "Remover serviços ausentes do manifesto (prune)",
              )
            }

            row(class = env_add) {
              checkbox(
                :checked = iac_deploy,
                on_toggle = field:iac_deploy,
                label = "Disparar deploy dos serviços criados/alterados",
              )
            }

            row(class = busy_row) {
              button(
                class = btn_primary,
                on_click = iac_import,
                text = "Importar de um .zip…",
              )

              spinner(class = busy_spin, if = @iac_busy)
              text(class = muted, content = "@iac_import_msg")
            }

            if @iac_has_missing == "true" {
              text(
                class = err,
                content = "Variáveis sem valor no TOML: @iac_missing_vars",
              )
            }

            if @iac_has_report == "true" {
              text(class = label_cap, content = "RESULTADO")

              column(class = kv_list) {
                row(class = kv_row, :for-each = iac_report_lines, var = l) {
                  text(class = muted, content = "@l")
                }
              }
            }
          }
        }
      }

      // Manutenção: limpeza automática de recursos Docker sem uso (ver
      // docs/plano-limpeza-automatica-docker.md) — mesmas funções dos botões
      // manuais da aba Docker, disparadas por agendamento em vez de clique.
      if @settings_tab == "maintenance" {
        scrollable(direction = vertical, class = scroll_fill) {
          column(class = form_panel) {
            text(class = label_cap, content = "LIMPEZA AUTOMÁTICA")

            toggle(
              :checked = dc_enabled,
              on_toggle = field:dc_enabled,
              label = "  Ativar limpeza automática",
            )

            text(
              class = muted,
              content = """
                Roda sozinha, no horário abaixo, os recursos marcados nesta
                tela. Desligada por padrão — nada é removido até você marcar
                pelo menos um recurso e ativar.
              """,
            )

            text(class = label_cap, content = "FREQUÊNCIA")

            row(class = tabs) {
              TabButton(
                label = "A cada N horas",
                current = @dc_kind,
                target = interval,
                action = dc_kind:interval,
              )

              TabButton(
                label = "Todo dia",
                current = @dc_kind,
                target = daily,
                action = dc_kind:daily,
              )

              TabButton(
                label = "Toda semana",
                current = @dc_kind,
                target = weekly,
                action = dc_kind:weekly,
              )
            }

            row(class = hc_grid, if = @dc_kind, equals = interval) {
              column(class = hc_field) {
                text(class = label_cap, content = "A CADA (HORAS)")

                // Teto de 168 = uma semana. Acima disso o usuário quer a
                // frequência "semanal", que é a aba ao lado.
                spinbox(
                  field_class = spin_field,
                  form_control = dc_hours,
                  :value = dc_hours,
                  min = 1,
                  max = 168,
                  width = 90,
                  placeholder = 6,
                )
              }
            }

            // Eram sete <TabButton> escritos à mão mais o handler
            // `dc_weekday` só pra gravar a escolha. O <radiogroup> (glacier-ui
            // 0.66) grava a chave sozinho, no update dele em Rust, então o
            // handler foi embora junto. As opções vêm de `weekdays`, semeada em
            // handlers/connection.luau a partir de fmt.WEEKDAYS_JSON.
            // Aparência: são radio buttons redondos, não a fileira de pílulas
            // que o TabButton desenhava.
            row(class = tabs, if = @dc_kind, equals = weekly) {
              radiogroup(:value = dc_weekday, :items = weekdays, layout = row)
            }

            // Era um par de campos de texto livre — "HORA (0-23)" e
            // "MINUTO (0-59)" —, e a faixa no próprio rótulo era a confissão de
            // que nada impedia digitar 99: o handler fazia `tonumber(...) or 0`
            // e agendava a limpeza pra meia-noite sem avisar ninguém. O
            // <timeedit> (glacier-ui 0.68) é um campo só, editado por seções
            // (clique na hora, setas ▴▾ mexem nela), onde não dá pra digitar e
            // portanto não dá pra digitar errado. A chave `dc_time` é "HH:MM";
            // fmt.hm_join/hm_split fazem a ponte com o `{hour, minute}` que o
            // daemon espera — o contrato HTTP não mudou.
            row(class = hc_grid, if = @dc_kind, not_equals = interval) {
              column(class = hc_field) {
                text(class = label_cap, content = "HORÁRIO")
                timeedit(:value = dc_time)
              }
            }

            text(
              class = muted,
              content = "Próxima execução agendada: @dc_next_run_label",
            )

            hr
            text(class = label_cap, content = "O QUE LIMPAR")

            checkbox(
              :checked = dc_containers,
              on_toggle = field:dc_containers,
              label = "Containers parados",
            )

            checkbox(
              :checked = dc_images,
              on_toggle = field:dc_images,
              label = "Imagens sem uso",
            )

            checkbox(
              if = @dc_images,
              equals = true,
              :checked = dc_images_all,
              on_toggle = field:dc_images_all,
              label = "   incluir todas as não usadas (não só as sem tag)",
            )

            checkbox(
              :checked = dc_networks,
              on_toggle = field:dc_networks,
              label = "Redes sem uso",
            )

            checkbox(
              :checked = dc_build_cache,
              on_toggle = field:dc_build_cache,
              label = "Cache de build",
            )

            hr
            text(class = "label_cap err", content = "VOLUMES — CUIDADO")

            text(
              class = muted,
              content = """
                Volumes sem uso criados por fora do rustploy (não pelos seus
                serviços, que só usam bind mount) podem conter dado que ninguém
                recriaria sozinho. Confirme que sabe o que existe no host antes
                de ativar.
              """,
            )

            checkbox(
              :checked = dc_volumes,
              on_toggle = field:dc_volumes,
              label = "Volumes sem uso",
            )

            checkbox(
              if = @dc_volumes,
              equals = true,
              :checked = dc_volumes_all,
              on_toggle = field:dc_volumes_all,
              label = "   incluir todos os sem uso (não só os anônimos)",
            )

            row(class = env_add) {
              button(class = btn_primary, on_click = dc_save, text = Salvar)

              button(
                class = tab,
                if = @dc_running,
                not_equals = true,
                on_click = dc_run_now,
                text = "Executar agora",
              )

              button(
                class = tab,
                if = @dc_running,
                equals = true,
                text = "Executando…",
              )

              text(class = muted, content = "@dc_msg")
            }

            hr
            text(class = label_cap, content = "ÚLTIMA EXECUÇÃO")
            text(class = muted, content = "@dc_last_run_text")
          }
        }
      }
    }

    // ── Schedules: jobs one-shot via docker-compose, de todos os projetos ──
    if @view == "schedules" {
      row(class = header_row) {
        column(class = header_titles) {
          text(class = title, content = "Schedules")

          text(
            class = subtitle,
            content = """
              Tarefas one-shot (docker-compose) agendadas ou manuais, de todos
              os projetos.
            """,
          )
        }

        row(class = "stats_row stats_hide_md") {
          StatCard(label = JOBS, value = @jobs_count)
        }

        button(
          class = btn_primary,
          on_click = open_new_job_window,
          text = "+ Novo job",
        )
      }

      column(class = panel_fill) {
        row(class = thead) {
          text(class = "th col_svc", content = "NOME")
          text(class = "th col_proj", content = "PROJETO / GATILHO")
          text(class = "th col_state", content = "ÚLTIMA EXECUÇÃO")
          text(class = "th col_dur", content = "RECORRÊNCIA")
          text(class = "th col_dur", content = "PRÓXIMA EXECUÇÃO")
          text(class = "th col_act_5", content = "AÇÕES")
        }

        scrollable(direction = vertical, class = scroll_fill) {
          column(class = table_body) {
            template(
              :for-each = jobs_summary,
              var = j,
              foreach_fallback = SemJobs,
            ) {
              column(class = row_wrap) {
                row(class = trow) {
                  text(class = "td_key col_svc", content = "@j.name")
                  text(class = "td col_proj", content = "@j.owner")
                  StateCell(kind = @j.last_run_kind, label = @j.last_run_label)
                  text(class = "muted col_dur", content = "@j.recurrence")
                  text(class = "muted col_dur", content = "@j.next_run_at")

                  row(class = col_act_5) {
                    button(
                      class = copy_btn,
                      if = @j.running,
                      not_equals = true,
                      on_click = job_run_now:@j.id,
                      text = "▶",
                      tooltip = "Rodar agora",
                    )

                    button(
                      class = env_del,
                      if = @j.running,
                      equals = true,
                      on_click = job_run_cancel:@j.last_run_id,
                      text = "■",
                      tooltip = Cancelar,
                    )

                    button(
                      class = copy_btn,
                      if = @j.last_run_id,
                      not_equals = "",
                      on_click = open_job_logs_window:@j.last_run_id,
                      text = "≡",
                      tooltip = "Ver logs",
                    )

                    button(
                      class = copy_btn,
                      if = @j.enabled,
                      equals = true,
                      on_click = job_toggle:@j.id,
                      text = "‖",
                      tooltip = Pausar,
                    )

                    button(
                      class = copy_btn,
                      if = @j.enabled,
                      not_equals = true,
                      on_click = job_toggle:@j.id,
                      text = "▶",
                      tooltip = Ativar,
                    )

                    button(
                      class = copy_btn,
                      on_click = open_edit_job_window:@j.id,
                      text = "✎",
                      tooltip = Editar,
                    )

                    button(
                      class = env_del,
                      on_click = job_del:@j.id,
                      text = "✕",
                      tooltip = Remover,
                    )
                  }
                }

                hr
              }
            }
          }
        }
      }
    }

    column(class = content_center, if = @view, equals = support) {
      text(class = title, content = "Support")
      text(class = subtitle, content = "github.com/antoniofernandodj/rustploy")
    }
  }
}
