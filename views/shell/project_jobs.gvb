// Aba Jobs do projeto.
component {
  resources {
    component(name = SemJobsNoProjeto) {
      text(class = u-muted, content = "Nenhum job cadastrado ainda.")
    }
  }

  row(class = env__head) {
    text(class = "u-muted u-fill", content = "@project_jobs_count job(s)")

    button(
      class = "btn btn--primary btn--sm",
      on_click = open_new_job_window,
      disabled = @busy_open_new_job_window,
      text = "+ Novo job",
    )
  }

  scrollable(direction = vertical, class = u-fill-all) {
    column(class = kv-list) {
      each @project_jobs as j (fallback = SemJobsNoProjeto) {
        row(class = kv-list__row) {
          text(class = env__key, content = "@j.name")
          text(class = "u-muted table__col-dur", content = "@j.recurrence")

          StateCell(
            kind = @j.last_run_kind,
            label = @j.last_run_label,
          )

          text(
            class = "u-muted kv-list__val kv-list__val--compact",
            content = "→ @j.next_run_at",
          )

          button(
            class = "btn btn--ghost btn--xs",
            if = @j.running,
            not_equals = true,
            on_click = job_run_now:@j.id,
            disabled = @busy_job_run_now,
            text = "Rodar agora",
          )

          button(
            class = env__del,
            if = @j.running,
            equals = true,
            on_click = job_run_cancel:@j.last_run_id,
            disabled = @busy_job_run_cancel,
            text = Cancelar,
          )

          button(
            class = "btn btn--ghost btn--xs",
            if = @j.last_run_id,
            not_equals = "",
            on_click = open_job_logs_window:@j.last_run_id,
            disabled = @busy_open_job_logs_window,
            text = "Ver logs",
          )

          button(
            class = "btn btn--ghost btn--xs",
            on_click = job_toggle:@j.id,
            disabled = @busy_job_toggle,
            text = @j.enabled_label,
          )

          button(
            class = "btn btn--ghost btn--xs",
            on_click = open_edit_job_window:@j.id,
            disabled = @busy_open_edit_job_window,
            text = Editar,
          )

          button(
            class = env__del,
            on_click = job_delete:@j.id,
            disabled = @busy_job_delete,
            text = "✕",
          )
        }
      }
    }
  }
}
