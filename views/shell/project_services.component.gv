// Projeto aberto (view = project_services): cabeçalho/edição, sub-abas e grade de
// serviços; cada sub-aba pesada mora em seu arquivo.
component {
  resources {
    link(rel = import, href = "project_env.component.gv", as = ProjectEnvTab)
    link(rel = import, href = "project_secrets.component.gv", as = ProjectSecretsTab)
    link(rel = import, href = "project_jobs.component.gv", as = ProjectJobsTab)

    component(name = SemServicosNoProjeto) {
      text("{t('project_services.no_service_in_this_project')}", class = u-muted)
    }
  }

  column(class = content) {
    row(class = page-head) {
      column(class = page-head__titles) {
        row(class = proj-bar) {
          button(
            "{t('project_services.projects')}",
            class = "btn btn--ghost",
            on_click = nav_projects,
            disabled = @busy_nav_projects
          )

          column(class = u-fill)

          flow(class = proj-bar__actions) {
            button(
              "{t('project_services.reorder_services')}",
              class = "btn btn--ghost btn--sm",
              on_click = open_services_reorder_window,
              disabled = @busy_open_services_reorder_window
            )

            button(
              "{t('project_services.deploy')}",
              class = "btn btn--ghost btn--sm",
              on_click = project_deploy,
              disabled = @busy_project_deploy
            )

            button(
              "{t('project_services.new_service')}",
              class = "btn btn--primary btn--sm",
              on_click = open_new_service_window,
              disabled = @busy_open_new_service_window
            )

            if @project_can_delete == "1" {
              button(
                "{t('project_services.remove_project')}",
                class = "btn btn--danger btn--sm",
                on_click = delete_project:@selected_project_id,
                disabled = @busy_delete_project
              )
            }
          }
        }

        // Nome e descrição: inputs sem borda, editados no lugar, sem botão (gravam com
        // debounce em project_title_change / project_description_change) — o mesmo
        // jeito do título do serviço.
        input(
          class = "page-head__title-input",
          :value = edit_project_name,
          on_change = project_title_change,
          placeholder = "{t('common.project_name')}",
        )

        input(
          class = "page-head__subtitle-input",
          :value = edit_project_description,
          on_change = project_description_change,
          placeholder = "{t('project_services.description_optional')}",
        )

        text(
          "@project_action_message",
          if = @project_action_message,
          not_equals = "",
          class = u-muted,
        )
      }
    }

    // Sub-abas do projeto
    scroll(class = tabs__scroll, direction = horizontal) {
      row(class = tabs__main) {
        TabButton(
          label = "{t('project_services.services')}",
          current = @project_tab,
          target = services,
          action = project_tab:services,
        )

        TabButton(
          label = "{t('project_services.variables', project_env_count=project_env_count)}",
          current = @project_tab,
          target = env,
          action = project_tab:env,
        )

        TabButton(
          label = "{t('project_services.secrets', project_secrets_count=project_secrets_count)}",
          current = @project_tab,
          target = secrets,
          action = project_tab:secrets,
        )

        TabButton(
          label = "{t('project_services.jobs', project_jobs_count=project_jobs_count)}",
          current = @project_tab,
          target = jobs,
          action = project_tab:jobs,
        )
      }
    }

    hr

    if @project_loading == "true" {
      LoadingRow
    }

    if @project_tab == "env" {
      // ── Variáveis de ambiente do projeto ──────────────────────
    ProjectEnvTab(if = @project_loading, not_equals = true)
    }

    if @project_tab == "secrets" {
      // ── Secrets do projeto ──────────────────────────────────────
    ProjectSecretsTab(if = @project_loading, not_equals = true)
    }

    if @project_tab == "jobs" {
      ProjectJobsTab
    }

    if @project_tab == "services" {
      scrollable(
        if = @project_loading,
        not_equals = true,
        direction = vertical,
        class = u-fill-all,
      ) {
        column(class = grid) {
          each @project_services as r (fallback = SemServicosNoProjeto) {
            row(class = grid__row) {
              ServiceCard(:for_each = r.cards, var = c, spread = @c)
            }
          }
        }
      }
    }
  }
}
