// Lista de projetos (view = projects); importada por shell.gvb.
component {
  resources {
    component(name = SemProjetos) {
      text(class = u-muted, content = "Nenhum projeto ainda.")
    }
  }

  column(class = content) {
    row(class = page-head) {
      column(class = page-head__titles) {
        text(class = page-head__title, content = "Projects")

        text(
          class = page-head__subtitle,
          content = "Projetos do cluster e a contagem de serviços de cada um.",
        )
      }

      row(class = page-head__stats) {
        StatCard(label = SERVICES, value = @services_count)
        StatCard(label = PROJECTS, value = @projects_count, accent = 1)
      }
    }

    row(class = env__add) {
      button(
        class = "btn btn--primary",
        on_click = open_new_project_window,
        disabled = @busy_open_new_project_window,
        text = "+ Novo projeto",
      )
    }

    if @data_loading == "true" {
      LoadingRow
    }

    scrollable(
      if = @data_loading,
      not_equals = true,
      direction = vertical,
      class = u-fill-all,
    ) {
      column(class = grid) {
        template(
          :for-each = project_rows,
          var = r,
          foreach_fallback = SemProjetos,
        ) {
          row(class = grid__row) {
            template(:for-each = r.cards, var = c) {
              ProjectCard(spread = @c)
            }
          }
        }
      }
    }
  }
}
