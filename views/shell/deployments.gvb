// Lista de deployments (view = deployments); importada por shell.gvb.
component {
  resources {
    component(name = SemDeployments) {
      text(class = muted, content = "Nenhum deployment ainda.")
    }
  }

  column(class = content) {
    row(class = header_row) {
      column(class = header_titles) {
        text(class = title, content = "Deployments")

        text(
          class = subtitle,
          content = "Real-time status of services in the cluster.",
        )
      }

      row(class = "stats_row stats_hide_lg") {
        StatCard(label = STATUS, value = @services_label, accent = 1)
        StatCard(label = UPTIME, value = @daemon_uptime)
      }

      button(
        class = btn_danger,
        on_click = deployments_clear_finished,
        disabled = @busy_deployments_clear_finished,
        text = "Limpar parados/falhos",
      )
    }

    text(
      if = @deployments_msg,
      not_equals = "",
      class = muted,
      content = "@deployments_msg",
    )

    column(class = panel_fill) {
      tableview(
        :items = deployments,
        :sort = deployments_sort,
        var = d,
        header_class = "thead th",
        row_class = "trow td tv_row",
        class = scroll_fill,
      ) {
        tablecolumn(key = service, label = "SERVIÇO", class = col_svc) {
          text(class = td_key, content = "@d.service")
        }

        tablecolumn(key = project, label = PROJETO, class = col_proj)

        tablecolumn(key = state_label, label = ESTADO, class = col_state) {
          StateCell(kind = @d.state_kind, label = @d.state_label)
        }

        // Sem `key`: "2m 3s" não ordena como texto, e o valor cru não vem.
        tablecolumn(label = "DURAÇÃO", class = col_dur) {
          text(class = td, content = "@d.duration")
        }

        tablecolumn(
          key = start,
          sort_key = start_iso,
          label = "INÍCIO",
          class = col_start,
        ) {
          text(class = muted, content = "@d.start")
        }

        if @data_loading == "true" {
          LoadingRow
        } else {
          SemDeployments
        }
      }
    }
  }
}
